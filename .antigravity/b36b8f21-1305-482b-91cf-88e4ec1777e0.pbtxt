        lines {
          text: "        title: \'Verify the Recipient Name\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        desc: \'Crucial verification checkpoint: Check the official name that appears on the screen above the amount.\',"
