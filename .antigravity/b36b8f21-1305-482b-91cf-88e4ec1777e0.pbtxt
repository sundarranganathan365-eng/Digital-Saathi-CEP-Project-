        lines {
          text: "    tabs: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      smartphone: \'1. \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250 \340\244\224\340\244\260 \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',"
