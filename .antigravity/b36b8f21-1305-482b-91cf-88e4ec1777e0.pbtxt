        lines {
          text: "      id: \'otp\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      title: \'OTP (One-Time Password) Fraud\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      icon: <Lock className=\"w-4 h-4\" />,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      definition: \'An OTP is a temporary digital key sent to your phone to authorize a payment or login. Scammers pretend to be helpful agents who need the code to \"verify\" or \"cancel\" a fake charge.\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      warningSigns: ["
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        \'Caller says: \"I sent you a verification code to cancel the wrong charge, please read it to me.\"\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        \'Caller sounds urgent and refuses to let you hang up the phone.\',"
