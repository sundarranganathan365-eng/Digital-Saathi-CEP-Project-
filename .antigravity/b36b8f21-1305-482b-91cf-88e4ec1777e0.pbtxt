        lines {
          text: "      title: \'Masked Aadhaar: Protect Your Identity\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'Whenever an unverified service (like a private hotel, gym, or apartment security gate) demands an Aadhaar photocopy, do NOT provide a full copy. Use Masked Aadhaar instead.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      fullLabel: \'Standard Full Aadhaar (Vulnerable)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      fullDesc: \'Displays all 12 digits: 1234 5678 9012. If stolen or photocopied, scammers can misuse your Aadhaar number for SIM swapping.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      maskedLabel: \'Masked Aadhaar (Recommended & Safe)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      maskedDesc: \'Hides the first 8 digits: XXXX-XXXX-9012. Fully valid for identity verification, but prevents identity theft.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      howTo: \'Download your Masked Aadhaar anytime from the official UIDAI portal: eaadhaar.uidai.gov.in by selecting the \"Masked Aadhaar\" checkbox before downloading.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
