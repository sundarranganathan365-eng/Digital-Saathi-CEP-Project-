        lines {
          text: "    category: \'services\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    question: \'When submitting a photocopy of your Aadhaar card for a sim card or hotel check-in, what is the best safety practice?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionHi: \'\340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\257\340\244\276 \340\244\271\340\245\213\340\244\237\340\244\262 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\225\340\245\200 \340\244\253\340\245\213\340\244\237\340\245\213\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\246\340\245\207\340\244\244\340\245\207 \340\244\270\340\244\256\340\244\257 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\244\340\244\260\340\245\200\340\244\225\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionMr: \'\340\244\271\340\245\211\340\244\237\340\245\207\340\244\262 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241\340\244\232\340\245\200 \340\244\235\340\245\207\340\244\260\340\245\211\340\244\225\340\245\215\340\244\270 \340\244\246\340\245\207\340\244\244\340\244\276\340\244\250\340\244\276 \340\244\225\340\245\213\340\244\243\340\244\244\340\245\200 \340\244\225\340\244\276\340\244\263\340\244\234\340\245\200 \340\244\230\340\245\215\340\244\257\340\244\276\340\244\265\340\245\200?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Leave blank signed copies with the store keeper\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Use a Masked Aadhaar (showing only last 4 digits) and write the purpose & date across the copy\', isCorrect: true },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Post a clear photo of your Aadhaar on your social media profile\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Share your Aadhaar OTP with the receptionist\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Use UIDAI\342\200\231s official \"Masked Aadhaar\" (which masks the first 8 digits) and write a clear handwritten note across the photocopy stating: \"Submitted only for [Purpose] on [Date]\" so it cannot be reused fraudulently.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationHi: \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225\340\245\215\340\244\241 \340\244\206\340\244\247\340\244\276\340\244\260 (Masked Aadhaar) \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\224\340\244\260 \340\244\253\340\245\213\340\244\237\340\245\213\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\252\340\244\260 \340\244\211\340\244\246\340\245\215\340\244\246\340\245\207\340\244\266\340\245\215\340\244\257 \340\244\265 \340\244\244\340\244\276\340\244\260\340\245\200\340\244\226 \340\244\262\340\244\277\340\244\226 \340\244\246\340\245\207\340\244\202\340\245\244\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationMr: \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225\340\245\215\340\244\241 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276 \340\244\206\340\244\243\340\244\277 \340\244\235\340\245\207\340\244\260\340\245\211\340\244\225\340\245\215\340\244\270\340\244\265\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276\340\244\232\340\244\276 \340\244\271\340\245\207\340\244\244\340\245\202 \340\244\206\340\244\243\340\244\277 \340\244\244\340\244\276\340\244\260\340\245\200\340\244\226 \340\244\262\340\244\277\340\244\271\340\245\202\340\244\250 \340\244\270\340\244\271\340\245\200 \340\244\225\340\244\260\340\244\276.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
