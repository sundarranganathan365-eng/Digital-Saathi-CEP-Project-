           : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Smartphone className=\"w-4 h-4\" />\n          <span>{b.tabs.smartphone}</span>\n        </button>\n\n        <button\n          id=\"tab-btn-internet\"\n          onClick={() => setActiveTab(\'internet\')}\n          className={`flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 transition-all whitespace-nowrap ${\n            activeTab === \'internet\'\n              ? \'border-[#171717] text-[#171717]\'\n              : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Globe className=\"w-4 h-4\" />\n          <span>{b.tabs.internet}</span>\n        </button>\n\n        <button\n          id=\"tab-btn-apps\"\n          onClick={() => setActiveTab(\'apps\')}\n          className={`flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 transition-all whitespace-nowrap ${\n            activeTab === \'apps\'\n              ? \'border-[#171717] text-[#171717]\'\n              : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>{b.tabs.apps}</span>\n        </button>\n      </div>\n\n      {/* TAB CONTENT: 1. SMARTPHONE FUNDAMENTALS */}\n      {activeTab === \'smartphone\' && (\n        <div className=\"space-y-12 animate-in fade-in duration-200\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {/* Step 1 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                {b.s1.tag}\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">{b.s1.title}</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                {b.s1.desc}\n              </p>\n              <ul className=\"space-y-2 text-xs text-[#333333]\">\n                {b.s1.steps.map((st, i) => (\n                  <li key={i} className=\"flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5\" />\n                    <span>{st}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Step 2 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                {b.s2.tag}\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">{b.s2.title}</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                {b.s2.desc}\n              </p>\n              <ul className=\"space-y-2 text-xs text-[#333333]\">\n                {b.s2.steps.map((st, i) => (\n                  <li key={i} className=\"flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5\" />\n                    <span>{st}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            {/* Step 3 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                {b.s3.tag}\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">{b.s3.title}</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                {b.s3.desc}\n              </p>\n              <ul className=\"space-y-2 text-xs text-[#333333]\">\n                {b.s3.steps.map((st, i) => (\n                  <li key={i} className=\"flex items-start gap-2\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5\" />\n                    <span>{st}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB CONTENT: 2. INTERNET & SAFE BROWSING */}\n      {activeTab === \'internet\' && (\n        <div className=\"space-y-12 animate-in fade-in duration-200\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div className=\"p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n              <div className=\"flex items-center gap-2\">\n                <Search className=\"w-5 h-5 text-[#171717]\" />\n                <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider\">\n                  {b.i1.tag}\n                </span>\n              </div>\n              <h3 className=\"text-xl font-bold text-[#171717]\">{b.i1.title}</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed\">\n                {b.i1.desc}\n              </p>\n              <ul className=\"space-y-3 pt-2 text-xs sm:text-sm text-[#333333]\">\n                {b.i1.points.map((pt, i) => (\n                  <li key={i} className=\"flex items-start gap-2.5\">\n                    <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                    <span>{pt}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n\n            <div className=\"p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n              <div className=\"flex items-center gap-2\">\n                <Lock className=\"w-5 h-5 text-[#171717]\" />\n                <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider\">\n                  {b.i2.tag}\n                </span>\n              </div>\n              <h3 className=\"text-xl font-bold text-[#171717]\">{b.i2.title}</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed\">\n                {b.i2.desc}\n              </p>\n              <ul className=\"space-y-3 pt-2 text-xs sm:text-sm text-[#333333]\">\n                {b.i2.points.map((pt, i) => (\n                  <li key={i} className=\"flex items-start gap-2.5\">\n                    <XCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n                    <span>{pt}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB CONTENT: 3. APPS & PERMISSIONS */}\n      {activeTab === \'apps\' && (\n        <div className=\"space-y-8 animate-in fade-in duration-200\">\n          <div className=\"p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n            <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block\">\n              {b.a1.tag}\n            </span>\n            <h3 className=\"text-xl font-bold text-[#171717]\">{b.a1.title}</h3>\n            <p className=\"text-sm text-[#525252] leading-relaxed\">\n              {b.a1.desc}\n            </p>\n          </div>\n\n          <div className=\"p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-6\">\n            <div>\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-1\">\n                {b.a2.tag}\n              </span>\n              <h3 className=\"text-xl font-bold text-[#171717]\">{b.a2.title}</h3>\n              <p className=\"text-sm text-[#525252] mt-1\">\n                {b.a2.desc}\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\">\n              {b.a2.items.map((item, idx) => (\n                <div key={idx} className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                  <strong className=\"text-xs font-semibold text-[#171717] block mb-1\">\n                    {item.name}\n                  </strong>\n                  <p className=\"text-xs text-[#525252] leading-relaxed\">\n                    {item.text}\n                  </p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* DOs & DONTs CHECKLIST */}\n      <section className=\"border-t border-[#E5E5E5] pt-12\">\n        <h2 className=\"text-xl sm:text-2xl font-bold text-[#171717] mb-6 font-editorial\">\n          {b.dosTitle}\n        </h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div className=\"p-6 border border-emerald-200 bg-emerald-50/40 rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-emerald-800 font-bold text-sm\">\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-700\" />\n              <span>DO / \340\244\271\340\244\256\340\245\207\340\244\266\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202</span>\n            </div>\n            <ul className=\"space-y-2 text-xs sm:text-sm text-emerald-950\">\n              {b.dos.map((d, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <span className=\"font-bold\">\342\200\242</span>\n                  <span>{d}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"p-6 border border-red-200 bg-red-50/40 rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-red-800 font-bold text-sm\">\n              <XCircle className=\"w-5 h-5 text-red-600\" />\n              <span>DON\'T / \340\244\225\340\244\255\340\245\200 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202</span>\n            </div>\n            <ul className=\"space-y-2 text-xs sm:text-sm text-red-950\">\n              {b.donts.map((d, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <span className=\"font-bold\">\342\200\242</span>\n                  <span>{d}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* NEXT MODULE CTA */}\n      <div className=\"flex justify-end pt-6\">\n        <button\n          onClick={() => {\n            setCurrentPage(\'payments\');\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n          className=\"inline-flex items-center gap-2 px-6 py-3.5 bg-[#171717] text-white text-sm font-semibold rounded hover:bg-[#333333] transition-colors\"\n        >\n          <span>{b.nextCta}</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  Smartphone,\n  Globe,\n  Download,\n  ShieldCheck,\n  Search,\n  Lock,\n  ArrowRight,\n  CheckCircle2,\n  XCircle,\n  HelpCircle,\n  Eye,\n  Wifi,\n  KeyRound,\n  ShieldAlert,\n  AlertTriangle,\n  CreditCard,\n  Layers,\n} from \'lucide-react\';\n\ninterface BasicsPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst basicsContent = {\n  en: {\n    moduleTag: \'Module 01\',\n    categoryTag: \'Foundation Skills\',\n    title: \'Digital Basics: Smartphone & Internet\',\n    subtitle: \'Master the fundamental building blocks of modern smartphones, secure PIN & password hygiene, SIM card ejection defense, and safe app permissions.\',\n    tabs: {\n      smartphone: \'1. Smartphone & Device Security\',\n      simLock: \'2. SIM Card Lock & Eject Protection\',\n      internet: \'3. Internet & Safe Browsing\',\n      apps: \'4. App Management & Permissions\',\n    },\n    s1: {\n      tag: \'Concept 01\',\n      title: \'The Home Screen & Navigation\',\n      desc: \"The home screen is your phone\'s main table. Touching an app icon opens it. Swiping up from the bottom (or pressing the center button) takes you right back home anytime.\",\n      steps: [\n        \'Tap once to open an application (WhatsApp, Phone, Camera).\',\n        \'Swipe down from the top edge to view Wi-Fi, torch, and volume settings.\',\n        \'Swipe up from the bottom edge to return to the home screen immediately.\',\n      ],\n    },\n    s2: {\n      tag: \'Concept 02\',\n      title: \'Wi-Fi vs Mobile Cellular Data\',\n      desc: \'Mobile Data uses your SIM card telecom plan. Wi-Fi connects wirelessly to home or office routers without consuming SIM card daily data limits.\',\n      steps: [\n        \'Home Wi-Fi: Safe and password-protected for high-speed browsing.\',\n        \'Mobile Data (4G/5G): Ideal for secure mobile banking and UPI payments.\',\n        \'Open Public Wi-Fi: Dangerous for banking because passwords can be intercepted.\',\n      ],\n    },\n    s3: {\n      tag: \'Concept 03\',\n      title: \'Screen Lock & PIN Hygiene (Why Weak PINs Fail)\',\n      desc: \'Never leave your phone unlocked. A 6-digit PIN, strong password, or biometric fingerprint prevents unauthorized access if your phone is lost or stolen.\',\n      steps: [\n        \'Set up a PIN or Fingerprint under Settings > Security > Screen Lock.\',\n        \'Avoid predictable PINs like 1234, 0000, or your birth year.\',\n        \'Set screen timeout to 30 seconds to lock automatically when not in use.\',\n      ],\n      badPinHeader: \'DANGEROUS & PREDICTABLE PIN PATTERNS (AVOID AT ALL COSTS):\',\n      badPins: [\n        { code: \'1234 / 4321 / 123456\', reason: \'Sequential numbers are the #1 combination tested by phone thieves.\' },\n        { code: \'0000 / 1111 / 9999\', reason: \'Repeated digits can be guessed in seconds by anyone holding the device.\' },\n        { code: \'1985 / 2002 (Birth Year)\', reason: \'If your wallet is lost with ID cards (Aadhaar/PAN), thieves immediately test your birth year.\' },\n        { code: \'2580 / 0852\', reason: \'Straight vertical/horizontal lines on the keypad are well-known shortcuts.\' },\n        { code: \'Vehicle / House Number\', reason: \'Publicly visible numbers that acquaintances or strangers can easily discover.\' },\n        { code: \'Last 4 Digits of Mobile No.\', reason: \'Your phone number is printed on your SIM and delivery packages.\' },\n      ],\n      whyWeakPinsTitle: \'Why Weak PINs Are So Dangerous:\',\n      whyWeakPinsDesc: \'Your smartphone is the master key to your digital life \342\200\224 containing your bank apps, Google Pay, PhonePe, and WhatsApp. If a thief or malicious bystander guesses your screen lock, they can bypass app security and drain bank accounts before you can report the phone missing.\',\n      strongPinRuleTitle: \'The Golden Rules for a Strong Phone Lock:\',\n      strongPinRules: [\n        \'Use at least 6 random digits that have no connection to your personal life (not your birthday, anniversary, or bike number).\',\n        \'Combine with Biometric Fingerprint or Face Recognition for fast and secure daily unlocking.\',\n        \'Set the screen lock timer to \"Immediately\" or \"After 30 seconds of inactivity\".\',\n        \'Never write down your lock PIN on a sticker pasted behind your phone case.\',\n      ],\n    },\n    sim: {\n      tag: \'Critical Security Layer\',\n      title: \'SIM Card Lock & Eject Protection\',\n      subtitle: \'Why a phone screen lock is NOT enough \342\200\224 protect your SIM against physical ejection theft.\',\n      threatTitle: \'The Hidden Attack: Physical SIM Ejection Theft\',\n      threatDesc: \'Most people believe their screen lock makes their phone 100% safe. However, if a thief steals your smartphone, they can use a safety pin or SIM ejector tool to remove your SIM card in 5 seconds and insert it into their own unlocked phone.\',\n      threatPoints: [\n        \'The thief puts your SIM card into their phone \342\200\224 your telecom network immediately activates.\',\n        \'They install PhonePe, Google Pay, or WhatsApp using your phone number.\',\n        \'When they tap \"Forgot UPI PIN\", the Bank OTP arrives directly on their phone via your stolen SIM!\',\n        \'They drain your bank accounts without ever needing to unlock your original smartphone.\',\n      ],\n      defenseTitle: \'The Ultimate Defense: Enable SIM Card Lock PIN\',\n      defenseDesc: \'When SIM Lock is turned on, the SIM card itself is locked with a secret 4-digit PIN. If anyone ejects the SIM and inserts it into ANY other device (or reboots the phone), the SIM will remain completely dead and inactive until the SIM PIN is entered.\',\n      stepsTitle: \'How to Enable SIM Card Lock:\',\n      stepsAndroid: {\n        platform: \'Android Setup (Samsung, Xiaomi, Vivo, Realme, OnePlus, etc.)\',\n        steps: [\n          \'Open Settings \342\236\224 Security & Privacy (or Passwords & Security).\',\n          \'Scroll down and tap \"More Security Settings\" (or \"System Security\").\',\n          \'Tap \"SIM Card Lock\" (or \"Set up SIM card lock\").\',\n          \'Toggle ON \"Lock SIM Card\". Enter your current telecom default PIN (usually 0000 or 1234).\',\n          \'Tap \"Change SIM PIN\" and set a brand-new secret 4-digit PIN known only to you.\',\n        ],\n      },\n      stepsIos: {\n        platform: \'iPhone Setup (Apple iOS)\',\n        steps: [\n          \'Open Settings \342\236\224 Cellular (or Mobile Data).\',\n          \'Tap \"SIM PIN\".\',\n          \'Turn ON \"SIM PIN\". Enter the default PIN (usually 0000 or 1234).\',\n          \'Tap \"Change PIN\" and enter your new personal 4-digit PIN.\',\n        ],\n      },\n      pukWarning: {\n        title: \'Crucial Telecom Warning: Default PINs & PUK Code\',\n        desc: \'Default telecom SIM PINs are typically 0000 or 1234 for Jio, Airtel, Vi, and BSNL. You MUST change this default immediately to your own secret code. Important: If you enter the wrong SIM PIN 3 times, the SIM is temporarily blocked and asks for an 8-digit PUK (Personal Unblocking Key) code. You can easily view your PUK code inside your telecom app (Airtel Thanks, MyJio, Vi App) or by calling customer care. Keep your PUK code noted safely in a physical notebook at home.\',\n      },\n    },\n    i1: {\n      tag: \'Safe Browsing\',\n      title: \'How to Search the Web Safely\',\n      desc: \'When using Google or web browsers, learn how to distinguish between genuine search results and sponsored advertisements.\',\n      points: [\n        \'Watch out for \"Sponsored\" or \"Ad\" tags on top of search results. Scammers pay for ads to promote fake helpline numbers.\',\n        \'Always check the website domain. Indian government sites end with .gov.in, banks have official registered domains.\',\n        \'Look for the secure padlock icon in the browser address bar before typing passwords.\',\n      ],\n    },\n    i2: {\n      tag: \'Link Hygiene\',\n      title: \'Never Click Unknown Links\',\n      desc: \'Malicious links received via SMS, WhatsApp, or email are designed to hijack accounts or trigger silent file downloads.\',\n      points: [\n        \'Do not click links offering free gifts, lottery wins, or subsidized government laptops.\',\n        \'Do not open file attachments ending with .apk or .exe from unknown senders.\',\n        \'If a friend sends a weird link saying \"Is this you?\", verify with them on a phone call first.\',\n      ],\n    },\n    a1: {\n      tag: \'Official Store\',\n      title: \'Only Install from Google Play Store / Apple App Store\',\n      desc: \'Official app stores screen applications for malware and viruses. Installing APK files from websites or WhatsApp bypasses all security defenses.\',\n    },\n    a2: {\n      tag: \'Permissions Check\',\n      title: \'Understanding Sensitive Permissions\',\n      desc: \'Apps often ask to access your Camera, Microphone, SMS, and Contacts. Only grant permissions that make sense for the app\342\200\231s purpose.\',\n      items: [\n        { name: \'SMS Access:\', text: \'Highly Dangerous. Never give to calculators, games, or flashlight apps. Scammers use SMS access to read bank OTPs silently.\' },\n        { name: \'Contacts Access:\', text: \'Only grant to messaging apps (like WhatsApp) or phone dialers.\' },\n        { name: \'Location Access:\', text: \'Only grant \"While using the app\" to maps and delivery services.\' },\n        { name: \'Camera / Mic:\', text: \'Grant only to video calling or camera apps.\' },\n      ],\n    },\n    dosTitle: \'Summary: Digital Basics Best Practices\',\n    dos: [\n      \'Use a 6-digit random non-sequential PIN for phone screen lock.\',\n      \'Enable SIM Card PIN lock to protect against SIM ejection & OTP theft.\',\n      \'Change default SIM PIN (0000 / 1234) immediately to a secret code.\',\n      \'Always install applications strictly from official app stores (Google Play / App Store).\',\n      \'Keep your operating system updated with latest security patches.\',\n    ],\n    donts: [\n      \'Never use 1234, 0000, 2580, birth years, or vehicle numbers as your screen PIN or SIM PIN.\',\n      \'Never leave your SIM card unlocked \342\200\224 thieves can intercept all bank OTPs on another phone.\',\n      \'Never give SMS or Call Log permissions to utility, flashlight, or gaming apps.\',\n      \'Never connect to password-less public Wi-Fi for mobile banking transactions.\',\n      \'Never write your PINs on paper stored inside your phone cover or wallet.\',\n    ],\n    nextCta: \'Next Module: Digital Payments & UPI Security\',\n  },\n  hi: {\n    moduleTag: \'\340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 01\',\n    categoryTag: \'\340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\225\340\245\214\340\244\266\340\244\262\',\n    title: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202: \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250, \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\217\340\244\265\340\244\202 \340\244\270\340\244\277\340\244\256 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n    subtitle: \'\340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250 \340\244\232\340\244\262\340\244\276\340\244\250\340\245\207, \340\244\256\340\244\234\340\244\254\340\245\202\340\244\244 \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\265 \340\244\252\340\244\277\340\244\250 \340\244\232\340\245\201\340\244\250\340\244\250\340\245\207, \340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\232\340\245\213\340\244\260\340\245\200 \340\244\270\340\245\207 \340\244\254\340\244\232\340\244\276\340\244\265 \340\244\224\340\244\260 \340\244\220\340\244\252 \340\244\252\340\244\260\340\244\256\340\244\277\340\244\266\340\244\250 \340\244\225\340\245\213 \340\244\270\340\244\256\340\244\235\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\270\340\244\260\340\244\262 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\250\340\245\244\',\n    tabs: {\n      smartphone: \'1. \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250 \340\244\224\340\244\260 \340\244\241\340\244\277\340\244\265\340\244\276\340\244\207\340\244\270 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n      simLock: \'2. \340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\262\340\245\211\340\244\225 \340\244\217\340\244\265\340\244\202 \340\244\207\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n      internet: \'3. \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\254\340\245\215\340\244\260\340\244\276\340\244\211\340\244\234\340\244\274\340\244\277\340\244\202\340\244\227\',\n      apps: \'4. \340\244\220\340\244\252 \340\244\252\340\245\215\340\244\260\340\244\254\340\244\202\340\244\247\340\244\250 \340\244\224\340\244\260 \340\244\252\340\244\260\340\244\256\340\244\277\340\244\266\340\244\250\',\n    },\n    s1: {\n      tag: \'\340\244\250\340\244\277\340\244\257\340\244\256 01\',\n      title: \'\340\244\271\340\245\213\340\244\256 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\224\340\244\260 \340\244\250\340\245\207\340\244\265\340\244\277\340\244\227\340\245\207\340\244\266\340\244\250 (Navigation)\',\n      desc: \'\340\244\271\340\245\213\340\244\256 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\253\340\245\213\340\244\250 \340\244\225\340\245\200 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\256\340\245\207\340\244\234 \340\244\225\340\245\200 \340\244\244\340\244\260\340\244\271 \340\244\271\340\245\210\340\245\244 \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\255\340\245\200 \340\244\220\340\244\252 \340\244\225\340\245\207 \340\244\206\340\244\207\340\244\225\340\244\250 \340\244\225\340\245\213 \340\244\233\340\245\202\340\244\250\340\245\207 \340\244\252\340\244\260 \340\244\265\340\244\271 \340\244\226\340\245\201\340\244\262 \340\244\234\340\244\276\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\250\340\245\200\340\244\232\340\245\207 \340\244\270\340\245\207 \340\244\212\340\244\252\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\244\250\340\245\207 (\340\244\257\340\244\276 \340\244\254\340\245\200\340\244\232 \340\244\225\340\244\276 \340\244\254\340\244\237\340\244\250 \340\244\246\340\244\254\340\244\276\340\244\250\340\245\207) \340\244\252\340\244\260 \340\244\206\340\244\252 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\265\340\244\276\340\244\252\340\244\270 \340\244\271\340\245\213\340\244\256 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260 \340\244\206 \340\244\234\340\244\276\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244\',\n      steps: [\n        \'\340\244\225\340\244\277\340\244\270\340\245\200 \340\244\220\340\244\252 (\340\244\265\340\245\215\340\244\271\340\244\276\340\244\237\340\245\215\340\244\270\340\244\217\340\244\252, \340\244\253\340\245\213\340\244\250, \340\244\225\340\245\210\340\244\256\340\244\260\340\244\276) \340\244\225\340\245\213 \340\244\226\340\245\213\340\244\262\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\217\340\244\225 \340\244\254\340\244\276\340\244\260 \340\244\237\340\245\210\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n        \'\340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210, \340\244\237\340\245\211\340\244\260\340\245\215\340\244\232 \340\244\224\340\244\260 \340\244\265\340\245\211\340\244\262\340\245\215\340\244\257\340\245\202\340\244\256 \340\244\246\340\245\207\340\244\226\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\225\340\245\207 \340\244\212\340\244\252\340\244\260 \340\244\270\340\245\207 \340\244\250\340\245\200\340\244\232\340\245\207 \340\244\225\340\245\200 \340\244\223\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n        \'\340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260 \340\244\262\340\245\214\340\244\237\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\245\200\340\244\232\340\245\207 \340\244\270\340\245\207 \340\244\212\340\244\252\340\244\260 \340\244\225\340\245\200 \340\244\223\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n      ],\n    },\n    s2: {\n      tag: \'\340\244\250\340\244\277\340\244\257\340\244\256 02\',\n      title: \'\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\224\340\244\260 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210 \340\244\256\340\245\207\340\244\202 \340\244\205\340\244\202\340\244\244\340\244\260\',\n      desc: \'\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\225\340\245\207 \340\244\260\340\244\277\340\244\232\340\244\276\340\244\260\340\245\215\340\244\234 \340\244\252\340\245\215\340\244\262\340\244\276\340\244\250 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210 \340\244\230\340\244\260 \340\244\257\340\244\276 \340\244\221\340\244\253\340\244\277\340\244\270 \340\244\225\340\245\207 \340\244\254\340\245\215\340\244\260\340\245\211\340\244\241\340\244\254\340\245\210\340\244\202\340\244\241 \340\244\260\340\244\276\340\244\211\340\244\237\340\244\260 \340\244\270\340\245\207 \340\244\254\340\244\277\340\244\250\340\244\276 \340\244\270\340\244\277\340\244\256 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\226\340\244\260\340\245\215\340\244\232 \340\244\2