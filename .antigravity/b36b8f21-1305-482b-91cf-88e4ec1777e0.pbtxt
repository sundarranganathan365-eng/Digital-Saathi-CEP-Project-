    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Language, VideoGuide } from \'../types\';\nimport { videoGuides } from \'../data/videoGuides\';\nimport { ExternalLink, Play, Clock, Sparkles, CheckCircle2 } from \'lucide-react\';\n\ninterface VideoGuideSectionProps {\n  category: \'basics\' | \'payments\' | \'safety\' | \'services\';\n  language: Language;\n  title?: string;\n  subtitle?: string;\n}\n\nconst sectionTranslations = {\n  en: {\n    headerBadge: \'Curated Video Guides\',\n    defaultTitle: \'Official Video Tutorials & Awareness Guides\',\n    defaultSubtitle: \'Watch direct, step-by-step video explainers from verified institutions including RBI, CyberDost (MHA), UIDAI, and Digital India.\',\n    watchBtn: \'Watch on YouTube\',\n    durationLabel: \'Duration\',\n    verifiedSource: \'Verified Source\',\n    directNotice: \'Direct links open official educational channels on YouTube in a new tab.\',\n  },\n  hi: {\n    headerBadge: \'\340\244\252\340\245\215\340\244\260\340\244\256\340\244\276\340\244\243\340\244\277\340\244\244 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\227\340\244\276\340\244\207\340\244\241\',\n    defaultTitle: \'\340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\237\340\245\215\340\244\257\340\245\202\340\244\237\340\245\213\340\244\260\340\244\277\340\244\257\340\244\262 \340\244\217\340\244\265\340\244\202 \340\244\234\340\244\276\340\244\227\340\244\260\340\245\202\340\244\225\340\244\244\340\244\276 \340\244\227\340\244\276\340\244\207\340\244\241\',\n    defaultSubtitle: \'\340\244\255\340\244\276\340\244\260\340\244\244\340\245\200\340\244\257 \340\244\260\340\244\277\340\244\234\340\244\274\340\244\260\340\245\215\340\244\265 \340\244\254\340\245\210\340\244\202\340\244\225 (RBI), \340\244\227\340\245\203\340\244\271 \340\244\256\340\244\202\340\244\244\340\245\215\340\244\260\340\244\276\340\244\262\340\244\257 (CyberDost), UIDAI \340\244\224\340\244\260 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\207\340\244\202\340\244\241\340\244\277\340\244\257\340\244\276 \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276 \340\244\234\340\244\276\340\244\260\340\245\200 \340\244\225\340\244\277\340\244\217 \340\244\227\340\244\217 \340\244\270\340\245\200\340\244\247\340\245\207 \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\340\245\244\',\n    watchBtn: \'\340\244\257\340\245\202\340\244\237\340\245\215\340\244\257\340\245\202\340\244\254 (YouTube) \340\244\252\340\244\260 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\',\n    durationLabel: \'\340\244\270\340\244\256\340\244\257\',\n    verifiedSource: \'\340\244\252\340\245\215\340\244\260\340\244\256\340\244\276\340\244\243\340\244\277\340\244\244 \340\244\270\340\245\215\340\244\260\340\245\213\340\244\244\',\n    directNotice: \'\340\244\270\340\244\255\340\245\200 \340\244\262\340\244\277\340\244\202\340\244\225 \340\244\270\340\245\200\340\244\247\340\245\207 \340\244\257\340\245\202\340\244\237\340\245\215\340\244\257\340\245\202\340\244\254 \340\244\252\340\244\260 \340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\265 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\232\340\245\210\340\244\250\340\244\262\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\250\340\244\217 \340\244\237\340\245\210\340\244\254 \340\244\256\340\245\207\340\244\202 \340\244\226\340\245\201\340\244\262\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244\',\n  },\n  mr: {\n    headerBadge: \'\340\244\252\340\245\215\340\244\260\340\244\256\340\244\276\340\244\243\340\244\277\340\244\244 \340\244\265\340\245\215\340\244\271\340\244\277\340\244\241\340\244\277\340\244\223 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\225\',\n    defaultTitle: \'\340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\244\265\340\245\215\340\244\271\340\244\277\340\244\241\340\244\277\340\244\223 \340\244\237\340\245\215\340\244\257\340\245\202\340\244\237\340\245\213\340\244\260\340\244\277\340\244\257\340\244\262 \340\244\265 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\250\',\n    defaultSubtitle: \'RBI, \340\244\227\340\245\203\340\244\271 \340\244\256\340\244\202\340\244\244\340\245\215\340\244\260\340\244\276\340\244\262\340\244\257 (CyberDost), UIDAI \340\244\206\340\244\243\340\244\277 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\207\340\244\202\340\244\241\340\244\277\340\244\257\340\244\276\340\244\232\340\245\207 \340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\244\265\340\245\215\340\244\271\340\244\277\340\244\241\340\244\277\340\244\223 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\225 \340\244\245\340\245\207\340\244\237 \340\244\252\340\244\271\340\244\276.\',\n    watchBtn: \'\340\244\257\340\245\202\340\244\237\340\245\215\340\244\257\340\245\202\340\244\254\340\244\265\340\244\260 (YouTube) \340\244\252\340\244\271\340\244\276\',\n    durationLabel: \'\340\244\225\340\244\276\340\244\262\340\244\276\340\244\265\340\244\247\340\245\200\',\n    verifiedSource: \'\340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\244\270\340\245\215\340\244\260\340\245\213\340\244\244\',\n    directNotice: \'\340\244\271\340\245\207 \340\244\270\340\244\260\340\245\215\340\244\265 \340\244\246\340\245\201\340\244\265\340\245\207 (Links) \340\244\257\340\245\202\340\244\237\340\245\215\340\244\257\340\245\202\340\244\254\340\244\265\340\244\260\340\245\200\340\244\262 \340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\244\265 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\265\340\245\215\340\244\271\340\244\277\340\244\241\340\244\277\340\244\223 \340\244\250\340\244\265\340\245\200\340\244\250 \340\244\237\340\245\205\340\244\254\340\244\256\340\244\247\340\245\215\340\244\257\340\245\207 \340\244\211\340\244\230\340\244\241\340\244\244\340\244\276\340\244\244.\',\n  },\n};\n\nexport const VideoGuideSection: React.FC<VideoGuideSectionProps> = ({\n  category,\n  language,\n  title,\n  subtitle,\n}) => {\n  const t = sectionTranslations[language];\n  const items = videoGuides.filter((v) => v.category === category);\n\n  if (items.length === 0) return null;\n\n  return (\n    <div className=\"p-6 sm:p-8 border border-[#E5E5E5] bg-[#FAF9F6] rounded-sm space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-[#E5E5E5] pb-5\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-bold tracking-wider uppercase bg-red-100 text-red-900 border border-red-200\">\n              <span className=\"w-2 h-2 rounded-full bg-red-600 animate-pulse\"></span>\n              {t.headerBadge}\n            </span>\n            <span className=\"text-xs text-[#737373] hidden sm:inline-block\">\342\200\242 YouTube Direct Links</span>\n          </div>\n          <h3 className=\"text-xl sm:text-2xl font-bold text-[#171717] font-editorial\">\n            {title || t.defaultTitle}\n          </h3>\n          <p className=\"text-xs sm:text-sm text-[#525252] mt-1 max-w-2xl leading-relaxed\">\n            {subtitle || t.defaultSubtitle}\n          </p>\n        </div>\n      </div>\n\n      {/* Video Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n        {items.map((video) => {\n          const videoTitle =\n            language === \'hi\'\n              ? video.titleHi\n              : language === \'mr\'\n              ? video.titleMr\n              : video.title;\n\n          const videoDesc =\n            language === \'hi\'\n              ? video.descriptionHi\n              : language === \'mr\'\n              ? video.descriptionMr\n              : video.description;\n\n          const channelTag =\n            language === \'hi\'\n              ? video.channelTagHi || video.channelTag\n              : language === \'mr\'\n              ? video.channelTagMr || video.channelTag\n              : video.channelTag;\n\n          const langNote =\n            language === \'hi\'\n              ? video.languageNoteHi\n              : language === \'mr\'\n              ? video.languageNoteMr\n              : video.languageNote;\n\n          return (\n            <div\n              key={video.id}\n              className=\"bg-white border border-[#E5E5E5] rounded p-5 flex flex-col justify-between hover:border-red-300 hover:shadow-sm transition-all group\"\n            >\n              <div className=\"space-y-3\">\n                {/* Channel & Tag info */}\n                <div className=\"flex items-center justify-between gap-2 text-xs\">\n                  <span className=\"font-mono font-semibold text-[11px] text-red-900 bg-red-50 border border-red-100 px-2 py-0.5 rounded flex items-center gap-1\">\n                    <CheckCircle2 className=\"w-3 h-3 text-red-700\" />\n                    {channelTag}\n                  </span>\n                  <div className=\"flex items-center gap-1 text-[#737373] text-[11px] font-mono\">\n                    <Clock className=\"w-3 h-3\" />\n                    <span>{video.duration}</span>\n                  </div>\n                </div>\n\n                {/* Channel Name */}\n                <div className=\"text-xs font-semibold text-[#525252]\">\n                  {video.channel}\n                </div>\n\n                {/* Video Title */}\n                <h4 className=\"text-sm sm:text-base font-bold text-[#171717] group-hover:text-red-900 transition-colors leading-snug\">\n                  {videoTitle}\n                </h4>\n\n                {/* Description */}\n                <p className=\"text-xs text-[#525252] leading-relaxed line-clamp-3\">\n                  {videoDesc}\n                </p>\n              </div>\n\n              {/* Action and Language Footer */}\n              <div className=\"pt-4 mt-4 border-t border-[#F0F0EE] flex items-center justify-between gap-3\">\n                <span className=\"text-[11px] font-mono text-[#737373]\">\n                  {langNote}\n                </span>\n\n                <a\n                  href={video.youtubeUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-red-600 hover:bg-red-700 text-white text-xs font-semibold transition-colors shadow-2xs group-hover:scale-[1.02]\"\n                >\n                  <Play className=\"w-3.5 h-3.5 fill-current\" />\n                  <span>{t.watchBtn}</span>\n                  <ExternalLink className=\"w-3 h-3 opacity-80\" />\n                </a>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Footer notice */}\n      <div className=\"flex items-center gap-2 text-xs text-[#737373] pt-1\">\n        <Sparkles className=\"w-3.5 h-3.5 text-amber-700 shrink-0\" />\n        <span>{t.directNotice}</span>\n      </div>\n    </div>\n  );\n};\n"
    }
