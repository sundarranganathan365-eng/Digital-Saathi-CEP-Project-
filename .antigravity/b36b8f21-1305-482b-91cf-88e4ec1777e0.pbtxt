  file_change {
    absolute_path_uri: "file:///src/components/Footer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { PhoneCall, ShieldAlert, GitFork, BookOpen, ExternalLink, Heart } from \'lucide-react\';\n\ninterface FooterProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ setCurrentPage, language }) => {\n  const t = translations[language];\n\n  return (\n    <footer className=\"bg-[#171717] text-[#A3A3A3] pt-16 pb-12 border-t border-[#262626]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Top Section: Cyber Helpline Alert Banner */}\n        <div className=\"bg-[#262626] border border-[#404040] rounded-sm p-6 mb-14 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n          <div className=\"flex items-start gap-4\">\n            <div className=\"p-2.5 bg-red-950/60 border border-red-800 text-red-400 rounded\">\n              <ShieldAlert className=\"w-6 h-6 shrink-0\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-white font-semibold text-base\">Victim of Online Financial Fraud?</span>\n                <span className=\"bg-red-500/20 text-red-300 text-[11px] font-mono px-2 py-0.5 rounded border border-red-500/30\">ACT WITHIN 2 HOURS</span>\n              </div>\n              <p className=\"text-sm text-[#D4D4D4] mt-1 max-w-2xl\">\n                Immediately call the <strong className=\"text-white\">National Cyber Crime Helpline: 1930</strong> or register an online complaint at <strong className=\"text-white\">cybercrime.gov.in</strong> to help freeze stolen bank funds during the crucial Golden Hour.\n              </p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3 shrink-0 w-full md:w-auto\">\n            <a\n              href=\"tel:1930\"\n              className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-white text-[#171717] font-semibold text-sm rounded hover:bg-[#E5E5E5] transition-colors w-full md:w-auto\"\n            >\n              <PhoneCall className=\"w-4 h-4 text-red-600\" />\n              <span>Call 1930</span>\n            </a>\n            <a\n              href=\"https://cybercrime.gov.in\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-[#333333] hover:bg-[#404040] text-white text-xs font-medium rounded transition-colors border border-[#525252]\"\n            >\n              <span>cybercrime.gov.in</span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </a>\n          </div>\n        </div>\n\n        {/* Main Columns */}\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-[#262626]\">\n          {/* Col 1 & 2: Brand & Academic Manifesto */}\n          <div className=\"md:col-span-2 pr-0 md:pr-6\">\n            <div className=\"flex items-center gap-2.5 mb-3\">\n              <div className=\"w-7 h-7 rounded-sm bg-white text-[#171717] flex items-center justify-center font-bold text-xs\">\n                DS\n              </div>\n              <span className=\"text-white font-bold text-lg tracking-tight\">Digital Saathi</span>\n            </div>\n            <p className=\"text-sm text-[#E5E5E5] font-medium mb-3\">\n              \342\200\234Making Technology Easier for Everyone.\342\200\235\n            </p>\n            <p className=\"text-xs text-[#A3A3A3] leading-relaxed mb-4\">\n              An open-source digital literacy and safety educational platform built as a 3rd-Year BSc Computer Science Community Engagement Project (CEP) on the theme: <em>\342\200\234Building Open-Source Solutions for Social Problems.\342\200\235</em>\n            </p>\n            <div className=\"inline-flex items-center gap-2 text-xs text-[#D4D4D4] bg-[#262626] px-3 py-1.5 rounded border border-[#404040]\">\n              <GitFork className=\"w-3.5 h-3.5 text-[#A3A3A3]\" />\n              <span>Open Source \342\200\242 MIT License</span>\n            </div>\n          </div>\n\n          {/* Col 3: Modules */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              Curriculum\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'basics\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  01. Digital Basics\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  02. UPI & Safe Payments\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  03. Online Safety & Scams\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'services\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  04. Digital Public Services\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Interactive Tools */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              Practice & Verify\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'home\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  Scam Detector Simulator\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'quiz\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  10-Question Knowledge Test\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  DOs & DON\'Ts Checklist\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  Golden Rules of UPI\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 5: Project & Open Source */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              Project Info\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  About the Initiative\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  CEP Problem Statement\n                </button>\n              </li>\n              <li>\n                <a\n                  href=\"https://github.com/digital-saathi/digital-saathi\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1 hover:text-white transition-colors\"\n                >\n                  <span>GitHub Repository</span>\n                  <ExternalLink className=\"w-3 h-3 text-[#737373]\" />\n                </a>\n              </li>\n              <li>\n                <span className=\"text-[#737373]\">BSc CS 2025\342\200\2232026 Batch</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#737373]\">\n          <div>\n            {t.footer.copyright}\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <span className=\"text-[#525252]\">Crafted for Social Digital Inclusion</span>\n            <span>\342\200\242</span>\n            <span className=\"text-[#525252]\">No Commercial Affiliation</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    }
