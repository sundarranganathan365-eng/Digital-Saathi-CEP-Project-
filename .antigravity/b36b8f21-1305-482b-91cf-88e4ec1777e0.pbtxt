 \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225 \340\244\206\340\244\247\340\244\276\340\244\260 (Masked Aadhaar) \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    titleMr: \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225 \340\244\206\340\244\247\340\244\276\340\244\260 (Masked Aadhaar) \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244\340\244\244\340\244\276\',\n    categoryEn: \'Digital Services\',\n    categoryHi: \'\340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n    categoryMr: \'\340\244\266\340\244\276\340\244\270\340\244\225\340\245\200\340\244\257 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\',\n    page: \'services\',\n    sectionId: \'masked-aadhaar\',\n    summaryEn: \'Protecting your identity by sharing copies with first 8 digits hidden.\',\n    summaryHi: \'\340\244\271\340\245\213\340\244\237\340\244\262 \340\244\257\340\244\276 \340\244\250\340\244\277\340\244\234\340\245\200 \340\244\234\340\244\227\340\244\271\340\245\213\340\244\202 \340\244\252\340\244\260 \340\244\252\340\244\271\340\244\262\340\245\207 8 \340\244\205\340\244\202\340\244\225 \340\244\233\340\244\277\340\244\252\340\245\207 \340\244\271\340\245\201\340\244\217 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\244\250\340\244\276\340\245\244\',\n    summaryMr: \'\340\244\252\340\244\271\340\244\277\340\244\262\340\245\207 \340\245\256 \340\244\206\340\244\225\340\244\241\340\245\207 \340\244\262\340\244\252\340\244\262\340\245\207\340\244\262\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\243\340\245\207.\',\n    icon: <FileText className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    titleEn: \'Interactive 10-Question Knowledge Quiz\',\n    titleHi: \'10 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\207\340\244\202\340\244\237\340\244\260\340\245\210\340\244\225\340\245\215\340\244\237\340\244\277\340\244\265 \340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\225\340\245\215\340\244\265\340\244\277\340\244\234\340\244\274\',\n    titleMr: \'\340\245\247\340\245\246 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\244\276\340\244\202\340\244\232\340\245\200 \340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200 (\340\244\225\340\245\215\340\244\265\340\244\277\340\244\235)\',\n    categoryEn: \'Learn & Test\',\n    categoryHi: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\265 \340\244\237\340\245\207\340\244\270\340\245\215\340\244\237\',\n    categoryMr: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200\',\n    page: \'quiz\',\n    summaryEn: \'Test your understanding of digital literacy, UPI precautions, and online scam identification.\',\n    summaryHi: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276, UPI \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\224\340\244\260 \340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250\340\244\250\340\245\207 \340\244\225\340\245\200 \340\244\205\340\244\252\340\244\250\340\245\200 \340\244\270\340\244\256\340\244\235 \340\244\252\340\244\260\340\244\226\340\245\207\340\244\202\340\245\244\',\n    summaryMr: \'UPI \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276, \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\206\340\244\243\340\244\277 \340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225 \340\244\223\340\244\263\340\244\226\340\244\243\340\245\215\340\244\257\340\244\276\340\244\232\340\245\200 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200 \340\244\244\340\244\252\340\244\276\340\244\270\340\244\276.\',\n    icon: <HelpCircle className=\"w-4 h-4 text-[#525252]\" />,\n  },\n];\n\nexport const SearchModal: React.FC<SearchModalProps> = ({ isOpen, onClose, onNavigate, language = \'en\' }) => {\n  const [query, setQuery] = useState(\'\');\n  const inputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    if (isOpen) {\n      setTimeout(() => inputRef.current?.focus(), 50);\n    } else {\n      setQuery(\'\');\n    }\n  }, [isOpen]);\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if ((e.metaKey || e.ctrlKey) && e.key === \'k\') {\n        e.preventDefault();\n        if (isOpen) onClose();\n        else inputRef.current?.focus();\n      }\n      if (e.key === \'Escape\' && isOpen) {\n        onClose();\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  const getEntryTitle = (item: LocalizedSearchEntry) => {\n    if (language === \'hi\') return item.titleHi;\n    if (language === \'mr\') return item.titleMr;\n    return item.titleEn;\n  };\n\n  const getEntryCategory = (item: LocalizedSearchEntry) => {\n    if (language === \'hi\') return item.categoryHi;\n    if (language === \'mr\') return item.categoryMr;\n    return item.categoryEn;\n  };\n\n  const getEntrySummary = (item: LocalizedSearchEntry) => {\n    if (language === \'hi\') return item.summaryHi;\n    if (language === \'mr\') return item.summaryMr;\n    return item.summaryEn;\n  };\n\n  const placeholderText = language === \'hi\'\n    ? \'\340\244\265\340\244\277\340\244\267\340\244\257 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202 (\340\244\211\340\244\246\340\244\276. UPI, OTP, \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260, \340\244\206\340\244\247\340\244\276\340\244\260, \340\244\270\340\245\215\340\244\225\340\245\210\340\244\256...)\'\n    : language === \'mr\'\n    ? \'\340\244\265\340\244\277\340\244\267\340\244\257 \340\244\266\340\245\213\340\244\247\340\244\276 (\340\244\211\340\244\246\340\244\276. UPI, OTP, \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260, \340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225...)\'\n    : \'Search topics (e.g. UPI, OTP, DigiLocker, KYC, Scams...)\';\n\n  const clearText = language === \'hi\' ? \'\340\244\270\340\244\276\340\244\253\340\244\274 \340\244\225\340\244\260\340\245\207\340\244\202\' : language === \'mr\' ? \'\340\244\271\340\244\237\340\244\265\340\244\276\' : \'Clear\';\n\n  const filtered = query.trim() === \'\'\n    ? SEARCH_DATABASE.slice(0, 6)\n    : SEARCH_DATABASE.filter(item => {\n        const q = query.toLowerCase();\n        return (\n          item.titleEn.toLowerCase().includes(q) ||\n          item.titleHi.toLowerCase().includes(q) ||\n          item.titleMr.toLowerCase().includes(q) ||\n          item.summaryEn.toLowerCase().includes(q) ||\n          item.summaryHi.toLowerCase().includes(q) ||\n          item.summaryMr.toLowerCase().includes(q) ||\n          item.categoryEn.toLowerCase().includes(q) ||\n          item.categoryHi.toLowerCase().includes(q) ||\n          item.categoryMr.toLowerCase().includes(q)\n        );\n      });\n\n  const handleSelect = (item: LocalizedSearchEntry) => {\n    onNavigate(item.page, item.sectionId);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-start justify-center pt-20 px-4 bg-black/40 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"bg-white border border-[#D4D4D4] rounded shadow-xl w-full max-w-2xl overflow-hidden animate-in zoom-in-95 duration-150\">\n        {/* Search input header */}\n        <div className=\"flex items-center px-4 py-3.5 border-b border-[#E5E5E5] gap-3\">\n          <Search className=\"w-5 h-5 text-[#737373] shrink-0\" />\n          <input\n            ref={inputRef}\n            type=\"text\"\n            value={query}\n            onChange={(e) => setQuery(e.target.value)}\n            placeholder={placeholderText}\n            className=\"w-full bg-transparent border-none text-sm sm:text-base text-[#171717] placeholder:text-[#A3A3A3] focus:outline-none\"\n          />\n          {query && (\n            <button\n              onClick={() => setQuery(\'\')}\n              className=\"text-xs text-[#737373] hover:text-[#171717] px-1.5 py-0.5\"\n            >\n              {clearText}\n            </button>\n          )}\n          <button\n            onClick={onClose}\n            className=\"p-1 text-[#737373] hover:text-[#171717] rounded hover:bg-[#F5F5F4]\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Results List */}\n        <div className=\"max-h-[60vh] overflow-y-auto p-2 divide-y divide-[#F5F5F4]\">\n          {filtered.length > 0 ? (\n            filtered.map((item, idx) => (\n              <button\n                key={idx}\n                onClick={() => handleSelect(item)}\n                className=\"w-full text-left p-3 rounded hover:bg-[#FAF9F6] transition-colors flex items-start justify-between gap-3 group\"\n              >\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"p-2 bg-[#F5F5F4] border border-[#E5E5E5] rounded group-hover:bg-white transition-colors\">\n                    {item.icon}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-semibold text-[#737373] uppercase tracking-wider\">\n                        {getEntryCategory(item)}\n                      </span>\n                    </div>\n                    <h5 className=\"text-sm font-semibold text-[#171717] group-hover:text-blue-900 transition-colors\">\n                      {getEntryTitle(item)}\n                    </h5>\n                    <p className=\"text-xs text-[#525252] mt-0.5 line-clamp-1\">\n                      {getEntrySummary(item)}\n                    </p>\n                  </div>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-[#A3A3A3] group-hover:text-[#171717] group-hover:translate-x-0.5 transition-all shrink-0 mt-2\" />\n              </button>\n            ))\n          ) : (\n            <div className=\"py-12 text-center text-xs text-[#737373]\">\n              {language === \'hi\'\n                ? `\"${query}\" \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\245\213\340\244\210 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 UPI, OTP \340\244\257\340\244\276 \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\226\340\245\213\340\244\234 \340\244\225\340\244\260 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\340\245\244`\n                : language === \'mr\'\n                ? `\"${query}\" \340\244\270\340\244\276\340\244\240\340\245\200 \340\244\225\340\245\213\340\244\243\340\244\244\340\245\200\340\244\271\340\245\200 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200 \340\244\206\340\244\242\340\244\263\340\244\262\340\245\200 \340\244\250\340\244\276\340\244\271\340\245\200. UPI, OTP \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\266\340\245\213\340\244\247\340\244\276.`\n                : `No matching guides found for \"${query}\". Try searching for UPI, OTP, or DigiLocker.`}\n            </div>\n          )}\n        </div>\n\n        {/* Search Footer */}\n        <div className=\"px-4 py-2.5 bg-[#FAF9F6] border-t border-[#E5E5E5] flex items-center justify-between text-[11px] text-[#737373]\">\n          <span>\n            {language === \'hi\'\n              ? \'\340\244\237\340\244\277\340\244\252: \340\244\250\340\245\207\340\244\265\340\244\277\340\244\227\340\245\207\340\244\237 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \342\206\221 \342\206\223 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202 \342\200\242 \340\244\254\340\244\202\340\244\246 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 ESC \340\244\246\340\244\254\340\244\276\340\244\217\340\244\202\'\n              : language === \'mr\'\n              ? \'\340\244\237\340\245\200\340\244\252: \340\244\250\340\244\277\340\244\265\340\244\241\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \342\206\221 \342\206\223 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276 \342\200\242 \340\244\254\340\244\202\340\244\246 \340\244\225\340\244\260\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 ESC \340\244\246\340\244\276\340\244\254\340\244\276\'\n              : \'Tip: Use \342\206\221 \342\206\223 to navigate \342\200\242 ESC to close\'}\n          </span>\n          <span>Digital Saathi Public Knowledge Base</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
