    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  CreditCard,\n  QrCode,\n  ShieldCheck,\n  ShieldAlert,\n  Lock,\n  ArrowRight,\n  CheckCircle2,\n  AlertOctagon,\n  XCircle,\n  HelpCircle,\n  Smartphone,\n  Eye,\n} from \'lucide-react\';\n\ninterface PaymentsPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const PaymentsPage: React.FC<PaymentsPageProps> = ({ setCurrentPage, language }) => {\n  const [activeStep, setActiveStep] = useState<number>(1);\n\n  const steps = [\n    {\n      num: 1,\n      title: \'Open Your UPI App\',\n      desc: \'Unlock your phone and open your authorized UPI application (such as BHIM, Google Pay, PhonePe, or Paytm).\',\n      tip: \'Ensure the app is protected with biometric fingerprint or device passcode lock.\',\n    },\n    {\n      num: 2,\n      title: \'Select Payment Option\',\n      desc: \'Tap \"Scan QR code\" or \"Pay to Mobile Number / UPI ID\".\',\n      tip: \'Only use the camera scanner directly inside your verified payment app.\',\n    },\n    {\n      num: 3,\n      title: \'Scan QR or Enter Recipient\',\n      desc: \'Point your camera steadily at the merchant QR code stand, or carefully type the recipient\342\200\231s 10-digit mobile number.\',\n      tip: \'Look closely at the merchant stand to ensure no fraudulent sticker is pasted over the original QR code.\',\n    },\n    {\n      num: 4,\n      title: \'Enter the Exact Amount\',\n      desc: \'Type the exact amount in Rupees (\342\202\271) you intend to pay.\',\n      tip: \'Always double-check the zeros and decimal points (e.g. \342\202\27150 vs \342\202\271500).\',\n    },\n    {\n      num: 5,\n      title: \'Verify the Recipient Name\',\n      desc: \'Crucial verification checkpoint: Check the official name that appears on the screen above the amount.\',\n      tip: \'Never proceed if the displayed name does not match the shop or person you are paying.\',\n    },\n    {\n      num: 6,\n      title: \'Enter Your Secret UPI PIN\',\n      desc: \'Type your 4-digit or 6-digit UPI PIN on the secure black keyboard.\',\n      tip: \'Shield your phone screen so bystanders or store clerks cannot observe your PIN digits.\',\n    },\n    {\n      num: 7,\n      title: \'Transaction Confirmation\',\n      desc: \'A green checkmark will appear with the transaction reference number and bank confirmation SMS.\',\n      tip: \'Wait for the sound confirmation box or show the green tick screen to the merchant.\',\n    },\n  ];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Module 02\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">Financial Safety</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          Digital Payments & UPI Security\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          Learn how Unified Payments Interface (UPI) functions, master the 7-step transaction flow, and internalize the golden rules that protect your bank account from fraud.\n        </p>\n      </div>\n\n      {/* 1. What is UPI? Concept Explanation */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        <div className=\"lg:col-span-6 p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n          <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block\">\n            Plain Language Explanation\n          </span>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            What is UPI (Unified Payments Interface)?\n          </h2>\n          <p className=\"text-sm text-[#525252] leading-relaxed\">\n            Think of UPI as a digital courier system built by the National Payments Corporation of India (NPCI). Instead of sharing your 16-digit bank account number and IFSC code, UPI lets you transfer money directly between bank accounts instantly using just a <strong>phone number</strong>, <strong>QR code</strong>, or simple <strong>UPI ID</strong> (like <code className=\"text-[#171717] font-semibold\">name@upi</code>).\n          </p>\n          <div className=\"pt-2 border-t border-[#F0F0EE] space-y-2 text-xs text-[#404040]\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#171717]\" />\n              <span>Direct bank-to-bank transfer without holding money in an intermediary wallet.</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#171717]\" />\n              <span>Operates 24 hours a day, 7 days a week, 365 days a year including holidays.</span>\n            </div>\n          </div>\n        </div>\n\n        {/* The Non-Negotiable Golden Rules Box */}\n        <div className=\"lg:col-span-6 p-8 border-2 border-[#171717] bg-[#171717] text-white rounded-sm space-y-5 shadow-xs\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs font-mono font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5\">\n              <AlertOctagon className=\"w-4 h-4\" />\n              <span>The 4 Golden Rules of UPI</span>\n            </span>\n            <span className=\"text-[11px] text-[#A3A3A3] uppercase font-mono\">NON-NEGOTIABLE</span>\n          </div>\n\n          <div className=\"space-y-4 text-sm\">\n            <div className=\"p-3 bg-[#262626] border border-[#404040] rounded flex items-start gap-3\">\n              <span className=\"text-amber-400 font-bold font-mono text-base mt-0.5\">01</span>\n              <div>\n                <strong className=\"text-white block font-bold text-sm\">Receiving money NEVER requires your UPI PIN</strong>\n                <span className=\"text-xs text-[#D4D4D4] mt-0.5 block\">\n                  You only enter a PIN when money leaves your account. If anyone asks you to type a PIN to receive money or lottery winnings, it is 100% a fraud.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-[#262626] border border-[#404040] rounded flex items-start gap-3\">\n              <span className=\"text-amber-400 font-bold font-mono text-base mt-0.5\">02</span>\n              <div>\n                <strong className=\"text-white block font-bold text-sm\">Never share your UPI PIN or OTP with anyone</strong>\n                <span className=\"text-xs text-[#D4D4D4] mt-0.5 block\">\n                  Not with friends, store clerks, or callers claiming to be bank officers.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-[#262626] border border-[#404040] rounded flex items-start gap-3\">\n              <span className=\"text-amber-400 font-bold font-mono text-base mt-0.5\">03</span>\n              <div>\n                <strong className=\"text-white block font-bold text-sm\">Always verify the beneficiary name before entering PIN</strong>\n                <span className=\"text-xs text-[#D4D4D4] mt-0.5 block\">\n                  Check the screen to confirm the exact person or merchant name.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-[#262626] border border-[#404040] rounded flex items-start gap-3\">\n              <span className=\"text-amber-400 font-bold font-mono text-base mt-0.5\">04</span>\n              <div>\n                <strong className=\"text-white block font-bold text-sm\">Decline unknown \"Collect Money\" payment requests</strong>\n                <span className=\"text-xs text-[#D4D4D4] mt-0.5 block\">\n                  Never approve popup authorization requests for amounts you didn\'t initiate.\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. Visual 7-Step Payment Flow */}\n      <section className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-10 space-y-8\">\n        <div>\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Visual Walkthrough\n          </span>\n          <h3 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            How to Make a UPI Payment (7-Step Process)\n          </h3>\n          <p className=\"text-xs sm:text-sm text-[#525252] mt-1\">\n            Click through each stage to review the procedure and essential safety checks.\n          </p>\n        </div>\n\n        {/* Step Navigation Dots / Indicators */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-7 gap-2\">\n          {steps.map((s) => (\n            <button\n              key={s.num}\n              onClick={() => setActiveStep(s.num)}\n              className={`p-3 text-left border rounded transition-all ${\n                activeStep === s.num\n                  ? \'border-[#171717] bg-[#FAF9F6] shadow-xs\'\n                  : \'border-[#E5E5E5] bg-white hover:bg-[#F5F5F4]\'\n              }`}\n            >\n              <span className=\"text-xs font-mono font-bold text-[#737373] block\">Step 0{s.num}</span>\n              <span className=\"text-xs font-semibold text-[#171717] line-clamp-1 mt-1\">{s.title}</span>\n            </button>\n          ))}\n        </div>\n\n        {/* Active Step Showcase Card */}\n        {(() => {\n          const current = steps.find((s) => s.num === activeStep)!;\n          return (\n            <div className=\"p-6 sm:p-8 border border-[#E5E5E5] rounded bg-[#FAF9F6] flex flex-col md:flex-row items-start justify-between gap-6\">\n              <div className=\"space-y-3 max-w-xl\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-mono font-bold bg-[#171717] text-white px-2.5 py-1 rounded\">\n                    Step 0{current.num} of 07\n                  </span>\n                  <h4 className=\"text-xl font-bold text-[#171717]\">{current.title}</h4>\n                </div>\n                <p className=\"text-sm text-[#404040] leading-relaxed\">{current.desc}</p>\n                <div className=\"p-3.5 bg-white border border-[#E5E5E5] rounded text-xs text-[#171717] flex items-start gap-2\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong className=\"text-[#171717]\">Safety Verification:</strong>{\' \'}\n                    <span className=\"text-[#525252]\">{current.tip}</span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-3 shrink-0 self-end md:self-center\">\n                <button\n                  onClick={() => setActiveStep((prev) => Math.max(1, prev - 1))}\n                  disabled={activeStep === 1}\n                  className=\"px-3.5 py-2 text-xs font-semibold border border-[#D4D4D4] rounded bg-white disabled:opacity-40 hover:bg-[#F5F5F4]\"\n                >\n                  Previous\n                </button>\n                <button\n                  onClick={() => setActiveStep((prev) => Math.min(7, prev + 1))}\n                  disabled={activeStep === 7}\n                  className=\"px-4 py-2 text-xs font-semibold bg-[#171717] text-white rounded disabled:opacity-40 hover:bg-[#333333]\"\n                >\n                  Next Step \342\206\222\n                </button>\n              </div>\n            </div>\n          );\n        })()}\n      </section>\n\n      {/* 3. Common UPI Scams & How They Operate */}\n      <section className=\"space-y-6\">\n        <div>\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Threat Awareness\n          </span>\n          <h3 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            Common UPI Fraud Tactics in India\n          </h3>\n          <p className=\"text-xs sm:text-sm text-[#525252]\">\n            Scammers rely on trickery and social manipulation rather than breaking encryption.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {/* Fraud 1 */}\n          <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm space-y-3\">\n            <div className=\"p-2 w-fit bg-red-50 border border-red-200 text-red-700 rounded\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n            <h4 className=\"text-base font-bold text-[#171717]\">The \"Receive Money\" QR Scam</h4>\n            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n              A buyer on an online marketplace (like OLX) sends you a QR code and says: <em>\"Scan this QR code and type your PIN to receive the advance payment.\"</em>\n            </p>\n            <div className=\"p-2.5 bg-red-50 border border-red-200 rounded text-xs text-red-900 font-semibold\">\n              Truth: Scanning a QR code and entering a PIN always deducts money from your account.\n            </div>\n          </div>\n\n          {/* Fraud 2 */}\n          <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm space-y-3\">\n            <div className=\"p-2 w-fit bg-red-50 border border-red-200 text-red-700 rounded\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n            <h4 className=\"text-base font-bold text-[#171717]\">Fake Wrong-Transfer Call</h4>\n            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n              A stranger calls claiming they accidentally sent \342\202\27110,000 to your Google Pay by mistake, showing a fake screenshot and demanding you return the funds.\n            </p>\n            <div className=\"p-2.5 bg-red-50 border border-red-200 rounded text-xs text-red-900 font-semibold\">\n              Action: Check your real bank balance via your official banking app before taking any action.\n            </div>\n          </div>\n\n          {/* Fraud 3 */}\n          <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm space-y-3\">\n            <div className=\"p-2 w-fit bg-red-50 border border-red-200 text-red-700 rounded\">\n              <ShieldAlert className=\"w-5 h-5\" />\n            </div>\n            <h4 className=\"text-base font-bold text-[#171717]\">Remote Screen-Sharing Trap</h4>\n            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n              Fraudsters pose as bank executives and instruct you to download remote apps like AnyDesk, TeamViewer QuickSupport, or RustDesk to \"fix a payment glitch\".\n            </p>\n            <div className=\"p-2.5 bg-red-50 border border-red-200 rounded text-xs text-red-900 font-semibold\">\n              Truth: These apps let scammers see your screen and record your PIN as you type it.\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Next Module Navigation Link */}\n      <div className=\"pt-8 border-t border-[#E5E5E5] flex items-center justify-between\">\n        <button\n          onClick={() => { setCurrentPage(\'basics\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"text-xs font-semibold text-[#737373] hover:text-[#171717] transition-colors\"\n        >\n          \342\206\220 Previous: Module 01 (Digital Basics)\n        </button>\n\n        <button\n          id=\"btn-next-module-safety\"\n          onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors shadow-xs\"\n        >\n          <span>Continue to Module 03: Online Safety & Scams</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
