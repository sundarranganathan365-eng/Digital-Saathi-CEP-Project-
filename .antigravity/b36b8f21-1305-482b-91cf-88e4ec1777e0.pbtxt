    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Language } from \'../types\';\n\nexport interface TranslationDict {\n  siteTitle: string;\n  tagline: string;\n  secondaryMessage: string;\n  nav: {\n    home: string;\n    basics: string;\n    payments: string;\n    safety: string;\n    services: string;\n    quiz: string;\n    about: string;\n    startLearning: string;\n  };\n  hero: {\n    heading: string;\n    subheading: string;\n    description: string;\n    btnStart: string;\n    btnSafety: string;\n    badge: string;\n  };\n  whyMatters: {\n    heading: string;\n    subheading: string;\n    description: string;\n  };\n  spotScam: {\n    title: string;\n    subtitle: string;\n    question: string;\n    btnSafe: string;\n    btnScam: string;\n    simulatedTag: string;\n  };\n  textResize: {\n    title: string;\n    smaller: string;\n    normal: string;\n    larger: string;\n  };\n  footer: {\n    tagline: string;\n    aboutCep: string;\n    helplineText: string;\n    helplineNum: string;\n    copyright: string;\n  };\n}\n\nexport const translations: Record<Language, TranslationDict> = {\n  en: {\n    siteTitle: \'Digital Saathi\',\n    tagline: \'Making Technology Easier for Everyone.\',\n    secondaryMessage: \'Learn. Understand. Stay Safe.\',\n    nav: {\n      home: \'Home\',\n      basics: \'Digital Basics\',\n      payments: \'Digital Payments\',\n      safety: \'Online Safety\',\n      services: \'Digital Services\',\n      quiz: \'Learn & Test\',\n      about: \'About Project\',\n      startLearning: \'Start Learning\',\n    },\n    hero: {\n      heading: \'Digital Saathi\',\n      subheading: \'Making Technology Easier for Everyone.\',\n      description: \'Learn how to use everyday digital services, make safer online payments, identify scams, and confidently navigate the digital world.\',\n      btnStart: \'Start Learning\',\n      btnSafety: \'Stay Safe Online\',\n      badge: \'Open-Source Social Initiative \342\200\242 BSc CS Project\',\n    },\n    whyMatters: {\n      heading: \'Why Digital Literacy Matters\',\n      subheading: \'Technology is becoming part of everyday life, but not everyone has the knowledge or confidence to use it safely. Digital Saathi provides simple, practical guidance for common digital tasks.\',\n      description: \'Simple guides built for elderly citizens, parents, and first-time smartphone users.\',\n    },\n    spotScam: {\n      title: \'Can You Spot the Scam?\',\n      subtitle: \'Test your scam-detection skills with simulated real-world messages. No real data is collected.\',\n      question: \'Is this Safe or a Scam?\',\n      btnSafe: \'Safe Message\',\n      btnScam: \'Suspicious / Scam\',\n      simulatedTag: \'Simulated Educational Example\',\n    },\n    textResize: {\n      title: \'Text Size\',\n      smaller: \'Standard\',\n      normal: \'Large\',\n      larger: \'Extra Large\',\n    },\n    footer: {\n      tagline: \'Making Technology Easier for Everyone.\',\n      aboutCep: \'A 3rd-Year BSc Computer Science Community Engagement Project (CEP) dedicated to social digital inclusion and cyber safety awareness.\',\n      helplineText: \'National Cyber Crime Helpline (India):\',\n      helplineNum: \'1930\',\n      copyright: \'\302\251 2026 Digital Saathi \342\200\242 Open-Source Educational Initiative (MIT License)\',\n    },\n  },\n  hi: {\n    siteTitle: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\245\340\245\200\',\n    tagline: \'\340\244\244\340\244\225\340\244\250\340\245\200\340\244\225 \340\244\225\340\245\213 \340\244\270\340\244\255\340\245\200 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\206\340\244\270\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\254\340\244\250\340\244\276\340\244\250\340\244\276\340\245\244\',\n    secondaryMessage: \'\340\244\270\340\245\200\340\244\226\340\245\207\340\244\202\340\245\244 \340\244\270\340\244\256\340\244\235\340\245\207\340\244\202\340\245\244 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\260\340\244\271\340\245\207\340\244\202\340\245\244\',\n    nav: {\n      home: \'\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240\',\n      basics: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202\',\n      payments: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 (UPI)\',\n      safety: \'\340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n      services: \'\340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n      quiz: \'\340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\224\340\244\260 \340\244\237\340\245\207\340\244\270\340\245\215\340\244\237\',\n      about: \'\340\244\252\340\245\215\340\244\260\340\245\213\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\260\340\245\207 \340\244\256\340\245\207\340\244\202\',\n      startLearning: \'\340\244\270\340\245\200\340\244\226\340\244\250\340\244\276 \340\244\266\340\245\201\340\244\260\340\245\202 \340\244\225\340\244\260\340\245\207\340\244\202\',\n    },\n    hero: {\n      heading: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\245\340\245\200\',\n      subheading: \'\340\244\244\340\244\225\340\244\250\340\245\200\340\244\225 \340\244\225\340\245\213 \340\244\270\340\244\255\340\245\200 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\206\340\244\270\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\254\340\244\250\340\244\276\340\244\250\340\244\276\340\245\244\',\n      description: \'\340\244\260\340\245\213\340\244\234\340\244\256\340\244\260\340\245\215\340\244\260\340\244\276 \340\244\225\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\223\340\244\202 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\270\340\245\200\340\244\226\340\245\207\340\244\202, \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 UPI \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\247\340\245\213\340\244\226\340\244\276\340\244\247\340\244\241\340\244\274\340\245\200 \340\244\265 \340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250\340\245\207\340\244\202 \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\265\340\244\276\340\244\270 \340\244\225\340\245\207 \340\244\270\340\244\276\340\244\245 \340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237\340\244\253\340\245\213\340\244\250 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n      btnStart: \'\340\244\270\340\245\200\340\244\226\340\244\250\340\244\276 \340\244\266\340\245\20