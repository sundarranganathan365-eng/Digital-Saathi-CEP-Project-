  file_change {
    absolute_path_uri: "file:///src/pages/HomePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { ScamSpotter } from \'../components/ScamSpotter\';\nimport {\n  ArrowRight,\n  Shield,\n  Smartphone,\n  CreditCard,\n  Building2,\n  Lock,\n  Eye,\n  HelpCircle,\n} from \'lucide-react\';\n\ninterface HomePageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const HomePage: React.FC<HomePageProps> = ({ setCurrentPage, language }) => {\n  const t = translations[language];\n\n  const handleNavigate = (page: PageId) => {\n    setCurrentPage(page);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <div className=\"space-y-20 sm:space-y-28 py-10 sm:py-16\">\n      {/* 1. HERO SECTION \342\200\224 Editorial Layout */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n          {/* Left Column: Headline & Description */}\n          <div className=\"lg:col-span-7 space-y-6\">\n            <div className=\"inline-flex items-center gap-2 px-2.5 py-1 text-xs font-semibold tracking-wider uppercase text-[#171717] bg-[#EFEFED] border border-[#E0E0DE] rounded-xs\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#171717]\" />\n              <span>{t.hero.badge}</span>\n            </div>\n\n            <h1 className=\"text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#171717] leading-[1.12] font-editorial\">\n              {t.hero.headingPart1} <br className=\"hidden sm:inline\" />\n              <span className=\"font-serif-accent font-normal italic text-[#333333]\">{t.hero.headingAccent}</span> {t.hero.headingPart2}\n            </h1>\n\n            <p className=\"text-base sm:text-lg text-[#525252] max-w-xl leading-relaxed font-normal\">\n              {t.hero.description}\n            </p>\n\n            {/* CTAs */}\n            <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n              <button\n                id=\"hero-btn-start-learning\"\n                onClick={() => handleNavigate(\'basics\')}\n                className=\"inline-flex items-center gap-2 px-6 py-3.5 bg-[#171717] text-white text-sm font-semibold rounded hover:bg-[#333333] active:bg-black transition-all shadow-xs group\"\n              >\n                <span>{t.hero.btnStart}</span>\n                <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n              </button>\n\n              <button\n                id=\"hero-btn-online-safety\"\n                onClick={() => handleNavigate(\'safety\')}\n                className=\"inline-flex items-center gap-2 px-5 py-3.5 bg-white text-[#171717] hover:bg-[#F5F5F4] border border-[#D4D4D4] hover:border-[#A3A3A3] text-sm font-semibold rounded transition-all shadow-xs\"\n              >\n                <Shield className=\"w-4 h-4 text-[#525252]\" />\n                <span>{t.hero.btnSafety}</span>\n              </button>\n            </div>\n\n            {/* Micro Highlights */}\n            <div className=\"pt-6 border-t border-[#E5E5E5] grid grid-cols-3 gap-4 text-xs text-[#737373]\">\n              <div>\n                <strong className=\"block text-[#171717] font-semibold text-sm\">{t.hero.highlights.freeTitle}</strong>\n                <span>{t.hero.highlights.freeSub}</span>\n              </div>\n              <div>\n                <strong className=\"block text-[#171717] font-semibold text-sm\">{t.hero.highlights.jargonTitle}</strong>\n                <span>{t.hero.highlights.jargonSub}</span>\n              </div>\n              <div>\n                <strong className=\"block text-[#171717] font-semibold text-sm\">{t.hero.highlights.indiaTitle}</strong>\n                <span>{t.hero.highlights.indiaSub}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Clean Editorial Compass Graphic */}\n          <div className=\"lg:col-span-5\">\n            <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-7 shadow-xs\">\n              <div className=\"flex items-center justify-between border-b border-[#F0F0EE] pb-4 mb-5\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\" />\n                  <span className=\"text-xs font-semibold text-[#171717] uppercase tracking-wider\">{t.hero.compass.title}</span>\n                </div>\n                <span className=\"text-[11px] text-[#737373] font-mono\">{t.hero.compass.badge}</span>\n              </div>\n\n              {/* Visual Guidance Cards */}\n              <div className=\"space-y-3.5\">\n                <div className=\"p-3.5 border border-[#E5E5E5] rounded bg-[#FAF9F6] flex items-start gap-3\">\n                  <div className=\"p-2 bg-white border border-[#E5E5E5] rounded text-[#171717]\">\n                    <CreditCard className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <span className=\"text-xs font-semibold text-[#171717] block\">{t.hero.compass.upiTitle}</span>\n                    <p className=\"text-xs text-[#525252] mt-0.5\">\n                      {t.hero.compass.upiDesc}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"p-3.5 border border-[#E5E5E5] rounded bg-[#FAF9F6] flex items-start gap-3\">\n                  <div className=\"p-2 bg-white border border-[#E5E5E5] rounded text-[#171717]\">\n                    <Lock className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <span className=\"text-xs font-semibold text-[#171717] block\">{t.hero.compass.otpTitle}</span>\n                    <p className=\"text-xs text-[#525252] mt-0.5\">\n                      {t.hero.compass.otpDesc}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"p-3.5 border border-[#E5E5E5] rounded bg-[#FAF9F6] flex items-start gap-3\">\n                  <div className=\"p-2 bg-white border border-[#E5E5E5] rounded text-[#171717]\">\n                    <Building2 className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <span className=\"text-xs font-semibold text-[#171717] block\">{t.hero.compass.portalTitle}</span>\n                    <p className=\"text-xs text-[#525252] mt-0.5\">\n                      {t.hero.compass.portalDesc}\n                    </p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"mt-5 pt-4 border-t border-[#F0F0EE] flex items-center justify-between text-xs\">\n                <span className=\"text-[#737373]\">{t.hero.compass.helplineLabel}</span>\n                <span className=\"font-semibold text-[#171717]\">{t.hero.compass.dial}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. WHY DIGITAL LITERACY MATTERS */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"border-t border-[#E5E5E5] pt-14\">\n          <div className=\"max-w-2xl mb-12\">\n            <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-2\">\n              {t.whyMatters.tag}\n            </span>\n            <h2 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-[#171717] font-editorial\">\n              {t.whyMatters.heading}\n            </h2>\n            <p className=\"text-sm sm:text-base text-[#525252] mt-3 leading-relaxed\">\n              {t.whyMatters.subheading}\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            {t.whyMatters.pillars.map((pillar, idx) => (\n              <div key={idx} className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n                <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-2\">\n                  {pillar.num}\n                </span>\n                <h3 className=\"text-base font-bold text-[#171717] mb-2\">{pillar.title}</h3>\n                <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n                  {pillar.desc}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 3. EXPLORE DIGITAL SKILLS \342\200\224 Structured Editorial Grid */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"border-t border-[#E5E5E5] pt-14\">\n          <div className=\"flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4\">\n            <div>\n              <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-2\">\n                {t.modules.tag}\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-[#171717] font-editorial\">\n                {t.modules.heading}\n              </h2>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#737373] max-w-md\">\n              {t.modules.subheading}\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            {/* Module 01: Digital Basics */}\n            <div\n              onClick={() => handleNavigate(\'basics\')}\n              className=\"p-8 border border-[#E5E5E5] bg-white hover:border-[#737373] transition-all rounded-sm group cursor-pointer flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6\">\n                  <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase\">\n                    01\n                  </span>\n                  <Smartphone className=\"w-5 h-5 text-[#525252] group-hover:text-[#171717] transition-colors\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-[#171717] mb-2 group-hover:text-blue-950\">\n                  {t.modules.mod1Title}\n                </h3>\n                <p className=\"text-sm text-[#525252] leading-relaxed mb-6\">\n                  {t.modules.mod1Desc}\n                </p>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-[#171717] pt-4 border-t border-[#F0F0EE]\">\n                <span>{t.modules.mod1Cta}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n              </div>\n            </div>\n\n            {/* Module 02: Digital Payments */}\n            <div\n              onClick={() => handleNavigate(\'payments\')}\n              className=\"p-8 border border-[#E5E5E5] bg-white hover:border-[#737373] transition-all rounded-sm group cursor-pointer flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6\">\n                  <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase\">\n                    02\n                  </span>\n                  <CreditCard className=\"w-5 h-5 text-[#525252] group-hover:text-[#171717] transition-colors\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-[#171717] mb-2 group-hover:text-blue-950\">\n                  {t.modules.mod2Title}\n                </h3>\n                <p className=\"text-sm text-[#525252] leading-relaxed mb-6\">\n                  {t.modules.mod2Desc}\n                </p>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-[#171717] pt-4 border-t border-[#F0F0EE]\">\n                <span>{t.modules.mod2Cta}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n              </div>\n            </div>\n\n            {/* Module 03: Online Safety */}\n            <div\n              onClick={() => handleNavigate(\'safety\')}\n              className=\"p-8 border border-[#E5E5E5] bg-white hover:border-[#737373] transition-all rounded-sm group cursor-pointer flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6\">\n                  <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase\">\n                    03\n                  </span>\n                  <Shield className=\"w-5 h-5 text-[#525252] group-hover:text-[#171717] transition-colors\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-[#171717] mb-2 group-hover:text-blue-950\">\n                  {t.modules.mod3Title}\n                </h3>\n                <p className=\"text-sm text-[#525252] leading-relaxed mb-6\">\n                  {t.modules.mod3Desc}\n                </p>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-[#171717] pt-4 border-t border-[#F0F0EE]\">\n                <span>{t.modules.mod3Cta}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n              </div>\n            </div>\n\n            {/* Module 04: Digital Services */}\n            <div\n              onClick={() => handleNavigate(\'services\')}\n              className=\"p-8 border border-[#E5E5E5] bg-white hover:border-[#737373] transition-all rounded-sm group cursor-pointer flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6\">\n                  <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase\">\n                    04\n                  </span>\n                  <Building2 className=\"w-5 h-5 text-[#525252] group-hover:text-[#171717] transition-colors\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-[#171717] mb-2 group-hover:text-blue-950\">\n                  {t.modules.mod4Title}\n                </h3>\n                <p className=\"text-sm text-[#525252] leading-relaxed mb-6\">\n                  {t.modules.mod4Desc}\n                </p>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-[#171717] pt-4 border-t border-[#F0F0EE]\">\n                <span>{t.modules.mod4Cta}</span>\n                <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-1\" />\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. INTERACTIVE SCAM DETECTOR SECTION */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"border-t border-[#E5E5E5] pt-14\">\n          <div className=\"max-w-2xl mb-8\">\n            <div className=\"inline-flex items-center gap-1.5 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-[#171717] bg-[#EFEFED] rounded-xs mb-2\">\n              <Eye className=\"w-3.5 h-3.5 text-[#525252]\" />\n              <span>{t.spotScam.tag}</span>\n            </div>\n            <h2 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-[#171717] font-editorial\">\n              {t.spotScam.title}\n            </h2>\n            <p className=\"text-sm text-[#525252] mt-2\">\n              {t.spotScam.subtitle}\n            </p>\n          </div>\n\n          {/* Interactive Scam Spotter Component */}\n          <ScamSpotter language={language} />\n        </div>\n      </section>\n\n      {/* 5. TEST YOUR KNOWLEDGE BANNER */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"p-8 sm:p-12 border border-[#171717] bg-[#171717] text-white rounded-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n          <div className=\"max-w-xl space-y-2\">\n            <span className=\"text-xs font-mono uppercase tracking-wider text-[#A3A3A3]\">\n              {t.quizBanner.tag}\n            </span>\n            <h3 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-white font-editorial\">\n              {t.quizBanner.title}\n            </h3>\n            <p className=\"text-sm text-[#D4D4D4] leading-relaxed\">\n              {t.quizBanner.description}\n            </p>\n          </div>\n          <button\n            id=\"home-cta-quiz\"\n            onClick={() => handleNavigate(\'quiz\')}\n            className=\"inline-flex items-center gap-2 px-6 py-3.5 bg-white text-[#171717] hover:bg-[#E5E5E5] font-semibold text-sm rounded transition-colors shrink-0 shadow-xs\"\n          >\n            <HelpCircle className=\"w-4 h-4 text-[#171717]\" />\n            <span>{t.quizBanner.btnText}</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
