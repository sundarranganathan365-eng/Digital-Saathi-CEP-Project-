        lines {
          text: "    question: \'What is the safest way to connect to the internet when accessing your bank account or making payments?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionHi: \'\340\244\254\340\245\210\340\244\202\340\244\225 \340\244\226\340\244\276\340\244\244\340\244\276 \340\244\246\340\245\207\340\244\226\340\244\250\340\245\207 \340\244\257\340\244\276 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\260\340\244\244\340\245\207 \340\244\270\340\244\256\340\244\257 \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\270\340\245\207 \340\244\234\340\245\201\340\244\241\340\244\274\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\244\340\244\260\340\245\200\340\244\225\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionMr: \'\340\244\254\340\244\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260 \340\244\225\340\244\260\340\244\244\340\244\276\340\244\250\340\244\276 \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\234\340\245\213\340\244\241\340\244\243\340\245\200\340\244\232\340\244\276 \340\244\270\340\244\260\340\245\215\340\244\265\340\244\276\340\244\244 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227 \340\244\225\340\245\213\340\244\243\340\244\244\340\244\276 \340\244\206\340\244\271\340\245\207?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Free open Wi-Fi at a railway station or tea stall with no password\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Your personal mobile cellular data (4G/5G) or secure private home Wi-Fi\', isCorrect: true },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Connecting to an unknown stranger\342\200\231s open mobile hotspot\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Connecting to any public network called \"FREE_INTERNET\"\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Public open Wi-Fi networks without passwords can be monitored by hackers to capture unencrypted network traffic. Use your own mobile data plan for private banking tasks.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationHi: \'\340\244\254\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\244\255\340\245\200 \340\244\255\340\245\200 \340\244\226\340\245\201\340\244\262\340\245\207 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210 (Public Wi-Fi) \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244 \340\244\205\340\244\252\340\244\250\340\245\207 \340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationMr: \'\340\244\254\340\244\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260\340\244\276\340\244\202\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\256\340\245\213\340\244\253\340\244\244 \340\244\265\340\244\276\340\244\257-\340\244\253\340\244\276\340\244\257 \340\244\265\340\244\276\340\244\252\340\244\260\340\245\202 \340\244\250\340\244\225\340\244\276. \340\244\270\340\245\215\340\244\265\340\244\244\340\244\203\340\244\232\340\244\276 \340\244\256\340\245\213\340\244\254\340\244\276\340\244\210\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276.\',"
