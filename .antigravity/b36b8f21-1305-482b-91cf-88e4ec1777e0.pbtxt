        lines {
          text: "    question: \'Someone calls and says they want to send you \342\202\2715,000 for an old item you listed. They say: \"Please enter your UPI PIN to receive the money into your bank account.\" What should you do?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
