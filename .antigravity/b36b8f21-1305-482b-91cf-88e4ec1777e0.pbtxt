    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { Search, X, ArrowRight, BookOpen, Shield, Smartphone, FileText, HelpCircle } from \'lucide-react\';\n\ninterface SearchModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onNavigate: (page: PageId, sectionId?: string) => void;\n  language?: Language;\n}\n\ninterface LocalizedSearchEntry {\n  titleEn: string;\n  titleHi: string;\n  titleMr: string;\n  categoryEn: string;\n  categoryHi: string;\n  categoryMr: string;\n  page: PageId;\n  sectionId?: string;\n  summaryEn: string;\n  summaryHi: string;\n  summaryMr: string;\n  icon: React.ReactNode;\n}\n\nconst SEARCH_DATABASE: LocalizedSearchEntry[] = [\n  {\n    titleEn: \'UPI Payment Fundamentals\',\n    titleHi: \'UPI \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\245\200 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202\',\n    titleMr: \'UPI \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270 \340\244\256\340\245\202\340\244\262\340\244\255\340\245\202\340\244\244 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n    categoryEn: \'Digital Payments\',\n    categoryHi: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 (UPI)\',\n    categoryMr: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270\',\n    page: \'payments\',\n    sectionId: \'what-is-upi\',\n    summaryEn: \'What Unified Payments Interface is, how VPA IDs work, and real-time bank transfers.\',\n    summaryHi: \'UPI \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210, VPA \340\244\206\340\244\210\340\244\241\340\245\200 \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\225\340\244\276\340\244\256 \340\244\225\340\244\260\340\244\244\340\245\200 \340\244\271\340\245\210 \340\244\224\340\244\260 24/7 \340\244\254\340\245\210\340\244\202\340\244\225 \340\244\262\340\245\207\340\244\250\340\244\246\340\245\207\340\244\250\340\245\244\',\n    summaryMr: \'UPI \340\244\225\340\244\276\340\244\257 \340\244\206\340\244\271\340\245\207, VPA \340\244\206\340\244\257\340\244\241\340\245\200 \340\244\225\340\244\270\340\244\276 \340\244\232\340\244\276\340\244\262\340\244\244\340\245\213 \340\244\206\340\244\243\340\244\277 \340\244\254\340\244\201\340\244\225 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260.\',\n    icon: <BookOpen className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    titleEn: \'How to make a UPI Payment (7-Step Guide)\',\n    titleHi: \'\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 UPI \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 7 \340\244\232\340\244\260\340\244\243\',\n    titleMr: \'\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 UPI \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\244\232\340\245\215\340\244\257\340\244\276 \340\245\255 \340\244\252\340\244\276\340\244\257\340\244\261\340\245\215\340\244\257\340\244\276\',\n    categoryEn: \'Digital Payments\',\n    categoryHi: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 (UPI)\',\n    categoryMr: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270\',\n    