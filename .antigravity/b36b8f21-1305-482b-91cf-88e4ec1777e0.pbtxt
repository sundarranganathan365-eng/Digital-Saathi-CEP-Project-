25 (\340\244\270\340\245\215\340\244\225\340\245\205\340\244\256)?\',\n      btnSafe: \'\340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\256\340\245\207\340\244\270\340\245\207\340\244\234\',\n      btnScam: \'\340\244\270\340\244\202\340\244\266\340\244\257\340\244\276\340\244\270\340\245\215\340\244\252\340\244\246 / \340\244\270\340\245\215\340\244\225\340\245\205\340\244\256\',\n      simulatedTag: \'\340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\250\340\244\256\340\245\201\340\244\250\340\244\276 \340\244\211\340\244\246\340\244\276\340\244\271\340\244\260\340\244\243 (Simulated)\',\n    },\n    textResize: {\n      title: \'\340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\244\276\340\244\202\340\244\232\340\244\276 \340\244\206\340\244\225\340\244\276\340\244\260\',\n      smaller: \'\340\244\256\340\244\247\340\245\215\340\244\257\340\244\256\',\n      normal: \'\340\244\256\340\245\213\340\244\240\340\244\276\',\n      larger: \'\340\244\226\340\245\202\340\244\252 \340\244\256\340\245\213\340\244\240\340\244\276\',\n    },\n    footer: {\n      tagline: \'\340\244\244\340\244\202\340\244\244\340\245\215\340\244\260\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\252\340\245\215\340\244\260\340\244\244\340\245\215\340\244\257\340\245\207\340\244\225\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\270\340\245\213\340\244\252\340\245\207 \340\244\206\340\244\243\340\244\277 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\254\340\244\250\340\244\265\340\244\243\340\245\207.\',\n      aboutCep: \'\340\244\244\340\245\203\340\244\244\340\245\200\340\244\257 \340\244\265\340\244\260\340\245\215\340\244\267 \340\244\254\340\245\200\340\244\217\340\244\270\340\244\270\340\245\200 \340\244\225\340\245\211\340\244\256\340\245\215\340\244\25