0\244\257\340\244\276\340\244\260 \340\244\225\340\245\207\340\244\262\340\245\207\340\244\262\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\225\340\244\262\340\245\215\340\244\252 \340\244\206\340\244\271\340\245\207. \340\244\257\340\245\207\340\244\245\340\245\207 \340\244\225\340\245\213\340\244\243\340\244\244\340\245\200\340\244\271\340\245\200 \340\244\254\340\244\201\340\244\225 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200, \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\265\340\245\210\340\244\257\340\244\225\340\245\215\340\244\244\340\244\277\340\244\225 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200 \340\244\230\340\245\207\340\244\244\340\244\262\340\245\200 \340\244\234\340\244\276\340\244\244 \340\244\250\340\244\276\340\244\271\340\245\200. \340\244\257\340\244\276\340\244\232\340\244\276 \340\244\225\340\245\213\340\244\243\340\244\244\340\245\215\340\244\257\340\244\276\340\244\271\340\245\200 \340\244\254\340\244\201\340\244\225\340\245\207\340\244\266\340\245\200 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\257\340\244\202\340\244\244\340\245\215\340\244\260\340\244\243\340\245\207\340\244\266\340\245\200 \340\244\265\340\245\215\340\244\257\340\244\276\340\244\265\340\244\270\340\244\276\340\244\257\340\244\277\340\244\225 \340\244\270\340\244\202\340\244\254\340\244\202\340\244\247 \340\244\250\340\244\276\340\244\271\340\245\200.\',\n  },\n};\n\nexport const AboutPage: React.FC<AboutPageProps> = ({ setCurrentPage, language }) => {\n  const a = aboutContent[language];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <GraduationCap className=\"w-4 h-4 text-[#171717]\" />\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373]\">{a.tag}</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          {a.title}\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          {a.subtitle}\n        </p>\n      </div>\n\n      {/* Mission */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        <div className=\"lg:col-span-7 p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            {a.missionTitle}\n          </h2>\n          <p className=\"text-sm sm:text-base text-[#525252] leading-relaxed\">\n            {a.missionDesc}\n          </p>\n        </div>\n\n        <div className=\"lg:col-span-5 p-8 border border-[#E5E5E5] bg-[#FAF9F6] rounded-sm space-y-4\">\n          <h3 className=\"text-lg font-bold text-[#171717]\">{a.themeTitle}</h3>\n          <div className=\"space-y-3 pt-1 text-xs\">\n            {a.themeInfo.map((item, idx) => (\n              <div key={idx} className=\"flex flex-col border-b border-[#EBEBEA] pb-2 last:border-b-0\">\n                <span className=\"text-[#737373] font-medium\">{item.label}</span>\n                <span className=\"font-semibold text-[#171717] mt-0.5\">{item.val}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 3 Pillars */}\n      <section className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {a.pillars.map((pil, idx) => {\n          const IconComp = pil.icon;\n          return (\n            <div key={idx} className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm space-y-3\">\n              <div className=\"p-2.5 bg-[#FAF9F6] border border-[#E5E5E5] w-fit rounded text-[#171717]\">\n                <IconComp className=\"w-5 h-5\" />\n              </div>\n              <h3 className=\"text-base font-bold text-[#171717]\">{pil.title}</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n                {pil.desc}\n              </p>\n            </div>\n          );\n        })}\n      </section>\n\n      {/* Non Commercial Disclaimer */}\n      <section className=\"p-6 border border-[#E5E5E5] bg-[#FAF9F6] rounded-sm space-y-2\">\n        <h4 className=\"text-xs font-mono font-bold uppercase tracking-wider text-[#171717]\">\n          {a.disclaimerTitle}\n        </h4>\n        <p className=\"text-xs text-[#737373] leading-relaxed\">\n          {a.disclaimerDesc}\n        </p>\n      </section>\n    </div>\n  );\n};\n"
    }
