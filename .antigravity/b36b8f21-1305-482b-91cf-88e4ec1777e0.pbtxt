243\340\244\244\340\245\200 \340\244\227\340\245\213\340\244\267\340\245\215\340\244\237 \340\244\244\340\244\252\340\244\276\340\244\270\340\244\243\340\245\207 \340\244\270\340\244\260\340\245\215\340\244\265\340\244\276\340\244\244 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\244\340\245\215\340\244\265\340\244\276\340\244\232\340\245\207 \340\244\206\340\244\271\340\245\207?\',\n    options: [\n      { text: \'Check if your mobile phone battery is 100%\', isCorrect: false },\n      { text: \'Verify the recipient\342\200\231s real name and the amount displayed on the screen\', isCorrect: true },\n      { text: \'Show your PIN to the shopkeeper for confirmation\', isCorrect: false },\n      { text: \'Restart your mobile phone\', isCorrect: false },\n    ],\n    explanation: \'Always verify that the recipient name shown on the UPI screen matches the merchant or person you intended to pay, and double-check the amount before typing your PIN.\',\n    explanationHi: \'\340\244\252\340\244\277\340\244\250 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\270\340\245\207 \340\244\252\340\244\271\340\244\262\340\245\207 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260 \340\244\246\340\244\277\340\244\226\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\252\340\245\215\340\244\244\340\244\225\340\244\260\340\245\215\340\244\244\340\244\276 \340\244\225\340\244\276 \340\244\250\340\244\276\340\244\256 \340\244\224\340\244\260 \340\244\260\340\244\276\340\244\266\340\244\277 \340\244\205\340\244\265\340\244\266\340\245\215\340\244\257 \340\244\234\340\244\276\340\244\202\340\244\232\340\245\207\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\252\340\244\277\340\244\250 \340\244\237\340\244\276\340\244\225\340\244\243\340\245\215\340\244\257\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\245\200 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250\340\244\265\340\244\260 \340\244\246\340\244\277\340\244\270\340\244\243\340\244\276\340\244\260\340\245\207 \340\244\250\340\244\276\340\244\265 \340\244\206\340\244\243\340\244\277 \340\244\260\340\244\225\340\245\215\340\244\225\340\244\256 \340\244\254\340\244\260\340\245\213\340\244\254\340\244\260 \340\244\205\340\244\270\340\244\262\340\245\215\340\244\257\340\244\276\340\244\232\340\245\200 \340\244\226\340\244\276\340\244\244\340\245\215\340\244\260\340\245\200 \340\244\225\340\244\260\340\244\276.\',\n  },\n  {\n    id: 6,\n    category: \'services\',\n    question: \'What is DigiLocker, and why is it useful?\',\n    questionHi: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 (DigiLocker) \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210 \340\244\224\340\244\260 \340\244\257\340\244\271 \340\244\225\340\245\215\340\244\257\340\245\213\340\244\202 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227\340\245\200 \340\244\271\340\245\210?\',\n    questionMr: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 (DigiLocker) \340\244\225\340\244\276\340\244\257 \340\244\206\340\244\271\340\245\207 \340\244\206\340\244\243\340\244\277 \340\244\244\340\245\215\340\244\257\340\244\276\340\244\232\340\244\276 \340\244\225\340\244\276\340\244\257 \340\244\253\340\244\276\340\244\257\340\244\246\340\244\276 \340\244\206\340\244\271\340\245\207?\',\n    options: [\n      { text: \'A private mobile game to store points\', isCorrect: false },\n      { text: \'A government platform to securely store and share legally valid digital documents\', isCorrect: true },\n      { text: \'An online shopping store for physical lockers and safes\', isCorrect: false },\n      { text: \'A social media app for chatting\', isCorrect: false },\n    ],\n    explanation: \'DigiLocker is an initiative by the Ministry of Electronics & IT (Govt. of India) to provide cloud-based access to authentic digital documents (Aadhaar, Driving License, Vehicle RC, Education Certificates) that are legally recognized under IT Act 2000.\',\n    explanationHi: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260 \340\244\225\340\245\200 \340\244\217\340\244\225 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\270\340\245\207\340\244\265\340\244\276 \340\244\271\340\245\210 \340\244\234\340\244\271\340\244\276\340\244\201 \340\244\206\340\244\252 \340\244\206\340\244\247\340\244\276\340\244\260, \340\244\241\340\245\215\340\244\260\340\244\276\340\244\207\340\244\265\340\244\277\340\244\202\340\244\227 \340\244\262\340\244\276\340\244\207\340\244\270\340\245\207\340\244\202\340\244\270 \340\244\206\340\244\246\340\244\277 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\260\340\245\202\340\244\252 \340\244\270\340\245\207 \340\244\260\340\244\226 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\271\340\245\207 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\244\232\340\245\207 \340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\245\262\340\244\252 \340\244\206\340\244\271\340\245\207 \340\244\234\340\245\215\340\244\257\340\244\276\340\244\256\340\244\247\340\245\215\340\244\257\340\245\207 \340\244\206\340\244\247\340\244\276\340\244\260, \340\244\262\340\244\276\340\244\257\340\244\2