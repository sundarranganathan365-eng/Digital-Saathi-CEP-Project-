    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { quizQuestions } from \'../data/quizQuestions\';\nimport {\n  HelpCircle,\n  CheckCircle2,\n  XCircle,\n  ArrowRight,\n  RotateCcw,\n  BookOpen,\n  ShieldAlert,\n  Award,\n} from \'lucide-react\';\n\ninterface QuizPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const QuizPage: React.FC<QuizPageProps> = ({ setCurrentPage, language }) => {\n  const [currentIdx, setCurrentIdx] = useState(0);\n  const [selectedOption, setSelectedOption] = useState<number | null>(null);\n  const [score, setScore] = useState(0);\n  const [quizCompleted, setQuizCompleted] = useState(false);\n  const [answersHistory, setAnswersHistory] = useState<{ questionId: number; selected: number; isCorrect: boolean }[]>([]);\n\n  const question = quizQuestions[currentIdx];\n  const totalQuestions = quizQuestions.length;\n  const isAnswered = selectedOption !== null;\n\n  const handleSelectOption = (idx: number) => {\n    if (isAnswered) return;\n    setSelectedOption(idx);\n    const isCorrect = question.options[idx].isCorrect;\n    if (isCorrect) {\n      setScore((prev) => prev + 1);\n    }\n    setAnswersHistory((prev) => [\n      ...prev,\n      { questionId: question.id, selected: idx, isCorrect },\n    ]);\n  };\n\n  const handleNext = () => {\n    if (currentIdx + 1 < totalQuestions) {\n      setCurrentIdx((prev) => prev + 1);\n      setSelectedOption(null);\n    } else {\n      setQuizCompleted(true);\n    }\n  };\n\n  const handleRestart = () => {\n    setCurrentIdx(0);\n    setSelectedOption(null);\n    setScore(0);\n    setQuizCompleted(false);\n    setAnswersHistory([]);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  // Helper for localized question string\n  const getLocalizedQuestion = () => {\n    if (language === \'hi\' && question.questionHi) return question.questionHi;\n    if (language === \'mr\' && question.questionMr) return question.questionMr;\n    return question.question;\n  };\n\n  const getLocalizedExplanation = () => {\n    if (language === \'hi\' && question.explanationHi) return question.explanationHi;\n    if (language === \'mr\' && question.explanationMr) return question.explanationMr;\n    return question.explanation;\n  };\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12\">\n      {/* Header */}\n      <div className=\"border-b border-[#E5E5E5] pb-6\">\n        <div className=\"flex items-center gap-2 mb-2\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Module 05\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">Self-Assessment</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#171717] font-editorial\">\n          Digital Literacy & Safety Knowledge Check\n        </h1>\n        <p className=\"text-sm text-[#525252] mt-2\">\n          Evaluate your understanding of everyday digital precautions, UPI transactions, and online scam detection.\n        </p>\n      </div>\n\n      {!quizCompleted ? (\n        <div className=\"space-y-8\">\n          {/* Progress Bar & Counter */}\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center justify-between text-xs text-[#737373]\">\n              <span className=\"font-mono font-semibold text-[#171717]\">\n                Question {String(currentIdx + 1).padStart(2, \'0\')} of {String(totalQuestions).padStart(2, \'0\')}\n              </span>\n              <span className=\"capitalize text-[#737373] bg-[#F5F5F4] px-2 py-0.5 rounded border border-[#E5E5E5]\">\n                Topic: {question.category}\n              </span>\n            </div>\n            <div className=\"w-full bg-[#E5E5E5] h-1.5 rounded-full overflow-hidden\">\n              <div\n                className=\"bg-[#171717] h-full transition-all duration-300\"\n                style={{ width: `${((currentIdx + 1) / totalQuestions) * 100}%` }}\n              />\n            </div>\n          </div>\n\n          {/* Question Box */}\n          <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-8 space-y-6 shadow-xs\">\n            <h3 className=\"text-lg sm:text-xl font-bold text-[#171717] leading-snug font-editorial\">\n              {getLocalizedQuestion()}\n            </h3>\n\n            {/* Options */}\n            <div className=\"space-y-3\">\n              {question.options.map((opt, idx) => {\n                const isSelected = selectedOption === idx;\n                const letter = String.fromCharCode(65 + idx);\n\n                let optionStyles = \'border-[#E5E5E5] bg-[#FAF9F6] text-[#171717] hover:border-[#A3A3A3]\';\n                if (isAnswered) {\n                  if (opt.isCorrect) {\n                    optionStyles = \'border-emerald-500 bg-emerald-50 text-emerald-950 font-semibold\';\n                  } else if (isSelected && !opt.isCorrect) {\n                    optionStyles = \'border-red-500 bg-red-50 text-red-950 line-through\';\n                  } else {\n                    optionStyles = \'border-[#E5E5E5] bg-[#FAF9F6] text-[#737373] opacity-60\';\n                  }\n                }\n\n                return (\n                  <button\n                    key={idx}\n                    id={`quiz-opt-${currentIdx}-${idx}`}\n                    onClick={() => handleSelectOption(idx)}\n                    disabled={isAnswered}\n                    className={`w-full flex items-start gap-3 p-4 rounded text-left border transition-all text-xs sm:text-sm ${optionStyles}`}\n                  >\n                    <span className=\"w-6 h-6 rounded-full border border-current flex items-center justify-center shrink-0 text-xs font-mono font-bold\">\n                      {letter}\n                    </span>\n                    <span className=\"mt-0.5 leading-relaxed\">{opt.text}</span>\n                  </button>\n                );\n              })}\n            </div>\n\n            {/* Answer Explanation Feedback */}\n            {isAnswered && (\n              <div className=\"border-t border-[#E5E5E5] pt-5 space-y-3 animate-in fade-in duration-150\">\n                <div className=\"flex items-center gap-2\">\n                  {question.options[selectedOption!].isCorrect ? (\n                    <div className=\"flex items-center gap-1.5 text-xs font-bold text-emerald-800 bg-emerald-100 px-2.5 py-1 rounded\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n                      <span>Correct Answer!</span>\n                    </div>\n                  ) : (\n                    <div className=\"flex items-center gap-1.5 text-xs font-bold text-red-800 bg-red-100 px-2.5 py-1 rounded\">\n                      <XCircle className=\"w-4 h-4 text-red-700\" />\n                      <span>Incorrect Choice</span>\n                    </div>\n                  )}\n                </div>\n\n                <p className=\"text-xs sm:text-sm text-[#404040] leading-relaxed bg-[#FAF9F6] p-3.5 border border-[#E5E5E5] rounded\">\n                  <strong className=\"text-[#171717]\">Educational Rationale:</strong> {getLocalizedExplanation()}\n                </p>\n\n                <div className=\"flex justify-end pt-2\">\n                  <button\n                    id=\"quiz-btn-next\"\n                    onClick={handleNext}\n                    className=\"inline-flex items-center gap-2 px-6 py-2.5 bg-[#171717] hover:bg-[#333333] text-white text-xs font-semibold rounded transition-colors\"\n                  >\n                    <span>{currentIdx + 1 === totalQuestions ? \'View Final Results\' : \'Next Question\'}</span>\n                    <ArrowRight className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      ) : (\n        /* QUIZ SCORE COMPLETION CARD */\n        <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-8 sm:p-12 text-center space-y-8 shadow-xs animate-in zoom-in-95 duration-200\">\n          <div className=\"w-14 h-14 rounded-full bg-[#FAF9F6] border border-[#E5E5E5] flex items-center justify-center mx-auto text-[#171717]\">\n            <Award className=\"w-7 h-7\" />\n          </div>\n\n          <div className=\"space-y-2\">\n            <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373]\">\n              Assessment Complete\n            </span>\n            <h2 className=\"text-3xl sm:text-4xl font-bold text-[#171717] font-editorial\">\n              Your Score: <span className=\"font-mono\">{score}</span> / {totalQuestions}\n            </h2>\n          </div>\n\n          {/* Performance Tier Feedback */}\n          <div className=\"max-w-md mx-auto p-4 rounded border text-xs sm:text-sm\">\n            {score >= 8 && (\n              <div className=\"text-emerald-950 bg-emerald-50 border border-emerald-300 p-4 rounded\">\n                <strong className=\"block text-sm font-bold text-emerald-900 mb-1\">Excellent Digital Awareness!</strong>\n                <span>You have a solid grasp of UPI safety, phishing prevention, and secure online behavior. Help educate friends and elderly family members!</span>\n              </div>\n            )}\n            {score >= 5 && score < 8 && (\n              <div className=\"text-amber-950 bg-amber-50 border border-amber-300 p-4 rounded\">\n                <strong className=\"block text-sm font-bold text-amber-900 mb-1\">Good Start \342\200\224 Review a Few Topics</strong>\n                <span>You understand key concepts, but review the UPI Golden Rules and Fake Customer Care safety sections to strengthen your scam immunity.</span>\n              </div>\n            )}\n            {score < 5 && (\n              <div className=\"text-red-950 bg-red-50 border border-red-300 p-4 rounded\">\n                <strong className=\"block text-sm font-bold text-red-900 mb-1\">Recommended: Revisit Core Safety Lessons</strong>\n                <span>Take a few minutes to explore the Digital Payments and Online Safety modules before navigating everyday online services.</span>\n              </div>\n            )}\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex flex-wrap items-center justify-center gap-4 pt-4 border-t border-[#E5E5E5]\">\n            <button\n              id=\"quiz-btn-retry\"\n              onClick={handleRestart}\n              className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-[#D4D4D4] hover:border-[#A3A3A3] text-[#171717] text-xs font-semibold rounded transition-colors\"\n            >\n              <RotateCcw className=\"w-3.5 h-3.5\" />\n              <span>Retake Quiz</span>\n            </button>\n\n            <button\n              id=\"quiz-btn-review-safety\"\n              onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n              className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] hover:bg-[#333333] text-white text-xs font-semibold rounded transition-colors\"\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Review Online Safety Module</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
