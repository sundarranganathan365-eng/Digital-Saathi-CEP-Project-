        lines {
          text: "    questionHi: \'\340\244\254\340\245\210\340\244\202\340\244\225 \340\244\225\340\244\260\340\245\215\340\244\256\340\244\232\340\244\276\340\244\260\340\245\200 \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\246\340\244\276\340\244\265\340\244\276 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\244\276 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244\340\244\277 \340\244\241\340\245\207\340\244\254\340\244\277\340\244\237 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\232\340\244\276\340\244\262\340\245\202 \340\244\260\340\244\226\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\206\340\244\252\340\244\225\340\244\276 6-\340\244\205\340\244\202\340\244\225\340\245\213\340\244\202 \340\244\225\340\244\276 OTP \340\244\256\340\244\276\340\244\202\340\244\227\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\270\340\244\271\340\245\200 \340\244\225\340\244\246\340\244\256 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionMr: \'\340\244\254\340\244\201\340\244\225 \340\244\225\340\244\260\340\245\215\340\244\256\340\244\232\340\244\276\340\244\260\340\245\200 \340\244\205\340\244\270\340\244\262\340\245\215\340\244\257\340\244\276\340\244\232\340\245\207 \340\244\270\340\244\276\340\244\202\340\244\227\340\245\202\340\244\250 \340\244\241\340\245\207\340\244\254\340\244\277\340\244\237 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\232\340\244\276\340\244\262\340\245\202 \340\244\240\340\245\207\340\244\265\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\244\340\245\201\340\244\256\340\244\232\340\245\215\340\244\257\340\244\276\340\244\225\340\244\241\340\245\202\340\244\250 \340\245\254-\340\244\205\340\244\202\340\244\225\340\245\200 OTP \340\244\256\340\244\276\340\244\227\340\244\277\340\244\244\340\244\262\340\244\276 \340\244\234\340\244\276\340\244\244\340\245\213. \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\244\276\340\244\262?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
