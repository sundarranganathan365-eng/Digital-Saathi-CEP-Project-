        lines {
          text: "    explanation: \'A flashlight app only needs camera flash permission. If a basic utility asks for SMS or Contacts access, it is likely spyware or data-stealing malware.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationHi: \'\340\244\237\340\245\211\340\244\260\340\245\215\340\244\232 \340\244\220\340\244\252 \340\244\225\340\245\213 \340\244\225\340\245\207\340\244\265\340\244\262 \340\244\225\340\245\210\340\244\256\340\244\260\340\245\207 \340\244\225\340\245\200 \340\244\253\340\245\215\340\244\262\340\245\210\340\244\266\340\244\262\340\244\276\340\244\207\340\244\237 \340\244\225\340\245\200 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225\340\244\244\340\244\276 \340\244\271\340\245\213\340\244\244\340\245\200 \340\244\271\340\245\210\340\245\244 SMS \340\244\257\340\244\276 \340\244\225\340\245\211\340\244\250\340\245\215\340\244\237\340\245\210\340\244\225\340\245\215\340\244\237\340\245\215\340\244\270 \340\244\256\340\244\276\340\244\202\340\244\227\340\244\250\340\244\276 \340\244\270\340\244\202\340\244\246\340\244\277\340\244\227\340\245\215\340\244\247 \340\244\224\340\244\260 \340\244\226\340\244\244\340\244\260\340\244\250\340\244\276\340\244\225 \340\244\271\340\245\210\340\245\244\',"
