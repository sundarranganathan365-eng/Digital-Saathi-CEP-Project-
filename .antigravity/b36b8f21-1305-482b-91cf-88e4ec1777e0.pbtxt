          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'\340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\252\340\244\260 \340\244\262\340\245\214\340\244\237\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\250\340\245\200\340\244\232\340\245\207 \340\244\270\340\245\207 \340\244\212\340\244\252\340\244\260 \340\244\225\340\245\200 \340\244\223\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',"
