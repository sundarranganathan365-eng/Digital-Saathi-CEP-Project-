          text: "    questionHi: \'\340\244\206\340\244\252 \340\244\217\340\244\225 \340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260 \340\244\225\340\245\200 \340\244\265\340\245\207\340\244\254\340\244\270\340\244\276\340\244\207\340\244\237 \340\244\225\340\245\207 \340\244\252\340\244\244\340\245\207 \340\244\225\340\245\200 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\225\340\244\260 \340\244\270\340\244\225\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\',"
