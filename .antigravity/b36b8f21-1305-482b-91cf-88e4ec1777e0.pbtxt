    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { PhoneCall, ShieldAlert, BookOpen, ExternalLink, Heart, CheckCircle2 } from \'lucide-react\';\n\ninterface FooterProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst footerLabels = {\n  en: {\n    curriculumTitle: \'Learning Guides\',\n    mod1: \'01. Digital Basics\',\n    mod2: \'02. Safe UPI Payments\',\n    mod3: \'03. Scam & Fraud Defense\',\n    mod4: \'04. Government Digital Services\',\n    practiceTitle: \'Interactive Practice\',\n    toolScam: \'Scam Spotter Simulator\',\n    toolQuiz: \'Knowledge Test (10 Questions)\',\n    toolChecklist: \"Safety DOs & DON\'Ts\",\n    toolRules: \'Golden Rules of UPI\',\n    projectTitle: \'Project Information\',\n    aboutInit: \'About Digital Saathi\',\n    problemState: \'Social Mission & CEP\',\n    batch: \'BSc Computer Science Initiative\',\n    openSourceTag: \'Free Public Educational Resource\',\n    callBtn: \'Call 1930 Helpline\',\n    inclusion: \'Created for Digital Literacy & Inclusion\',\n    noAffiliation: \'Independent Educational Initiative\',\n  },\n  hi: {\n    curriculumTitle: \'\340\244\205\340\244\247\340\245\215\340\244\257\340\244\257\340\244\250 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\277\340\244\225\340\244\276\',\n    mod1: \'01. \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202\',\n    mod2: \'02. \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 UPI \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250\',\n    mod3: \'03. \340\244\247\340\245\213\340\244\226\340\244\276\340\244\247\340\244\241\340\244\274\340\245\200 \340\244\265 \340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\254\340\244\232\340\244\276\340\244\265\',\n    mod4: \'04. \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n    practiceTitle: \'\340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\265 \340\244\252\340\244\260\340\245\200\340\244\225\340\245\215\340\244\267\340\244\243\',\n    toolScam: \'\340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 \340\244\270\340\244\277\340\244\256\340\245\215\340\244\257\340\245\201\340\244\262\340\245\207\340\244\237\340\244\260\',\n    toolQuiz: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\237\340\245\207\340\244\270\340\245\215\340\244\237 (10 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250)\',\n    toolChecklist: \'\340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202 / \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    toolRules: \'UPI \340\244\225\340\245\207 \340\244\270\340\245\201\340\244\250\340\244\271\340\244\260\340\245\207 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    projectTitle: \'\340\244\252\340\245\215\340\244\260\340\245\213\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200\',\n    aboutInit: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\245\340\245\200 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\260\340\245\207 \340\244\256\340\245\207\340\244\202\',\n    problemState: \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\234\340\244\277\340\244\225 \340\244\211\340\244\246\340\245\215\340\244\246\340\245\207\340\244\266\340\245\215\340\244\257 \340\244\265 CEP\',\n    batch: \'\340\244\254\340\245\200\340\244\217\340\244\270\340\244\270\340\245\200 \340\244\225\340\244\202\340\244\252\340\245\215\340\244\257\340\245\202\340\244\237\340\244\260 \340\244\270\340\244\276\340\244\207\340\244\202\340\244\270 \340\244\252\340\244\271\340\244\262\',\n    openSourceTag: \'\340\244\250\340\244\277\340\244\203\340\244\266\340\245\201\340\244\262\340\245\215\340\244\225 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\256\340\244\202\340\244\232\',\n    callBtn: \'1930 \340\244\252\340\244\260 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202\',\n    inclusion: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276 \340\244\271\340\245\207\340\244\244\340\245\201 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\277\340\244\244\',\n    noAffiliation: \'\340\244\270\340\245\215\340\244\265\340\244\244\340\244\202\340\244\244\340\245\215\340\244\260 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\252\340\244\271\340\244\262\',\n  },\n  mr: {\n    curriculumTitle: \'\340\244\256\340\244\276\340\244\260\340\245\215\340\244\227\340\244\246\340\244\260\340\245\215\340\244\266\340\244\250 \340\244\265\340\244\277\340\244\267\340\244\257\',\n    mod1: \'\340\245\246\340\245\247. \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\256\340\245\202\340\244\262\340\244\255\340\245\202\340\244\244 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n    mod2: \'\340\245\246\340\245\250. \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 UPI \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270\',\n    mod3: \'\340\245\246\340\245\251. \340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225 \340\244\265 \340\244\254\340\244\232\340\244\276\340\244\265\',\n    mod4: \'\340\245\246\340\245\252. \340\244\266\340\244\276\340\244\270\340\244\225\340\245\200\340\244\257 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\',\n    practiceTitle: \'\340\244\270\340\244\260\340\244\276\340\244\265 \340\244\265 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200\',\n    toolScam: \'\340\244\270\340\245\215\340\244\225\340\245\205\340\244\256 \340\244\223\340\244\263\340\244\226 \340\244\270\340\244\277\340\244\256\340\245\215\340\244\257\340\245\201\340\244\262\340\245\207\340\244\237\340\244\260\',\n    toolQuiz: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200 (\340\245\247\340\245\246 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250)\',\n    toolChecklist: \'\340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\244\276\340\244\265\340\245\207 / \340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\245\202 \340\244\250\340\244\257\340\245\207\',\n    toolRules: \'UPI \340\244\232\340\245\207 \340\244\270\340\245\201\340\244\265\340\244\260\340\245\215\340\244\243 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    projectTitle: \'\340\244\252\340\245\215\340\244\260\340\244\225\340\244\262\340\245\215\340\244\252\340\244\276\340\244\254\340\244\246\340\245\215\340\244\246\340\244\262 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n    aboutInit: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\245\340\245\200\340\244\254\340\244\246\340\245\215\340\244\246\340\244\262\',\n    problemState: \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\234\340\244\277\340\244\225 \340\244\211\340\244\246\340\245\215\340\244\246\340\244\277\340\244\267\340\245\215\340\244\237 \340\244\265 CEP\',\n    batch: \'\340\244\254\340\245\200.\340\244\217\340\244\270\340\245\215\340\244\270\340\245\200. \340\244\225\340\245\211\340\244\256\340\245\215\340\244\252\340\245\215\340\244\257\340\245\201\340\244\237\340\244\260 \340\244\270\340\244\276\340\244\257\340\244\250\340\245\215\340\244\270 \340\244\211\340\244\252\340\244\225\340\245\215\340\244\260\340\244\256\',\n    openSourceTag: \'\340\244\256\340\245\213\340\244\253\340\244\244 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\256\340\244\202\340\244\232\',\n    callBtn: \'\340\245\247\340\245\257\340\245\251\340\245\246 \340\244\265\340\244\260 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\276\',\n    inclusion: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\245\207\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\265\340\244\277\340\244\225\340\244\270\340\244\277\340\244\244\',\n    noAffiliation: \'\340\244\270\340\245\215\340\244\265\340\244\244\340\244\202\340\244\244\340\245\215\340\244\260 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\211\340\244\252\340\244\225\340\245\215\340\244\260\340\244\256\',\n  },\n};\n\nexport const Footer: React.FC<FooterProps> = ({ setCurrentPage, language }) => {\n  const t = translations[language];\n  const f = footerLabels[language];\n\n  return (\n    <footer className=\"bg-[#1E293B] text-[#94A3B8] pt-14 pb-12 border-t border-[#334155]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Urgent Helpline Banner */}\n        <div className=\"bg-[#0F172A] border-2 border-red-500/40 rounded-xl p-6 mb-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-5 shadow-sm\">\n          <div className=\"flex items-start gap-4\">\n            <div className=\"p-3 bg-red-900/40 border border-red-500/50 text-red-400 rounded-lg shrink-0\">\n              <ShieldAlert className=\"w-7 h-7\" />\n            </div>\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <span className=\"text-white font-bold text-lg\">{t.footer.helplineAlertTitle}</span>\n                <span className=\"bg-red-500/20 text-red-300 text-xs font-bold px-2.5 py-0.5 rounded-full border border-red-500/40\">\n                  {t.footer.actFastBadge}\n                </span>\n              </div>\n              <p className=\"text-sm text-[#CBD5E1] mt-1.5 max-w-2xl leading-relaxed\">\n                {t.footer.helplineAlertDesc}\n              </p>\n            </div>\n          </div>\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0 w-full md:w-auto\">\n            <a\n              href=\"tel:1930\"\n              className=\"inline-flex items-center justify-center gap-2 px-5 py-3 bg-red-600 hover:bg-red-700 text-white font-bold text-base rounded-lg transition-colors w-full sm:w-auto shadow-sm\"\n            >\n              <PhoneCall className=\"w-5 h-5\" />\n              <span>{f.callBtn}</span>\n            </a>\n            <a\n              href=\"https://cybercrime.gov.in\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center justify-center gap-1.5 px-4 py-3 bg-[#334155] hover:bg-[#475569] text-white text-sm font-semibold rounded-lg transition-colors border border-[#475569] w-full sm:w-auto\"\n            >\n              <span>cybercrime.gov.in</span>\n              <ExternalLink className=\"w-4 h-4\" />\n            </a>\n          </div>\n        </div>\n\n        {/* 4 Clean Columns */}\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-[#334155]\">\n          {/* Col 1: Brand & Purpose */}\n          <div className=\"space-y-3 md:col-span-1\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-9 h-9 rounded-lg bg-[#0D5C58] text-white flex items-center justify-center font-bold text-sm\">\n                DS\n              </div>\n              <span className=\"text-white font-bold text-xl tracking-tight\">Digital Saathi</span>\n            </div>\n            <p className=\"text-sm text-[#F1F5F9] font-medium\">\n              \342\200\234{t.tagline}\342\200\235\n            </p>\n            <p className=\"text-xs text-[#94A3B8] leading-relaxed\">\n              {t.footer.aboutCep}\n            </p>\n            <div className=\"inline-flex items-center gap-2 text-xs text-[#E2E8F0] bg-[#0F172A] px-3 py-1.5 rounded-md border border-[#334155]\">\n              <CheckCircle2 className=\"w-3.5 h-3.5 text-[#0D5C58]\" />\n              <span>{f.openSourceTag}</span>\n            </div>\n          </div>\n\n          {/* Col 2: Learning Guides */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-4\">\n              {f.curriculumTitle}\n            </h4>\n            <ul className=\"space-y-3 text-sm\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'basics\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.mod1}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.mod2}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.mod3}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'services\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.mod4}\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 3: Interactive Practice */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-4\">\n              {f.practiceTitle}\n            </h4>\n            <ul className=\"space-y-3 text-sm\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'home\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.toolScam}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'quiz\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.toolQuiz}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.toolChecklist}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.toolRules}\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Project Info */}\n          <div>\n            <h4 className=\"text-white font-bold text-sm uppercase tracking-wider mb-4\">\n              {f.projectTitle}\n            </h4>\n            <ul className=\"space-y-3 text-sm\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.aboutInit}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors text-left\"\n                >\n                  {f.problemState}\n                </button>\n              </li>\n              <li>\n                <span className=\"text-[#64748B] block\">{f.batch}</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Disclaimer & Copyright */}\n        <div className=\"pt-8 space-y-3 text-xs text-[#94A3B8]\">\n          <p className=\"leading-relaxed text-[#64748B]\">\n            {t.footer.disclaimer}\n          </p>\n          <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 text-[#94A3B8]\">\n            <div>{t.footer.copyright}</div>\n            <div className=\"flex items-center gap-3\">\n              <span>{f.inclusion}</span>\n              <span>\342\200\242</span>\n              <span>{f.noAffiliation}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    }
