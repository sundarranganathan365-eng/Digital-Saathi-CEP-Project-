      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  BookOpen,\n  GitFork,\n  Heart,\n  Globe,\n  ShieldCheck,\n  Code2,\n  ExternalLink,\n  Users,\n  Target,\n  FileCode2,\n} from \'lucide-react\';\n\ninterface AboutPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const AboutPage: React.FC<AboutPageProps> = ({ setCurrentPage, language }) => {\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Project Overview\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">3rd Year BSc CS CEP</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          About Digital Saathi\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          An open-source digital literacy and safety initiative developed for a Community Engagement Project under the theme: <em className=\"font-medium text-[#171717]\">\342\200\234Building Open-Source Solutions for Social Problems.\342\200\235</em>\n        </p>\n      </div>\n\n      {/* 1. Core Manifesto & Social Problem */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        <div className=\"lg:col-span-7 space-y-6\">\n          <div>\n            <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-1\">\n              The Challenge\n            </span>\n            <h2 className=\"text-2xl sm:text-3xl font-bold text-[#171717] font-editorial\">\n              The Digital Divide & Vulnerability in Modern India\n            </h2>\n          </div>\n\n          <p className=\"text-sm sm:text-base text-[#525252] leading-relaxed\">\n            As smartphones and UPI payments rapidly replace traditional physical counters, millions of senior citizens, first-time mobile owners, and non-technical citizens are pushed into a complex digital ecosystem without foundational training.\n          </p>\n\n          <p className=\"text-sm sm:text-base text-[#525252] leading-relaxed\">\n            This knowledge gap creates critical social vulnerabilities:\n          </p>\n\n          <div className=\"space-y-3 pt-1\">\n            <div className=\"p-4 border border-[#E5E5E5] bg-white rounded flex items-start gap-3\">\n              <span className=\"w-6 h-6 rounded bg-[#F5F5F4] border border-[#E5E5E5] flex items-center justify-center text-xs font-bold shrink-0\">1</span>\n              <div>\n                <strong className=\"text-xs sm:text-sm text-[#171717] block\">Loss of Daily Independence:</strong>\n                <span className=\"text-xs text-[#525252]\">Constant reliance on children, neighbors, or third-party agents for simple tasks like bill payments, recharge, or booking tickets.</span>\n              </div>\n            </div>\n\n            <div className=\"p-4 border border-[#E5E5E5] bg-white rounded flex items-start gap-3\">\n              <span className=\"w-6 h-6 rounded bg-[#F5F5F4] border border-[#E5E5E5] flex items-center justify-center text-xs font-bold shrink-0\">2</span>\n              <div>\n                <strong className=\"text-xs sm:text-sm text-[#171717] block\">Severe Cyber Fraud Vulnerability:</strong>\n                <span className=\"text-xs text-[#525252]\">Inability to spot deceptive KYC messages, fake customer care numbers, or urgency-driven payment collect requests.</span>\n              </div>\n            </div>\n\n            <div className=\"p-4 border border-[#E5E5E5] bg-white rounded flex items-start gap-3\">\n              <span className=\"w-6 h-6 rounded bg-[#F5F5F4] border border-[#E5E5E5] flex items-center justify-center text-xs font-bold shrink-0\">3</span>\n              <div>\n                <strong className=\"text-xs sm:text-sm text-[#171717] block\">Technology Anxiety & Fear:</strong>\n                <span className=\"text-xs text-[#525252]\">Fear of pressing the \"wrong button\" and accidentally losing money or corrupting device software.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Project Principles & Architecture Box */}\n        <div className=\"lg:col-span-5 p-6 sm:p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-6\">\n          <div className=\"flex items-center gap-2\">\n            <Target className=\"w-5 h-5 text-[#171717]\" />\n            <h3 className=\"text-lg font-bold text-[#171717]\">Our Educational Objective</h3>\n          </div>\n\n          <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n            Digital Saathi was engineered to strip away all technical jargon, dark patterns, and complex abstractions, presenting pure practical knowledge in large, high-contrast typography.\n          </p>\n\n          <div className=\"pt-4 border-t border-[#E5E5E5] space-y-3 text-xs text-[#404040]\">\n            <div className=\"flex items-center justify-between py-1.5 border-b border-[#F0F0EE]\">\n              <span className=\"text-[#737373]\">Academic Scope</span>\n              <span className=\"font-semibold text-[#171717]\">3rd Year BSc CS CEP</span>\n            </div>\n            <div className=\"flex items-center justify-between py-1.5 border-b border-[#F0F0EE]\">\n              <span className=\"text-[#737373]\">License</span>\n              <span className=\"font-semibold text-[#171717]\">MIT Open-Source License</span>\n            </div>\n            <div className=\"flex items-center justify-between py-1.5 border-b border-[#F0F0EE]\">\n              <span className=\"text-[#737373]\">Target Audience</span>\n              <span className=\"font-semibold text-[#171717]\">Elderly & First-Time Users</span>\n            </div>\n            <div className=\"flex items-center justify-between py-1.5\">\n              <span className=\"text-[#737373]\">Core Technology</span>\n              <span className=\"font-semibold text-[#171717]\">HTML5 \342\200\242 CSS \342\200\242 TypeScript</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. Open Source Vision & Contributing */}\n      <section className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-10 space-y-6\">\n        <div className=\"max-w-2xl\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <GitFork className=\"w-5 h-5 text-[#171717]\" />\n            <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373]\">\n              Community Contributions\n            </span>\n          </div>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            Open-Source Architecture & Future Roadmap\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#525252] mt-1 leading-relaxed\">\n            As an open-source educational blueprint, Digital Saathi is structured so students, civic organizations, and local volunteers can expand the platform:\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2\">\n          <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n            <strong className=\"text-xs sm:text-sm font-bold text-[#171717] block mb-1\">1. Regional Languages</strong>\n            <p className=\"text-xs text-[#525252]\">Translating modules into Tamil, Telugu, Bengali, Gujarati, Kannada, and Punjabi.</p>\n          </div>\n\n          <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n            <strong className=\"text-xs sm:text-sm font-bold text-[#171717] block mb-1\">2. Localized Scam Cases</strong>\n            <p className=\"text-xs text-[#525252]\">Adding real-world scam case studies from local police advisories.</p>\n          </div>\n\n          <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n            <strong className=\"text-xs sm:text-sm font-bold text-[#171717] block mb-1\">3. Offline PDF Printables</strong>\n            <p className=\"text-xs text-[#525252]\">Generating printable physical pamphlets for community centers and senior citizen clubs.</p>\n          </div>\n\n          <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n            <strong className=\"text-xs sm:text-sm font-bold text-[#171717] block mb-1\">4. Accessibility Enhancements</strong>\n            <p className=\"text-xs text-[#525252]\">Text-to-speech audio guidance for low-vision and non-literate learners.</p>\n          </div>\n        </div>\n\n        {/* GitHub Link Placeholder */}\n        <div className=\"pt-6 border-t border-[#E5E5E5] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <FileCode2 className=\"w-5 h-5 text-[#737373]\" />\n            <span className=\"text-xs sm:text-sm text-[#525252]\">\n              Explore codebase, documentation, and contribute on GitHub:\n            </span>\n          </div>\n\n          <a\n            id=\"about-github-link\"\n            href=\"https://github.com/digital-saathi/digital-saathi\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors shadow-xs\"\n          >\n            <GitFork className=\"w-3.5 h-3.5\" />\n            <span>View Project on GitHub</span>\n            <ExternalLink className=\"w-3 h-3 text-[#A3A3A3]\" />\n          </a>\n        </div>\n      </section>\n\n      {/* 3. Academic CEP Acknowledgments */}\n      <section className=\"p-6 sm:p-8 border border-[#E5E5E5] bg-[#FAF9F6] rounded-sm space-y-3\">\n        <h3 className=\"text-base font-bold text-[#171717]\">\n          Academic CEP Context & Scope\n        </h3>\n        <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n          This project strictly adheres to academic guidelines for non-commercial social intervention. It requires zero server database infrastructure, collects zero personal user credentials, and functions as an accessible, purely client-side public awareness utility.\n        </p>\n      </section>\n    </div>\n  );\n};\n"
    }
