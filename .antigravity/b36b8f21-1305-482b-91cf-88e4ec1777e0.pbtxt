    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  BookOpen,\n  Users,\n  Code2,\n  ShieldCheck,\n  Heart,\n  ExternalLink,\n  GraduationCap,\n  Sparkles,\n} from \'lucide-react\';\n\ninterface AboutPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst aboutContent = {\n  en: {\n    tag: \'Academic Initiative\',\n    title: \'About Digital Saathi\',\n    subtitle: \'An open-source educational platform created as a 3rd-Year BSc Computer Science Community Engagement Project (CEP) on the theme: \342\200\234Building Open-Source Solutions for Social Problems.\342\200\235\',\n    missionTitle: \'Our Mission & Motivation\',\n    missionDesc: \'India\342\200\231s rapid digital transformation has revolutionized banking, governance, and daily communication. However, millions of senior citizens, parents, and first-time internet adopters face acute anxiety, digital exclusion, and vulnerability to financial fraud. Digital Saathi bridges this gap through dignified, jargon-free education.\',\n    pillars: [\n      {\n        icon: Users,\n        title: \'Target Audience\',\n        desc: \'Designed especially for senior citizens, rural internet adopters, and anyone who feels intimidated by digital technologies.\',\n      },\n      {\n        icon: ShieldCheck,\n        title: \'Safety by Design\',\n        desc: \'Focuses heavily on scam identification, OTP confidentiality, and UPI PIN rules to safeguard life savings.\',\n      },\n      {\n        icon: Code2,\n        title: \'Open Source Initiative\',\n        desc: \'Free to use, share, and translate under the MIT License for public digital literacy workshops and non-profit education.\',\n      },\n    ],\n    themeTitle: \'CEP Project Information\',\n    themeInfo: [\n      { label: \'Theme:\', val: \'Building Open-Source Solutions for Social Problems\' },\n      { label: \'Degree & Program:\', val: \'3rd-Year B.Sc. Computer Science (CEP)\' },\n      { label: \'Platform Type:\', val: \'Client-Side Educational Awareness Resource\' },\n      { label: \'License:\', val: \'Open-Source (MIT License)\' },\n    ],\n    disclaimerTitle: \'Non-Commercial Disclaimer\',\n    disclaimerDesc: \'Digital Saathi is strictly an independent academic and social awareness initiative. It does not collect user bank details, passwords, or personal credentials. It is not affiliated with any bank, commercial financial company, or government agency.\',\n  },\n  hi: {\n    tag: \'\340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\252\340\244\271\340\244\262\',\n    title: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\245\340\245\200 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\260\340\245\207 \340\244\256\340\245\207\340\244\202\',\n    subtitle: \'\340\244\244\340\245\203\340\244\244\340\245\200\340\244\257 \340\244\265\340\244\260\340\245\215\340\244\267 \340\244\254\340\245\200\340\244\217\340\244\270\340\244\270\340\245\200 \340\244\225\340\244\202\340\244\252\340\245\215\340\244\257\340\245\202\340\244\237\340\244\260 \340\244\270\340\244\276\340\244\207\340\244\202\340\244\270 \340\244\270\340\244\276\340\244\256\340\245\201\340\244\246\340\244\276\340\244\257\340\244\277\340\244\225 \340\244\270\340\244\271\340\244\255\340\244\276\340\244\227\340\244\277\340\244\244\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\257\340\245\213\340\244\234\340\244\250\340\244\276 (CEP) \342\200\224 \342\200\234\340\244\270\340\244\276\340\244\256\340\244\276\340\244\234\340\244\277\340\244\225 \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276\340\244\223\340\244\202 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\223\340\244\252\340\244\250-\340\244\270\340\245\213\340\244\260\340\245\215\340\244\270 \340\244\270\340\244\256\340\244\276\3