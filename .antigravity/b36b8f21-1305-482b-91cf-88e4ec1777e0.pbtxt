  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { PageId, Language, TextSize } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { Menu, X, Search, ArrowRight, ShieldCheck, Globe } from \'lucide-react\';\n\ninterface NavbarProps {\n  currentPage: PageId;\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n  setLanguage: (lang: Language) => void;\n  textSize: TextSize;\n  setTextSize: (size: TextSize) => void;\n  onOpenSearch: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentPage,\n  setCurrentPage,\n  language,\n  setLanguage,\n  textSize,\n  setTextSize,\n  onOpenSearch,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const t = translations[language];\n\n  const navItems: { id: PageId; label: string; num: string }[] = [\n    { id: \'home\', label: t.nav.home, num: \'00\' },\n    { id: \'basics\', label: t.nav.basics, num: \'01\' },\n    { id: \'payments\', label: t.nav.payments, num: \'02\' },\n    { id: \'safety\', label: t.nav.safety, num: \'03\' },\n    { id: \'services\', label: t.nav.services, num: \'04\' },\n    { id: \'quiz\', label: t.nav.quiz, num: \'05\' },\n    { id: \'about\', label: t.nav.about, num: \'06\' },\n  ];\n\n  const handleNavClick = (page: PageId) => {\n    setCurrentPage(page);\n    setMobileMenuOpen(false);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#FAF9F6]/90 backdrop-blur-md border-b border-[#E5E5E5] transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-18\">\n          {/* Logo / Title */}\n          <button\n            id=\"nav-logo-btn\"\n            onClick={() => handleNavClick(\'home\')}\n            className=\"flex items-center gap-3 text-left group focus:outline-none\"\n          >\n            <div className=\"w-8 h-8 rounded-sm bg-[#171717] text-white flex items-center justify-center font-bold text-sm tracking-tight transition-transform group-hover:scale-105\">\n              DS\n            </div>\n            <div>\n              <span className=\"font-semibold text-lg tracking-tight text-[#171717] block leading-none\">\n                Digital Saathi\n              </span>\n              <span className=\"text-[11px] text-[#737373] tracking-wide block mt-1 uppercase font-medium\">\n                Public Digital Literacy\n              </span>\n            </div>\n          </button>\n\n          {/* Desktop Nav Links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2\">\n            {navItems.map((item) => {\n              const isActive = currentPage === item.id;\n              return (\n                <button\n                  key={item.id}\n                  id={`nav-link-${item.id}`}\n                  onClick={() => handleNavClick(item.id)}\n                  className={`px-3 py-2 text-sm font-medium tracking-normal transition-all relative ${\n                    isActive\n                      ? \'text-[#171717] font-semibold\'\n                      : \'text-[#525252] hover:text-[#171717]\'\n                  }`}\n                >\n                  <span>{item.label}</span>\n                  {isActive && (\n                    <span className=\"absolute bottom-0 left-3 right-3 h-[2px] bg-[#171717] rounded-full\" />\n                  )}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Right Controls: Text Size, Language, Search, Primary CTA */}\n          <div className=\"hidden sm:flex items-center gap-3\">\n            {/* Search Trigger */}\n            <button\n              id=\"search-open-btn\"\n              onClick={onOpenSearch}\n              className=\"flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-[#525252] hover:text-[#171717] border border-[#E5E5E5] hover:border-[#A3A3A3] rounded bg-white transition-all shadow-xs\"\n              title=\"Search topics (UPI, OTP, DigiLocker...)\"\n            >\n              <Search className=\"w-3.5 h-3.5 text-[#737373]\" />\n              <span className=\"font-medium\">Search</span>\n              <kbd className=\"text-[10px] text-[#A3A3A3] bg-[#F5F5F4] px-1 py-0.5 rounded border border-[#E5E5E5]\">\342\214\230K</kbd>\n            </button>\n\n            {/* Accessible Text Size Control */}\n            <div className=\"flex items-center border border-[#E5E5E5] rounded bg-white p-0.5 shadow-xs\" title=\"Text Size\">\n              <button\n                id=\"btn-text-size-normal\"\n                onClick={() => setTextSize(\'normal\')}\n                className={`px-2 py-1 text-xs font-semibold rounded transition-all ${\n                  textSize === \'normal\'\n                    ? \'bg-[#171717] text-white\'\n                    : \'text-[#525252] hover:text-[#171717]\'\n                }`}\n              >\n                A\n              </button>\n              <button\n                id=\"btn-text-size-large\"\n                onClick={() => setTextSize(\'large\')}\n                className={`px-2 py-1 text-sm font-semibold rounded transition-all ${\n                  textSize === \'large\'\n                    ? \'bg-[#171717] text-white\'\n                    : \'text-[#525252] hover:text-[#171717]\'\n                }`}\n              >\n                A+\n              </button>\n              <button\n                id=\"btn-text-size-extralarge\"\n                onClick={() => setTextSize(\'extra-large\')}\n                className={`px-2 py-1 text-base font-bold rounded transition-all ${\n                  textSize === \'extra-large\'\n                    ? \'bg-[#171717] text-white\'\n                    : \'text-[#525252] hover:text-[#171717]\'\n                }`}\n              >\n                A++\n              </button>\n            </div>\n\n            {/* Language Selector */}\n            <div className=\"flex items-center border border-[#E5E5E5] rounded bg-white p-0.5 shadow-xs\">\n              <Globe className=\"w-3 h-3 text-[#737373] ml-1.5 mr-0.5\" />\n              {([\'en\', \'hi\', \'mr\'] as Language[]).map((lang) => (\n                <button\n                  key={lang}\n                  id={`lang-btn-${lang}`}\n                  onClick={() => setLanguage(lang)}\n                  className={`px-2 py-1 text-xs font-medium rounded transition-all uppercase ${\n                    language === lang\n                      ? \'bg-[#171717] text-white font-semibold\'\n                      : \'text-[#525252] hover:text-[#171717]\'\n                  }`}\n                >\n                  {lang}\n                </button>\n              ))}\n            </div>\n\n            {/* Primary CTA */}\n            <button\n              id=\"nav-cta-start\"\n              onClick={() => handleNavClick(currentPage === \'basics\' ? \'payments\' : \'basics\')}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-[#171717] hover:bg-[#333333] active:bg-black rounded transition-all shadow-xs\"\n            >\n              <span>{t.nav.startLearning}</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          {/* Mobile Menu Button */}\n          <div className=\"flex sm:hidden items-center gap-2\">\n            <button\n              id=\"mobile-search-btn\"\n              onClick={onOpenSearch}\n              className=\"p-2 text-[#525252] border border-[#E5E5E5] rounded bg-white\"\n              aria-label=\"Search\"\n            >\n              <Search className=\"w-4 h-4\" />\n            </button>\n            <button\n              id=\"mobile-menu-toggle\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 text-[#171717] border border-[#E5E5E5] rounded bg-white focus:outline-none\"\n              aria-label=\"Toggle menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"sm:hidden bg-[#FAF9F6] border-b border-[#E5E5E5] px-4 pt-3 pb-6 animate-in fade-in duration-200\">\n          <div className=\"flex items-center justify-between py-2 mb-3 border-b border-[#E5E5E5]\">\n            <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373]\">Accessibility & Language</span>\n            <div className=\"flex items-center gap-2\">\n              <div className=\"flex border border-[#E5E5E5] rounded bg-white p-0.5\">\n                <button\n                  onClick={() => setTextSize(\'normal\')}\n                  className={`px-2 py-0.5 text-xs font-semibold ${textSize === \'normal\' ? \'bg-[#171717] text-white\' : \'text-[#525252]\'}`}\n                >\n                  A\n                </button>\n                <button\n                  onClick={() => setTextSize(\'large\')}\n                  className={`px-2 py-0.5 text-xs font-semibold ${textSize === \'large\' ? \'bg-[#171717] text-white\' : \'text-[#525252]\'}`}\n                >\n                  A+\n                </button>\n                <button\n                  onClick={() => setTextSize(\'extra-large\')}\n                  className={`px-2 py-0.5 text-xs font-bold ${textSize === \'extra-large\' ? \'bg-[#171717] text-white\' : \'text-[#525252]\'}`}\n                >\n                  A++\n                </button>\n              </div>\n\n              <div className=\"flex border border-[#E5E5E5] rounded bg-white p-0.5\">\n                {([\'en\', \'hi\', \'mr\'] as Language[]).map((lang) => (\n                  <button\n                    key={lang}\n                    onClick={() => setLanguage(lang)}\n                    className={`px-2 py-0.5 text-xs uppercase ${language === lang ? \'bg-[#171717] text-white font-bold\' : \'text-[#525252]\'}`}\n                  >\n                    {lang}\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>"
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { Menu, X, Search, ArrowRight, ShieldCheck, Globe } from \'lucide-react\';\n\ninterface NavbarProps {\n  currentPage: PageId;\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n  setLanguage: (lang: Language) => void;\n  onOpenSearch: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentPage,\n  setCurrentPage,\n  language,\n  setLanguage,\n  onOpenSearch,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const t = translations[language];\n\n  const navItems: { id: PageId; label: string; num: string }[] = [\n    { id: \'home\', label: t.nav.home, num: \'00\' },\n    { id: \'basics\', label: t.nav.basics, num: \'01\' },\n    { id: \'payments\', label: t.nav.payments, num: \'02\' },\n    { id: \'safety\', label: t.nav.safety, num: \'03\' },\n    { id: \'services\', label: t.nav.services, num: \'04\' },\n    { id: \'quiz\', label: t.nav.quiz, num: \'05\' },\n    { id: \'about\', label: t.nav.about, num: \'06\' },\n  ];\n\n  const handleNavClick = (page: PageId) => {\n    setCurrentPage(page);\n    setMobileMenuOpen(false);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#FAF9F6]/90 backdrop-blur-md border-b border-[#E5E5E5] transition-all\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-18\">\n          {/* Logo / Title */}\n          <button\n            id=\"nav-logo-btn\"\n            onClick={() => handleNavClick(\'home\')}\n            className=\"flex items-center gap-3 text-left group focus:outline-none\"\n          >\n            <div className=\"w-8 h-8 rounded-sm bg-[#171717] text-white flex items-center justify-center font-bold text-sm tracking-tight transition-transform group-hover:scale-105\">\n              DS\n            </div>\n            <div>\n              <span className=\"font-semibold text-lg tracking-tight text-[#171717] block leading-none\">\n                Digital Saathi\n              </span>\n              <span className=\"text-[11px] text-[#737373] tracking-wide block mt-1 uppercase font-medium\">\n                Public Digital Literacy\n              </span>\n            </div>\n          </button>\n\n          {/* Desktop Nav Links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2\">\n            {navItems.map((item) => {\n              const isActive = currentPage === item.id;\n              return (\n                <button\n                  key={item.id}\n                  id={`nav-link-${item.id}`}\n                  onClick={() => handleNavClick(item.id)}\n                  className={`px-3 py-2 text-sm font-medium tracking-normal transition-all relative ${\n                    isActive\n                      ? \'text-[#171717] font-semibold\'\n                      : \'text-[#525252] hover:text-[#171717]\'\n                  }`}\n                >\n                  <span>{item.label}</span>\n                  {isActive && (\n                    <span className=\"absolute bottom-0 left-3 right-3 h-[2px] bg-[#171717] rounded-full\" />\n                  )}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Right Controls: Search, Language, Primary CTA */}\n          <div className=\"hidden sm:flex items-center gap-3\">\n            {/* Search Trigger */}\n            <button\n              id=\"search-open-btn\"\n              onClick={onOpenSearch}\n              className=\"flex items-center gap-1.5 px-2.5 py-1.5 text-xs text-[#525252] hover:text-[#171717] border border-[#E5E5E5] hover:border-[#A3A3A3] rounded bg-white transition-all shadow-xs\"\n              title=\"Search topics (UPI, OTP, DigiLocker...)\"\n            >\n              <Search className=\"w-3.5 h-3.5 text-[#737373]\" />\n              <span className=\"font-medium\">Search</span>\n              <kbd className=\"text-[10px] text-[#A3A3A3] bg-[#F5F5F4] px-1 py-0.5 rounded border border-[#E5E5E5]\">\342\214\230K</kbd>\n            </button>\n\n            {/* Language Selector */}\n            <div className=\"flex items-center border border-[#E5E5E5] rounded bg-white p-0.5 shadow-xs\">\n              <Globe className=\"w-3 h-3 text-[#737373] ml-1.5 mr-0.5\" />\n              {([\'en\', \'hi\', \'mr\'] as Language[]).map((lang) => (\n                <button\n                  key={lang}\n                  id={`lang-btn-${lang}`}\n                  onClick={() => setLanguage(lang)}\n                  className={`px-2 py-1 text-xs font-medium rounded transition-all uppercase ${\n                    language === lang\n                      ? \'bg-[#171717] text-white font-semibold\'\n                      : \'text-[#525252] hover:text-[#171717]\'\n                  }`}\n                >\n                  {lang}\n                </button>\n              ))}\n            </div>\n\n            {/* Primary CTA */}\n            <button\n              id=\"nav-cta-start\"\n              onClick={() => handleNavClick(currentPage === \'basics\' ? \'payments\' : \'basics\')}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-[#171717] hover:bg-[#333333] active:bg-black rounded transition-all shadow-xs\"\n            >\n              <span>{t.nav.startLearning}</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n          {/* Mobile Menu Button */}\n          <div className=\"flex sm:hidden items-center gap-2\">\n            <button\n              id=\"mobile-search-btn\"\n              onClick={onOpenSearch}\n              className=\"p-2 text-[#525252] border border-[#E5E5E5] rounded bg-white\"\n              aria-label=\"Search\"\n            >\n              <Search className=\"w-4 h-4\" />\n            </button>\n            <button\n              id=\"mobile-menu-toggle\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 text-[#171717] border border-[#E5E5E5] rounded bg-white focus:outline-none\"\n              aria-label=\"Toggle menu\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"sm:hidden bg-[#FAF9F6] border-b border-[#E5E5E5] px-4 pt-3 pb-6 animate-in fade-in duration-200\">\n          <div className=\"flex items-center justify-between py-2 mb-3 border-b border-[#E5E5E5]\">\n            <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373]\">Language</span>\n            <div className=\"flex border border-[#E5E5E5] rounded bg-white p-0.5\">\n              {([\'en\', \'hi\', \'mr\'] as Language[]).map((lang) => (\n                <button\n                  key={lang}\n                  onClick={() => setLanguage(lang)}\n                  className={`px-2.5 py-1 text-xs uppercase ${language === lang ? \'bg-[#171717] text-white font-bold\' : \'text-[#525252]\'}`}\n                >\n                  {lang}\n                </button>\n              ))}\n            </div>\n          </div>"
    }
