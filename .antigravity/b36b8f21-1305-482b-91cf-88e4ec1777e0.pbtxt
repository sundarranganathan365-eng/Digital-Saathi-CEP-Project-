      replacement_content: "import { ScamScenario } from \'../types\';\n\nexport const scamScenarios: ScamScenario[] = [\n  {\n    id: \'scam-kyc\',\n    sender: \'VM-SBIN-ALERT\',\n    channel: \'SMS\',\n    message: \'URGENT! Dear Customer, your SBI Bank account will be blocked today due to pending KYC. Click immediately to update documents: http://sbi-kyc-verify.xyz/login.php\',\n    isScam: true,\n    type: \'Bank KYC Phishing Scam\',\n    redFlags: [\n      \'Creates extreme false urgency (\"will be blocked today\")\',\n      \'Uses fear tactics to force quick action without thinking\',\n      \'Suspicious web link (ends with .xyz instead of official onlinesbi.sbi or sbi.co.in)\',\n      \'Real banks never threaten to block accounts via random SMS links\',\n    ],\n    explanation: \'This is a classic KYC phishing scam. Scammers create fake bank login pages to steal your username, password, and OTP. Banks never ask you to update KYC by clicking SMS links.\',\n    safetyTip: \'Always visit your bank branch directly or type the official bank website URL into your browser manually.\',\n  },\n  {\n    id: \'scam-electricity\',\n    sender: \'+91 98765 43210 (Unknown Mobile)\',\n    channel: \'WhatsApp\',\n    message: \'Dear Consumer, Your Electricity power will be disconnected tonight at 9:30 PM from the main sub-station because your previous month bill was not updated. Immediately contact Electricity Officer Mr. Verma at 9876543210 to prevent disconnection.\',\n    isScam: true,\n    type: \'Electricity Bill Disconnection Fraud\',\n    redFlags: [\n      \'Sent from an ordinary personal mobile number instead of an official utility SMS header (e.g. MSEDCL, BSES, TNEB)\',\n      \'Threatens imminent power cutoff within hours to induce panic\',\n      \'Asks you to call a personal phone number or install an APK file (like AnyDesk / TeamViewer)\',\n    ],\n    explanation: \'Scammers send mass messages about electricity disconnections. When you call, they ask you to pay \342\202\27110 via a malicious link or install screen-sharing apps to drain your bank account.\',\n    safetyTip: \'Always check your actual bill status on your official state electricity board portal, mobile app, or through your physical paper receipt.\',\n  },\n  {\n    id: \'legit-bank-alert\',\n    sender: \'AX-HDFCBK\',\n    channel: \'SMS\',\n    message: \'Rs. 450.00 debited from A/c **4102 on 28-Aug-26 at LOCAL GROCERY STORE. Bal: Rs. 14,250.00. Not you? SMS BLOCK to 567678 or call 1800-266-4332.\',\n    isScam: false,\n    type: \'Legitimate Bank Transaction Alert\',\n    redFlags: [],\n    explanation: \'This is a genuine transaction confirmation from your bank. Notice that it does NOT ask you to click any weird web links, does NOT ask for your PIN, and provides verified official toll-free helpline numbers.\',\n    safetyTip: \'Genuine bank SMS will state the exact masked account digits (**4102) and provide a verifiable helpline for disputed charges without forcing you to click an unverified link.\',\n  },\n  {\n    id: \'scam-job-telegram\',\n    sender: \'HR_Sneha_Global\',\n    channel: \'WhatsApp\',\n    message: \'Congratulations! Your resume was shortlisted for Part-Time Google Maps Reviewer. Earn Rs. 3,000 to Rs. 8,000 daily by just rating 5 hotels. No experience required. Join Telegram channel t.me/easy_daily_earn to start receiving your money right now!\',\n    isScam: true,\n    type: \'Part-Time Task / Telegram Job Scam\',\n    redFlags: [\n      \'Unsolicited job offer for a role you never applied for\',\n      \'Promises unrealistic easy money for minimal trivial tasks\',\n      \'Directs you to Telegram or WhatsApp groups\',\n      \'Will soon demand \"recharge\" or \"prepaid security deposits\" to withdraw profits\',\n    ],\n    explanation: \'This is a task/rating scam. Fraudsters initially pay tiny amounts (like \342\202\271150) to build false trust, then demand thousands of rupees as \"investments\" or \"taxes\" before disappearing with your money.\',\n    safetyTip: \'Legitimate companies never hire via random WhatsApp messages and never ask you to pay money to get a job.\',\n  },\n  {\n    id: \'scam-lottery-kbc\',\n    sender: \'KBC Lucky Draw Head Office\',\n    channel: \'WhatsApp\',\n    message: \'Dear Customer, your WhatsApp number has won a Lucky Draw Prize of Rs. 25,00,000 from KBC! To claim your cash prize, pay Rs. 12,500 government registration fee to State Bank officer WhatsApp number immediately.\',\n    isScam: true,\n    type: \'Lottery & Prize Advance-Fee Scam\',\n    redFlags: [\n      \'Winning a lottery or contest you never purchased a ticket for\',\n      \'Demanding upfront \"tax\", \"processing fee\", or \"registration charge\"\',\n      \'Using fake official logos and audio clips of famous TV personalities\',\n    ],\n    explanation: \'You cannot win a lottery that you never entered. Real lotteries do not ask you to deposit advance fees into personal UPI accounts to release prize money.\',\n    safetyTip: \'Never send money to receive a prize. If someone says you won money but must pay first, it is 100% a scam.\',\n  },\n];\n"
