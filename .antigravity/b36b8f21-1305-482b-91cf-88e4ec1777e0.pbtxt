        lines {
          text: "      id: \'phishing\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      title: \'Phishing & Fake SMS Links\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      icon: <Link2 className=\"w-4 h-4\" />,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      definition: \'Phishing is when scammers send fake SMS or emails that look like legitimate organizations (like SBI, HDFC, or Electricity Boards) to lure you into clicking malicious websites.\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      warningSigns: ["
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        \'Uses alarming language: \"Account blocked today\", \"Power cutoff in 2 hours\", \"KYC expired\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        \'Contains weird link endings: .xyz, .top, .live, .cc instead of official domain names.\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        \'Urges you to immediately enter your net banking username, password, or debit card CVV.\',"
