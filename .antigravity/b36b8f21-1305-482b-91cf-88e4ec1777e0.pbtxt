        }
        lines {
          text: "      tag: \'Official Store\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Only Install from Google Play Store / Apple App Store\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'Official app stores screen applications for malware and viruses. Installing APK files from websites or WhatsApp bypasses all security defenses.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
