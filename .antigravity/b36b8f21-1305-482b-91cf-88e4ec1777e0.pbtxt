        lines {
          text: "      \'Never laminate or carry original Aadhaar cards everywhere when DigiLocker is accepted.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never pay money on third-party unofficial websites claiming to \"fast-track\" PAN or Aadhaar corrections.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never enter your Aadhaar number or OTP into random Google Forms or WhatsApp links.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never trust sponsored search ads offering government subsidy schemes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
