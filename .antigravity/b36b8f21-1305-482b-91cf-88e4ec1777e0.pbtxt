        lines {
          text: "    question: \'What is DigiLocker, and why is it useful?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionHi: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 (DigiLocker) \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210 \340\244\224\340\244\260 \340\244\257\340\244\271 \340\244\225\340\245\215\340\244\257\340\245\213\340\244\202 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227\340\245\200 \340\244\271\340\245\210?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionMr: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 (DigiLocker) \340\244\225\340\244\276\340\244\257 \340\244\206\340\244\271\340\245\207 \340\244\206\340\244\243\340\244\277 \340\244\244\340\245\215\340\244\257\340\244\276\340\244\232\340\244\276 \340\244\225\340\244\276\340\244\257 \340\244\253\340\244\276\340\244\257\340\244\246\340\244\276 \340\244\206\340\244\271\340\245\207?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'A private mobile game to store points\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'A government platform to securely store and share legally valid digital documents\', isCorrect: true },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'An online shopping store for physical lockers and safes\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'A social media app for chatting\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'DigiLocker is an initiative by the Ministry of Electronics & IT (Govt. of India) to provide cloud-based access to authentic digital documents (Aadhaar, Driving License, Vehicle RC, Education Certificates) that are legally recognized under IT Act 2000.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
