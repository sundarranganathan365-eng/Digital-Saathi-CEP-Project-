0\244\276 \340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\244\237\340\245\213\340\244\262-\340\244\253\340\245\215\340\244\260\340\245\200 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\253\340\245\213\340\244\250\340\244\256\340\244\247\340\245\215\340\244\257\340\245\207 \340\244\270\340\245\207\340\244\265\340\245\215\340\244\271 \340\244\225\340\244\260\340\245\202\340\244\250 \340\244\240\340\245\207\340\244\265\340\244\276.\',\n      \'\340\244\270\340\244\202\340\244\266\340\244\257\340\244\276\340\244\270\340\245\215\340\244\252\340\244\246 SMS \340\244\253\340\245\213\340\244\250\340\244\256\340\244\247\340\245\215\340\244\257\340\245\207 \340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\206\340\244\243\340\244\277 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\225\340\244\260\340\244\276.\',\n    ],\n    donts: [\n      \'\340\244\253\340\245\213\340\244\250\340\244\265\340\244\260 \340\244\225\340\245\213\340\244\243\340\244\276\340\244\262\340\244\276\340\244\271\340\245\200 \340\244\270\340\245\215\340\244\265\340\244\244\340\244\203\340\244\232\340\244\276 OTP \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 CVV \340\244\270\340\244\276\340\244\202\340\244\227\340\245\202 \340\244\250\340\244\225\340\244\276.\',\n      \'\340\244\227\340\245\201\340\244\227\340\244\262 \340\244\207\340\244\256\340\245\207\340\244\234 \340\244\270\340\244\260\340\245\215\340\244\232\340\244\265\340\244\260\340\245\202\340\244\250 \340\244\225\340\244\247\340\245\200\340\244\271\340\245\200 \340\244\225\340\244\270\340\245\215\340\244\237\340\244\256\340\244\260 \340\244\225\340\245\207\340\244\205\340\244\260 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\266\340\245\213\340\244\247\340\245\202 \340\244\250\340\244\225\340\244\276.\',\n      \'\340\244\262\340\245\211\340\244\237\340\244\260\340\245\200 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\254\340\244\225\340\245\215\340\244\267\340\245\200\340\244\270 \340\244\256\340\244\277\340\244\263\340\244\265\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\225\340\245\213\340\244\243\340\244\276\340\244\262\340\244\276\340\244\271\340\245\200 \340\245\262\340\244\241\340\244\265\340\245\215\340\244\271\340\244\276\340\244\250\340\245\215\340\244\270 \340\244\252\340\245\210\340\244\270\340\245\207 \340\244\252\340\244\276\340\244\240\340\244\265\340\245\202 \340\244\250\340\244\225\340\244\276.\',\n      \'\340\244\225\340\245\213\340\244\243\340\244\276\340\244\232\340\245\215\340\244\257\340\244\276\340\244\271\340\245\200 \340\244\270\340\244\276\340\244\202\340\244\227\340\244\243\340\245\215\340\244\257\340\244\276\340\244\265\340\244\260\340\245\202\340\244\250 AnyDesk \340\244\270\340\244\276\340\244\260\340\244\226\340\245\207 \340\244\270\340\245\215\340\244\225\340\245\215\340\244\260\340\245\200\340\244\250 \340\244\266\340\245\207\340\244\205\340\244\260\340\244\277\340\244\202\340\244\227 \340\245\262\340\244\252 \340\244\207\340\244\250\340\245\215\340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 \340\244\225\340\244\260\340\245\202 \340\244\250\340\244\225\340\244\276.\',\n    ],\n    nextCta: \'\340\244\252\340\245\201\340\244\242\340\245\200\340\244\262 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262: \340\244\266\340\244\276\340\244\270\340\244\225\340\245\200\340\244\257 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276 (\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260)\',\n  },\n};\n\nexport const SafetyPage: React.FC<SafetyPageProps> = ({ setCurrentPage, language }) => {\n  const s = safetyContent[language];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            {s.moduleTag}\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">{s.categoryTag}</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          {s.title}\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          {s.subtitle}\n        </p>\n      </div>\n\n      {/* 1. TOP 5 SCAMS */}\n      <section className=\"space-y-6\">\n        <div>\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Common Threats\n          </span>\n          <h2 className=\"text-2xl sm:text-3xl font-bold text-[#171717] font-editorial\">\n            {s.threatsTitle}\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {s.threats.map((th) => (\n            <div key={th.id} className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm space-y-3 flex flex-col justify-between\">\n              <div>\n                <h3 className=\"text-base font-bold text-[#171717]\">{th.title}</h3>\n                <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mt-2\">\n                  {th.desc}\n                </p>\n                <div className=\"mt-3 p-2.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded text-xs text-[#171717]\">\n                  <strong>Scammer Tactic: </strong>\n                  <span>{th.tactic}</span>\n                </div>\n              </div>\n              <div className=\"pt-3 border-t border-[#F0F0EE] flex items-start gap-2 text-xs font-medium text-emerald-900 bg-emerald-50/60 p-2.5 rounded border border-emerald-200/60\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                <span>{th.rule}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 2. THE 4 GOLDEN RULES */}\n      <section className=\"p-8 sm:p-10 border border-[#E5E5E5] bg-[#FAF9F6] rounded-sm space-y-8\">\n        <div>\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Core Foundations\n          </span>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            {s.rulesTitle}\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {s.rules.map((r, i) => (\n            <div key={i} className=\"p-5 bg-white border border-[#E5E5E5] rounded\">\n              <span className=\"text-xs font-mono font-bold text-[#737373] uppercase tracking-wider block mb-2\">\n                RULE {r.num}\n              </span>\n              <h4 className=\"text-sm font-bold text-[#171717] mb-1.5\">{r.title}</h4>\n              <p className=\"text-xs text-[#525252] leading-relaxed\">\n                {r.desc}\n              </p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 3. EMERGENCY RESPONSE \342\200\224 1930 & Golden Hour */}\n      <section className=\"p-8 sm:p-10 border-2 border-[#171717] bg-[#171717] text-white rounded-sm space-y-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <ShieldAlert className=\"w-6 h-6 text-amber-400\" />\n            <span className=\"text-xs font-mono font-bold tracking-wider uppercase text-[#A3A3A3]\">\n              {s.emergency.tag}\n            </span>\n          </div>\n          <span className=\"text-xs font-semibold px-2.5 py-1 bg-amber-400 text-black rounded font-mono\">\n            {s.emergency.badge}\n          </span>\n        </div>\n\n        <h3 className=\"text-2xl sm:text-3xl font-bold text-white font-editorial\">\n          {s.emergency.title}\n        </h3>\n\n        <p className=\"text-sm text-[#D4D4D4] max-w-3xl leading-relaxed\">\n          {s.emergency.desc}\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-4\">\n          {s.emergency.steps.map((st) => (\n            <div key={st.num} className=\"p-5 bg-[#262626] border border-[#404040] rounded space-y-2\">\n              <span className=\"w-6 h-6 rounded-full bg-white text-[#171717] font-bold text-xs flex items-center justify-center font-mono\">\n                {st.num}\n              </span>\n              <h4 className=\"text-base font-bold text-white\">{st.title}</h4>\n              <p className=\"text-xs text-[#A3A3A3] leading-relaxed\">\n                {st.desc}\n              </p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* 4. DOs and DONTs */}\n      <section className=\"border-t border-[#E5E5E5] pt-12\">\n        <h2 className=\"text-xl sm:text-2xl font-bold text-[#171717] mb-6 font-editorial\">\n          {s.dosTitle}\n        </h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          <div className=\"p-6 border border-emerald-200 bg-emerald-50/40 rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-emerald-800 font-bold text-sm\">\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-700\" />\n              <span>DO / \340\244\271\340\244\256\340\245\207\340\244\266\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202</span>\n            </div>\n            <ul className=\"space-y-2 text-xs sm:text-sm text-emerald-950\">\n              {s.dos.map((d, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <span className=\"font-bold\">\342\200\242</span>\n                  <span>{d}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"p-6 border border-red-200 bg-red-50/40 rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-red-800 font-bold text-sm\">\n              <XCircle className=\"w-5 h-5 text-red-600\" />\n              <span>DON\'T / \340\244\225\340\244\255\340\245\200 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202</span>\n            </div>\n            <ul className=\"space-y-2 text-xs sm:text-sm text-red-950\">\n              {s.donts.map((d, i) => (\n                <li key={i} className=\"flex items-start gap-2\">\n                  <span className=\"font-bold\">\342\200\242</span>\n                  <span>{d}</span>\n                </li>\n              ))}\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* NEXT MODULE CTA */}\n      <div className=\"flex justify-end pt-6\">\n        <button\n          onClick={() => {\n            setCurrentPage(\'services\');\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n          className=\"inline-flex items-center gap-2 px-6 py-3.5 bg-[#171717] text-white text-sm font-semibold rounded hover:bg-[#333333] transition-colors\"\n        >\n          <span>{s.nextCta}</span>\n          <ArrowRight className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
