      replacement_content: "import { QuizQuestion } from \'../types\';\n\nexport const quizQuestions: QuizQuestion[] = [\n  {\n    id: 1,\n    category: \'payments\',\n    question: \'Someone calls and says they want to send you \342\202\2715,000 for an old item you listed. They say: \"Please enter your UPI PIN to receive the money into your bank account.\" What should you do?\',\n    questionHi: \'\340\244\225\340\245\213\340\244\210 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244\340\244\277 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\225\340\245\207 \340\244\225\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\225\340\244\277 \340\244\265\340\244\271 \340\244\206\340\244\252\340\244\225\340\245\213 \342\202\2715,000 \340\244\255\340\245\207\340\244\234\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\224\340\244\260 \340\244\225\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210: \"\340\244\252\340\245\210\340\244\270\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\252\340\245\215\340\244\244 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\205\340\244\252\340\244\250\340\244\276 UPI \340\244\252\340\244\277\340\244\250 \340\244\241\340\244\276\340\244\262\340\245\207\340\244\202\340\245\244\" \340\244\206\340\244\252\340\244\225\340\245\213 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\277\340\244\217?\',\n    questionMr: \'\340\244\217\340\244\226\340\244\276\340\244\246\340\245\200 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244\340\245\200 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\245\202\340\244\250 \340\244\270\340\244\276\340\244\202\340\244\227\340\244\244\340\245\207 \340\244\225\340\245\200 \340\244\244\340\244\277\340\244\262\340\244\276 \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\244\276\340\244\262\340\244\276 \342\202\271\340\245\253,\340\245\246\340\245\246\340\245\246 \340\244\252\340\244\276\340\244\240\340\244\265\340\244\276\340\244\257\340\244\232\340\245\207 \340\244\206\340\244\271\340\245\207\340\244\244 \340\244\206\340\244\243\340\244\277 \340\244\256\340\245\215\340\244\271\340\244\243\340\244\244\340\245\207: \"\340\244\252\340\245\210\340\244\270\340\245\207 \340\244\226\340\244\276\340\244\244\340\245\215\340\244\257\340\244\276\340\244\244 \340\244\234\340\244\256\340\244\276 \340\244\271\340\245\213\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\244\340\245\201\340\244\256\340\244\232\340\244\276 UPI PIN \340\244\237\340\244\276\340\244\225\340\244\276.\" \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\244\276\340\244\265\340\245\207?\',\n    options: [\n      { text: \'Enter your UPI PIN immediately\', isCorrect: false },\n      { text: \'Share only the first 2 digits of the PIN\', isCorrect: false },\n      { text: \'Never enter your PIN \342\200\224 receiving money NEVER requires a UPI PIN\', isCorrect: true },\n      { text: \'Send your OTP instead\', isCorrect: false },\n    ],\n    explanation: \'Golden Rule of UPI: You ONLY enter your UPI PIN when you want money to LEAVE your bank account. To receive money, you NEVER need to enter a PIN or scan a QR code!\',\n    explanationHi: \'UPI \340\244\225\340\244\276 \340\244\270\340\245\201\340\244\250\340\244\271\340\244\260\340\244\276 \340\244\250\340\244\277\340\244\257\340\244\256: \340\244\206\340\244\252\340\244\225\340\245\213 UPI PIN \340\244\225\340\245\207\340\244\265\340\244\262 \340\244\244\340\244\254 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\271\340\245\213\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\234\340\244\254 \340\244\206\340\244\252 \340\244\252\340\245\210\340\244\270\340\245\207 \340\244\255\340\245\207\340\244\234\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202\340\245\244 \340\244\252\340\245\210\340\244\270\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\252\340\245\215\340\244\244 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\244\255\340\245\200 \340\244\255\340\245\200 PIN \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\200 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225\340\244\244\340\244\276 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\213\340\244\244\340\245\200!\',\n    explanationMr: \'UPI \340\244\232\340\244\276 \340\244\270\340\245\201\340\244\265\340\244\260\340\245\215\340\244\243 \340\244\250\340\244\277\340\244\257\340\244\256: \340\244\234\340\245\207\340\244\265\340\245\215\340\244\271\340\244\276 \340\244\244\340\245\201\340\244\256\340\244\232\340\245\215\340\244\257\340\244\276 \340\244\226\340\244\276\340\244\244\340\245\215\340\244\257\340\244\276\340\244\244\340\245\202\340\244\250 \340\244\252\340\245\210\340\244\270\340\245\207 \340\244\225\340\244\237 \340\244\271\340\245\213\340\244\243\340\244\276\340\244\260 \340\244\205\340\244\270\340\244\244\340\244\276\340\244\244, \340\244\244\340\245\207\340\244\265\340\245\215\340\244\271\340\244\276\340\244\232 UPI PIN \340\244\237\340\244\276\340\244\225\340\244\276\340\244\265\340\244\276 \340\244\262\340\244\276\340\244\227\340\244\244\340\245\213. \340\244\252\340\245\210\340\244\270\340\245\207 \340\244\256\340\244\277\340\244\263\340\244\265\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\24