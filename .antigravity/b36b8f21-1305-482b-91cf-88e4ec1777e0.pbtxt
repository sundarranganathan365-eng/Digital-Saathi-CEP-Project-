      replacement_content: "import { VideoGuide } from \'../types\';\n\nexport const videoGuides: VideoGuide[] = [\n  // --- DIGITAL BASICS ---\n  {\n    id: \'yt-sim-lock\',\n    category: \'basics\',\n    title: \'How to Enable SIM Card Lock PIN (Android & iPhone)\',\n    titleHi: \'\340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\262\340\245\211\340\244\225 (SIM PIN) \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\232\340\244\276\340\244\262\340\245\202 \340\244\225\340\244\260\340\245\207\340\244\202 (\340\244\217\340\244\202\340\244\241\340\245\215\340\244\260\340\245\211\340\244\257\340\244\241 \340\244\265 \340\244\206\340\244\210\340\244\253\340\245\213\340\244\250)\',\n    titleMr: \'\340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\262\340\245\211\340\244\225 (SIM PIN) \340\244\225\340\244\270\340\244\276 \340\244\270\340\245\201\340\244\260\340\245\202 \340\244\225\340\244\260\340\244\276\340\244\265\340\244\276 (\340\244\205\340\244\201\340\244\241\340\245\215\340\244\260\340\245\211\340\244\207\340\244\241 \340\244\265 \340\244\206\340\244\257\340\244\253\340\245\213\340\244\250)\',\n    description: \'Step-by-step video demonstration on setting up a 4-digit SIM lock PIN to prevent OTP theft if your phone is lost or stolen.\',\n    descriptionHi: \'\340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\207\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\232\340\245\213\340\244\260\340\245\200 \340\244\224\340\244\260 \340\244\254\340\245\210\340\244\202\340\244\225 OTP \340\244\253\340\245\215\340\244\260\340\245\211\340\244\241 \340\244\270\340\245\207 \340\244\254\340\244\232\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 4-\340\244\205\340\244\202\340\244\225\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\2