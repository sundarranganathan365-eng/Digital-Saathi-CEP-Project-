  file_change {
    absolute_path_uri: "file:///src/components/ScamSpotter.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { scamScenarios } from \'../data/scamScenarios\';\nimport { ScamScenario } from \'../types\';\nimport { ShieldCheck, ShieldAlert, AlertTriangle, ArrowRight, CheckCircle2, XCircle, RefreshCw, MessageSquare, Phone, Mail } from \'lucide-react\';\n\nexport const ScamSpotter: React.FC = () => {\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [userChoice, setUserChoice] = useState<\'safe\' | \'scam\' | null>(null);\n\n  const scenario: ScamScenario = scamScenarios[currentIndex];\n\n  const handleChoice = (choice: \'safe\' | \'scam\') => {\n    setUserChoice(choice);\n  };\n\n  const handleNext = () => {\n    setUserChoice(null);\n    setCurrentIndex((prev) => (prev + 1) % scamScenarios.length);\n  };\n\n  const isAnswered = userChoice !== null;\n  const isCorrect = isAnswered && ((userChoice === \'scam\' && scenario.isScam) || (userChoice === \'safe\' && !scenario.isScam));\n\n  const getChannelIcon = (channel: ScamScenario[\'channel\']) => {\n    switch (channel) {\n      case \'SMS\':\n      case \'WhatsApp\':\n        return <MessageSquare className=\"w-4 h-4 text-[#737373]\" />;\n      case \'Call\':\n        return <Phone className=\"w-4 h-4 text-[#737373]\" />;\n      case \'Email\':\n        return <Mail className=\"w-4 h-4 text-[#737373]\" />;\n    }\n  };\n\n  return (\n    <div className=\"border border-[#E5E5E5] bg-white rounded-sm\">\n      {/* Header bar */}\n      <div className=\"flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-b border-[#E5E5E5] bg-[#FAF9F6]\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">\n            Case {currentIndex + 1} of {scamScenarios.length}\n          </span>\n          <span className=\"text-xs text-[#737373] hidden sm:inline\">\n            Interactive Verification Simulator\n          </span>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-[11px] font-medium text-[#737373] uppercase tracking-wider bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 rounded\">\n            Simulated Educational Example\n          </span>\n        </div>\n      </div>\n\n      <div className=\"p-6 md:p-8\">\n        {/* Scenario Message Box */}\n        <div className=\"max-w-2xl mx-auto\">\n          <div className=\"mb-6\">\n            <span className=\"text-xs font-semibold text-[#737373] uppercase tracking-wider block mb-2\">\n              Incoming Notification\n            </span>\n            <div className=\"border border-[#E5E5E5] rounded bg-[#FBFBFA] p-5 shadow-xs\">\n              <div className=\"flex items-center justify-between border-b border-[#EBEBEA] pb-3 mb-3 text-xs text-[#525252]\">\n                <div className=\"flex items-center gap-2\">\n                  {getChannelIcon(scenario.channel)}\n                  <span className=\"font-semibold text-[#171717]\">{scenario.sender}</span>\n                </div>\n                <span className=\"text-[11px] text-[#A3A3A3] uppercase\">{scenario.channel} \342\200\242 Just Now</span>\n              </div>\n              <p className=\"text-sm sm:text-base text-[#171717] leading-relaxed font-sans font-medium whitespace-pre-line\">\n                {scenario.message}\n              </p>\n            </div>\n          </div>\n\n          {/* Action Prompt */}\n          <div className=\"text-center py-2 mb-6\">\n            <h4 className=\"text-base sm:text-lg font-semibold text-[#171717] tracking-tight\">\n              Is this message Safe or a Scam?\n            </h4>\n            <p className=\"text-xs text-[#737373] mt-1\">\n              Analyze the sender, language, urgency, and links before deciding.\n            </p>\n          </div>\n\n          {/* Choice Buttons */}\n          {!isAnswered ? (\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <button\n                id={`scam-choice-scam-${scenario.id}`}\n                onClick={() => handleChoice(\'scam\')}\n                className=\"flex items-center justify-center gap-2 py-3.5 px-4 text-sm font-semibold text-[#171717] bg-[#F5F5F4] hover:bg-[#E5E5E5] border border-[#D4D4D4] rounded transition-all active:scale-[0.99]\"\n              >\n                <ShieldAlert className=\"w-4 h-4 text-red-600\" />\n                <span>This is a Scam</span>\n              </button>\n              <button\n                id={`scam-choice-safe-${scenario.id}`}\n                onClick={() => handleChoice(\'safe\')}\n                className=\"flex items-center justify-center gap-2 py-3.5 px-4 text-sm font-semibold text-[#171717] bg-[#F5F5F4] hover:bg-[#E5E5E5] border border-[#D4D4D4] rounded transition-all active:scale-[0.99]\"\n              >\n                <ShieldCheck className=\"w-4 h-4 text-emerald-700\" />\n                <span>This is Legitimate / Safe</span>\n              </button>\n            </div>\n          ) : (\n            /* Explanation / Result Breakdown */\n            <div className=\"border border-[#E5E5E5] rounded p-6 bg-[#FAF9F6] animate-in fade-in duration-200\">\n              <div className=\"flex items-start gap-3 pb-4 border-b border-[#E5E5E5]\">\n                {isCorrect ? (\n                  <div className=\"p-2 bg-emerald-100 text-emerald-800 rounded\">\n                    <CheckCircle2 className=\"w-5 h-5\" />\n                  </div>\n                ) : (\n                  <div className=\"p-2 bg-amber-100 text-amber-800 rounded\">\n                    <XCircle className=\"w-5 h-5\" />\n                  </div>\n                )}\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <h5 className=\"font-bold text-base text-[#171717]\">\n                      {isCorrect ? \'Correct Analysis!\' : \'Careful \342\200\224 Review the Breakdown:\'}\n                    </h5>\n                    <span\n                      className={`text-xs font-semibold px-2 py-0.5 rounded uppercase ${\n                        scenario.isScam\n                          ? \'bg-red-100 text-red-800 border border-red-200\'\n                          : \'bg-emerald-100 text-emerald-800 border border-emerald-200\'\n                      }`}\n                    >\n                      {scenario.isScam ? \'Scam / Fraudulent\' : \'Legitimate Notification\'}\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#525252] mt-1\">\n                    Classification: <strong>{scenario.type}</strong>\n                  </p>\n                </div>\n              </div>\n\n              {/* Red Flags or Safe Indicators */}\n              {scenario.redFlags.length > 0 && (\n                <div className=\"mt-4\">\n                  <span className=\"text-xs font-semibold text-[#171717] uppercase tracking-wider block mb-2\">\n                    Warning Signs Identified:\n                  </span>\n                  <ul className=\"space-y-2\">\n                    {scenario.redFlags.map((flag, idx) => (\n                      <li key={idx} className=\"flex items-start gap-2 text-xs sm:text-sm text-[#333333]\">\n                        <span className=\"text-red-500 font-bold mt-0.5\">\342\200\242</span>\n                        <span>{flag}</span>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              )}\n\n              {/* Detailed Explanation */}\n              <div className=\"mt-4 pt-4 border-t border-[#E5E5E5]\">\n                <p className=\"text-xs sm:text-sm text-[#404040] leading-relaxed\">\n                  {scenario.explanation}\n                </p>\n              </div>\n\n              {/* Safety Rule Box */}\n              <div className=\"mt-4 p-3 bg-white border border-[#E5E5E5] rounded text-xs text-[#171717] flex items-start gap-2\">\n                <strong className=\"text-[#171717] shrink-0\">Safe Practice:</strong>\n                <span className=\"text-[#525252]\">{scenario.safetyTip}</span>\n              </div>\n\n              {/* Next Case Button */}\n              <div className=\"mt-6 flex justify-end\">\n                <button\n                  id=\"scam-next-case-btn\"\n                  onClick={handleNext}\n                  className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] hover:bg-[#333333] text-white text-xs font-semibold rounded transition-colors\"\n                >\n                  <span>Next Example</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Scenario Selector Dots */}\n      <div className=\"px-6 py-3 border-t border-[#E5E5E5] bg-[#FAF9F6] flex items-center justify-between text-xs text-[#737373]\">\n        <span>Simulated Scenarios ({currentIndex + 1}/{scamScenarios.length})</span>\n        <div className=\"flex items-center gap-1.5\">\n          {scamScenarios.map((_, idx) => (\n            <button\n              key={idx}\n              onClick={() => { setCurrentIndex(idx); setUserChoice(null); }}\n              className={`w-2.5 h-2.5 rounded-full transition-all ${\n                currentIndex === idx ? \'bg-[#171717] w-6\' : \'bg-[#D4D4D4] hover:bg-[#A3A3A3]\'\n              }`}\n              title={`Jump to scenario ${idx + 1}`}\n            />\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
