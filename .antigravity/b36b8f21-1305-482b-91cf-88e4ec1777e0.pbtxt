        }
        lines {
          text: "    dos: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Store your Driving License and Vehicle RC in the official DigiLocker app.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Always download Masked Aadhaar for non-statutory offline verification.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Check the website address ends with .gov.in before filling application forms.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Use the UMANG mobile app to access multiple state and central government services in one place.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    donts: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never laminate or carry original Aadhaar cards everywhere when DigiLocker is accepted.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never pay money on third-party unofficial websites claiming to \"fast-track\" PAN or Aadhaar corrections.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never enter your Aadhaar number or OTP into random Google Forms or WhatsApp links.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Never trust sponsored search ads offering government subsidy schemes.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
