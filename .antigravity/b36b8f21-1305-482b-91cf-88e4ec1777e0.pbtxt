  file_change {
    absolute_path_uri: "file:///src/pages/SafetyPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  ShieldAlert,\n  ShieldCheck,\n  PhoneCall,\n  Lock,\n  Link2,\n  Users,\n  Briefcase,\n  AlertTriangle,\n  CheckCircle2,\n  XCircle,\n  ArrowRight,\n  ExternalLink,\n  HelpCircle,\n  FileWarning,\n} from \'lucide-react\';\n\ninterface SafetyPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const SafetyPage: React.FC<SafetyPageProps> = ({ setCurrentPage, language }) => {\n  const [selectedScamTopic, setSelectedScamTopic] = useState<string>(\'phishing\');\n\n  const scamTopics = [\n    {\n      id: \'phishing\',\n      title: \'Phishing & Fake SMS Links\',\n      icon: <Link2 className=\"w-4 h-4\" />,\n      definition: \'Phishing is when scammers send fake SMS or emails that look like legitimate organizations (like SBI, HDFC, or Electricity Boards) to lure you into clicking malicious websites.\',\n      warningSigns: [\n        \'Uses alarming language: \"Account blocked today\", \"Power cutoff in 2 hours\", \"KYC expired\".\',\n        \'Contains weird link endings: .xyz, .top, .live, .cc instead of official domain names.\',\n        \'Urges you to immediately enter your net banking username, password, or debit card CVV.\',\n      ],\n      defense: \'Never click links in unexpected SMS messages. Always open your browser and type the bank address manually or check with your branch.\',\n    },\n    {\n      id: \'otp\',\n      title: \'OTP (One-Time Password) Fraud\',\n      icon: <Lock className=\"w-4 h-4\" />,\n      definition: \'An OTP is a temporary digital key sent to your phone to authorize a payment or login. Scammers pretend to be helpful agents who need the code to \"verify\" or \"cancel\" a fake charge.\',\n      warningSigns: [\n        \'Caller says: \"I sent you a verification code to cancel the wrong charge, please read it to me.\"\',\n        \'Caller sounds urgent and refuses to let you hang up the phone.\',\n        \'The SMS clearly states: \"Do not share this OTP with anyone, including bank staff.\"\',\n      ],\n      defense: \'No bank employee, police officer, or telecom agent will EVER ask for your OTP. Treat your OTP like your ATM secret code.\',\n    },\n    {\n      id: \'customercare\',\n      title: \'Fake Customer Care Numbers\',\n      icon: <PhoneCall className=\"w-4 h-4\" />,\n      definition: \'Fraudsters create fake Google Maps business listings or unverified social media profiles displaying their own phone numbers as official customer support.\',\n      warningSigns: [\n        \'Searching \"Amazon customer care\" or \"SBI helpline\" and calling the top mobile number without checking domain.\',\n        \'The \"agent\" asks you to install AnyDesk or send \342\202\27110 via UPI to activate a refund request.\',\n      ],\n      defense: \'Only obtain helpline numbers printed directly on the back of your physical bank debit card, passbook, or from inside verified official apps.\',\n    },\n    {\n      id: \'jobs\',\n      title: \'Part-Time Job & Task Scams\',\n      icon: <Briefcase className=\"w-4 h-4\" />,\n      definition: \'Scammers offer high daily payouts (e.g. \342\202\2713,000\342\200\223\342\202\2718,000/day) for simple tasks like liking YouTube videos, rating Google Maps locations, or hotel reviews on Telegram.\',\n      warningSigns: [\n        \'Unsolicited WhatsApp job offers for work you never applied for.\',\n        \'They pay a small token (\342\202\271150) to gain trust, then demand \"prepaid task deposits\" to unlock your earnings.\',\n        \'You are placed into a Telegram group with fake accounts celebrating huge profits.\',\n      ],\n      defense: \'Legitimate companies never hire via random WhatsApp messages and will never ask you to pay money to get paid.\',\n    },\n    {\n      id: \'social\',\n      title: \'Social Engineering & Fear Tactics\',\n      icon: <Users className=\"w-4 h-4\" />,\n      definition: \'Scammers manipulate natural human emotions\342\200\224Fear, Urgency, Greed, or Sympathy\342\200\224to force victims to act before they have time to think critically.\',\n      warningSigns: [\n        \'Threat of imminent legal arrest (Digital Arrest scams pretending to be CBI / Police on video calls).\',\n        \'Claims that a close relative had an accident and urgently needs hospital funds transferred.\',\n        \'Unbelievable lottery or gift claims requiring upfront \"tax payments\".\',\n      ],\n      defense: \'Take a deep breath and pause. Real police do not interrogate citizens over Skype or WhatsApp video calls. Always call your relative directly on their known phone number.\',\n    },\n  ];\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Module 03\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">Cyber Threat Defense</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          Online Safety & Scam Prevention\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          Understanding the anatomy of modern online scams, recognizing psychological red flags, and building robust daily digital hygiene to protect yourself and your family.\n        </p>\n      </div>\n\n      {/* 1. Deep Dive Scam Categories (Topic Selector) */}\n      <section className=\"space-y-6\">\n        <div>\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Threat Intelligence\n          </span>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            Common Cyber Scam Archetypes\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          {/* Topic List */}\n          <div className=\"lg:col-span-4 space-y-2\">\n            {scamTopics.map((topic) => (\n              <button\n                key={topic.id}\n                onClick={() => setSelectedScamTopic(topic.id)}\n                className={`w-full flex items-center justify-between p-4 rounded text-left border transition-all ${\n                  selectedScamTopic === topic.id\n                    ? \'border-[#171717] bg-[#171717] text-white shadow-xs\'\n                    : \'border-[#E5E5E5] bg-white text-[#171717] hover:bg-[#F5F5F4]\'\n                }`}\n              >\n                <div className=\"flex items-center gap-3\">\n                  <span className={selectedScamTopic === topic.id ? \'text-white\' : \'text-[#737373]\'}>\n                    {topic.icon}\n                  </span>\n                  <span className=\"text-xs sm:text-sm font-semibold\">{topic.title}</span>\n                </div>\n                <ArrowRight className={`w-3.5 h-3.5 ${selectedScamTopic === topic.id ? \'text-white\' : \'text-[#A3A3A3]\'}`} />\n              </button>\n            ))}\n          </div>\n\n          {/* Active Detail Showcase */}\n          {(() => {\n            const active = scamTopics.find((t) => t.id === selectedScamTopic)!;\n            return (\n              <div className=\"lg:col-span-8 p-6 sm:p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-6\">\n                <div>\n                  <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-1\">\n                    Threat Breakdown\n                  </span>\n                  <h3 className=\"text-xl font-bold text-[#171717] font-editorial\">\n                    {active.title}\n                  </h3>\n                  <p className=\"text-sm text-[#525252] mt-2 leading-relaxed\">\n                    {active.definition}\n                  </p>\n                </div>\n\n                <div className=\"space-y-3\">\n                  <span className=\"text-xs font-semibold text-[#171717] uppercase tracking-wider block\">\n                    Warning Red Flags to Watch For:\n                  </span>\n                  <div className=\"space-y-2\">\n                    {active.warningSigns.map((sign, idx) => (\n                      <div key={idx} className=\"flex items-start gap-2.5 text-xs sm:text-sm text-[#333333] p-2.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded\">\n                        <AlertTriangle className=\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\" />\n                        <span>{sign}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"p-4 bg-emerald-50 border border-emerald-300 rounded text-xs sm:text-sm text-emerald-950 flex items-start gap-3\">\n                  <ShieldCheck className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong className=\"block font-bold mb-0.5\">How to Protect Yourself:</strong>\n                    <span>{active.defense}</span>\n                  </div>\n                </div>\n              </div>\n            );\n          })()}\n        </div>\n      </section>\n\n      {/* 2. DOs & DON\'Ts Comparative Matrix */}\n      <section className=\"space-y-6\">\n        <div>\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Behavioral Matrix\n          </span>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            Daily Digital Safety: DOs & DON\'Ts\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#525252]\">\n            Keep these clear rules in mind whenever you interact with online messages, phone calls, or digital services.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          {/* DOs Card */}\n          <div className=\"border border-emerald-300 bg-white rounded-sm p-6 sm:p-8 space-y-4\">\n            <div className=\"flex items-center gap-2 text-emerald-800 font-bold text-base pb-3 border-b border-emerald-100\">\n              <CheckCircle2 className=\"w-5 h-5 text-emerald-700\" />\n              <span>WHAT YOU MUST ALWAYS DO</span>\n            </div>\n            <ul className=\"space-y-3.5 text-xs sm:text-sm text-[#262626]\">\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-emerald-700 font-bold\">\342\234\223</span>\n                <span><strong>Verify the sender:</strong> Double-check the sender ID or full email address before responding.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-emerald-700 font-bold\">\342\234\223</span>\n                <span><strong>Type official URLs directly:</strong> Open your browser and type bank URLs manually.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-emerald-700 font-bold\">\342\234\223</span>\n                <span><strong>Use Masked Aadhaar:</strong> Provide masked photocopies showing only the last 4 digits for offline verification.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-emerald-700 font-bold\">\342\234\223</span>\n                <span><strong>Pause when rushed:</strong> Legitimate government and bank procedures always give you reasonable time.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-emerald-700 font-bold\">\342\234\223</span>\n                <span><strong>Report suspicious numbers:</strong> Block fraud callers and report cyber crime promptly to 1930.</span>\n              </li>\n            </ul>\n          </div>\n\n          {/* DON\'Ts Card */}\n          <div className=\"border border-red-300 bg-white rounded-sm p-6 sm:p-8 space-y-4\">\n            <div className=\"flex items-center gap-2 text-red-800 font-bold text-base pb-3 border-b border-red-100\">\n              <XCircle className=\"w-5 h-5 text-red-700\" />\n              <span>WHAT YOU MUST NEVER DO</span>\n            </div>\n            <ul className=\"space-y-3.5 text-xs sm:text-sm text-[#262626]\">\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-red-600 font-bold\">\342\234\227</span>\n                <span><strong>Never share OTPs:</strong> Not even with individuals claiming to be bank or police officers.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-red-600 font-bold\">\342\234\227</span>\n                <span><strong>Never enter your UPI PIN to receive money:</strong> Entering a PIN strictly sends money out.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-red-600 font-bold\">\342\234\227</span>\n                <span><strong>Never install remote screen apps:</strong> (AnyDesk, TeamViewer, RustDesk) on instructions of phone callers.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-red-600 font-bold\">\342\234\227</span>\n                <span><strong>Never click SMS link attachments:</strong> Especially those warning of imminent electricity or bank blocks.</span>\n              </li>\n              <li className=\"flex items-start gap-2.5\">\n                <span className=\"text-red-600 font-bold\">\342\234\227</span>\n                <span><strong>Never send money to claim prizes:</strong> Real lotteries and contests never require advance \"processing taxes\".</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. Emergency Helpline 1930 & Golden Hour Protocol */}\n      <section className=\"border border-[#171717] bg-[#171717] text-white rounded-sm p-6 sm:p-10 space-y-6\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#333333] pb-6\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"px-2 py-0.5 bg-red-600 text-white text-xs font-mono font-bold rounded\">\n                EMERGENCY PROTOCOL\n              </span>\n              <span className=\"text-xs text-[#A3A3A3] font-mono\">GOLDEN HOUR RESPONSE</span>\n            </div>\n            <h3 className=\"text-2xl font-bold text-white mt-2 font-editorial\">\n              What To Do If You Lose Money to Cyber Fraud\n            </h3>\n          </div>\n          <a\n            href=\"tel:1930\"\n            className=\"inline-flex items-center gap-2 px-5 py-3 bg-white text-[#171717] font-bold text-sm rounded hover:bg-[#E5E5E5] transition-colors shrink-0\"\n          >\n            <PhoneCall className=\"w-4 h-4 text-red-600\" />\n            <span>Call 1930 Immediately</span>\n          </a>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs sm:text-sm\">\n          <div className=\"space-y-2 p-4 bg-[#262626] border border-[#404040] rounded\">\n            <span className=\"text-red-400 font-mono font-bold block\">STEP 1: ACT WITHIN 2 HOURS</span>\n            <p className=\"text-[#D4D4D4] leading-relaxed\">\n              Dial <strong>1930</strong> (National Cyber Crime Helpline) as quickly as possible. The Citizen Financial Cyber Fraud Reporting System can flag and freeze stolen funds across banks before the fraudster withdraws it at an ATM.\n            </p>\n          </div>\n\n          <div className=\"space-y-2 p-4 bg-[#262626] border border-[#404040] rounded\">\n            <span className=\"text-red-400 font-mono font-bold block\">STEP 2: GATHER DETAILS</span>\n            <p className=\"text-[#D4D4D4] leading-relaxed\">\n              Keep your bank account number, debit card number, transaction UTR/reference number, scammer\'s phone number/UPI ID, and SMS screenshot ready for the officer.\n            </p>\n          </div>\n\n          <div className=\"space-y-2 p-4 bg-[#262626] border border-[#404040] rounded\">\n            <span className=\"text-red-400 font-mono font-bold block\">STEP 3: FILE ONLINE TICKET</span>\n            <p className=\"text-[#D4D4D4] leading-relaxed\">\n              Log into <strong className=\"text-white\">cybercrime.gov.in</strong> and file a formal e-complaint. An acknowledgment receipt will be generated for your bank and local police station.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Next Module Navigation Link */}\n      <div className=\"pt-8 border-t border-[#E5E5E5] flex items-center justify-between\">\n        <button\n          onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"text-xs font-semibold text-[#737373] hover:text-[#171717] transition-colors\"\n        >\n          \342\206\220 Previous: Module 02 (Digital Payments)\n        </button>\n\n        <button\n          id=\"btn-next-module-services\"\n          onClick={() => { setCurrentPage(\'services\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors shadow-xs\"\n        >\n          <span>Continue to Module 04: Digital Public Services</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
