    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport { PhoneCall, ShieldAlert, GitFork, BookOpen, ExternalLink, Heart } from \'lucide-react\';\n\ninterface FooterProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst footerLabels = {\n  en: {\n    curriculumTitle: \'Curriculum\',\n    mod1: \'01. Digital Basics\',\n    mod2: \'02. UPI & Safe Payments\',\n    mod3: \'03. Online Safety & Scams\',\n    mod4: \'04. Digital Public Services\',\n    practiceTitle: \'Practice & Verify\',\n    toolScam: \'Scam Spotter Simulator\',\n    toolQuiz: \'10-Question Knowledge Test\',\n    toolChecklist: \"DOs & DON\'Ts Checklist\",\n    toolRules: \'Golden Rules of UPI\',\n    projectTitle: \'Project Information\',\n    aboutInit: \'About the Initiative\',\n    problemState: \'CEP Problem Statement\',\n    repo: \'GitHub Repository\',\n    batch: \'BSc CS 2025\342\200\2232026 Batch\',\n    openSourceTag: \'Open Source \342\200\242 MIT License\',\n    callBtn: \'Call 1930\',\n    inclusion: \'Crafted for Social Digital Inclusion\',\n    noAffiliation: \'No Commercial Affiliation\',\n  },\n  hi: {\n    curriculumTitle: \'\340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256\',\n    mod1: \'01. \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202\',\n    mod2: \'02. UPI \340\244\217\340\244\265\340\244\202 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250\',\n    mod3: \'03. \340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\265 \340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\254\340\244\232\340\244\276\340\244\265\',\n    mod4: \'04. \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n    practiceTitle: \'\340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\265 \340\244\234\340\244\276\340\244\202\340\244\232\',\n    toolScam: \'\340\244\270\340\245\215\340\244\225\340\245\210\340\244\256 \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 \340\244\270\340\244\277\340\244\256\340\245\215\340\244\257\340\245\201\340\244\262\340\245\207\340\244\237\340\244\260\',\n    toolQuiz: \'10 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\237\340\245\207\340\244\270\340\245\215\340\244\237\',\n    toolChecklist: \'\340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202 / \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\232\340\245\207\340\244\225\340\244\262\340\244\277\340\244\270\340\245\215\340\244\237\',\n    toolRules: \'UPI \340\244\225\340\245\207 \340\244\270\340\245\201\340\244\250\340\244\271\340\244\260\340\245\207 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    projectTitle: \'\340\244\252\340\245\215\340\244\260\340\245\213\340\244\234\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200\',\n    aboutInit: \'\340\244\252\340\244\271\340\244\262 \340\244\225\340\245\207 \340\244\254\340\244\276\340\244\260\340\245\207 \340\244\256\340\245\207\340\244\202\',\n    problemState: \'CEP \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\340\244\243\',\n    repo: \'\340\244\227\340\244\277\340\244\237\340\244\271\340\244\254 \340\244\260\340\244\277\340\244\252\340\245\211\340\244\234\340\244\277\340\244\237\340\244\260\340\245\200 (GitHub)\',\n    batch: \'\340\244\254\340\245\200\340\244\217\340\244\270\340\244\270\340\245\200 \340\244\270\340\245\200\340\244\217\340\244\270 2025-2026 \340\244\254\340\245\210\340\244\232\',\n    openSourceTag: \'\340\244\223\340\244\252\340\244\250-\340\244\270\340\245\213\340\244\260\340\245\215\340\244\270 \342\200\242 MIT \340\244\262\340\244\276\340\244\207\340\244\270\340\245\207\340\244\202\340\244\270\',\n    callBtn: \'\340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 1930\',\n    inclusion: \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\234\340\244\277\340\244\225 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276 \340\244\271\340\245\207\340\244\244\340\245\201 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\256\340\244\277\340\244\244\',\n    noAffiliation: \'\340\244\227\340\245\210\340\244\260-\340\244\265\340\245\215\340\244\257\340\244\276\340\244\265\340\244\270\340\244\276\340\244\257\340\244\277\340\244\225 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\243\340\244\277\340\244\225 \340\244\252\340\244\271\340\244\262\',\n  },\n  mr: {\n    curriculumTitle: \'\340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270\340\244\225\340\245\215\340\244\260\340\244\256\',\n    mod1: \'\340\245\246\340\245\247. \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\256\340\245\202\340\244\262\340\244\255\340\245\202\340\244\244 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n    mod2: \'\340\245\246\340\245\250. UPI \340\244\265 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270\',\n    mod3: \'\340\245\246\340\245\251. \340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\265 \340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\254\340\244\232\340\244\276\340\244\265\',\n    mod4: \'\340\245\246\340\245\252. \340\244\266\340\244\276\340\244\270\340\244\225\340\245\200\340\244\257 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\',\n    practiceTitle: \'\340\244\270\340\244\260\340\244\276\340\244\265 \340\244\265 \340\244\252\340\244\241\340\244\244\340\244\276\340\244\263\340\244\243\340\245\200\',\n    toolScam: \'\340\244\270\340\245\215\340\244\225\340\245\205\340\244\256 \340\244\223\340\244\263\340\244\226 \340\244\270\340\244\277\340\244\256\340\245\215\340\244\257\340\245\201\340\244\262\340\245\207\340\244\237\340\244\260\',\n    toolQuiz: \'\340\245\247\340\245\246 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\244\276\340\244\202\340\244\232\340\245\200 \340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200\',\n    toolChecklist: \'\340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\244\276\340\244\265\340\245\207 / \340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\245\202 \340\244\250\340\244\257\340\245\207 \340\244\250\340\244\277\340\244\257\340\244\256\340\244\276\340\244\265\340\244\262\340\245\200\',\n    toolRules: \'UPI \340\244\232\340\245\207 \340\244\270\340\245\201\340\244\265\340\244\260\340\245\215\340\244\243 \340\244\250\340\244\277\340\244\257\340\244\256\',\n    projectTitle: \'\340\244\252\340\245\215\340\244\260\340\244\225\340\244\262\340\245\215\340\244\252\340\244\276\340\244\265\340\244\277\340\244\267\340\244\257\340\245\200\',\n    aboutInit: \'\340\244\211\340\244\252\340\244\225\340\245\215\340\244\260\340\244\256\340\244\276\340\244\265\340\244\277\340\244\267\340\244\257\340\245\200 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n    problemState: \'CEP \340\244\270\340\244\256\340\244\270\340\245\215\340\244\257\340\244\276 \340\244\265 \340\244\211\340\244\252\340\244\276\340\244\257\',\n    repo: \'\340\244\227\340\244\277\340\244\237\340\244\271\340\244\254 (GitHub) \340\244\225\340\245\213\340\244\241\',\n    batch: \'\340\244\254\340\245\200.\340\244\217\340\244\270\340\245\215\340\244\270\340\245\200. \340\244\225\340\245\211\340\244\256\340\245\215\340\244\252\340\245\215\340\244\257\340\245\201\340\244\237\340\244\260 \340\244\270\340\244\276\340\244\257\340\244\250\340\245\215\340\244\270 \340\245\250\340\245\246\340\245\250\340\245\253\342\200\223\340\245\250\340\245\246\340\245\250\340\245\254\',\n    openSourceTag: \'\340\244\223\340\244\252\340\244\250-\340\244\270\340\245\213\340\244\260\340\245\215\340\244\270 \342\200\242 MIT \340\244\252\340\244\260\340\244\265\340\244\276\340\244\250\340\244\276\',\n    callBtn: \'\340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\276 \340\245\247\340\245\257\340\245\251\340\245\246\',\n    inclusion: \'\340\244\270\340\244\276\340\244\256\340\244\276\340\244\234\340\244\277\340\244\225 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\245\207\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\265\340\244\277\340\244\225\340\244\270\340\244\277\340\244\244\',\n    noAffiliation: \'\340\244\225\340\245\207\340\244\265\340\244\263 \340\244\262\340\245\213\340\244\225\340\244\266\340\244\277\340\244\225\340\245\215\340\244\267\340\244\243\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\270\340\244\256\340\244\260\340\245\215\340\244\252\340\244\277\340\244\244\',\n  },\n};\n\nexport const Footer: React.FC<FooterProps> = ({ setCurrentPage, language }) => {\n  const t = translations[language];\n  const f = footerLabels[language];\n\n  return (\n    <footer className=\"bg-[#171717] text-[#A3A3A3] pt-16 pb-12 border-t border-[#262626]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Top Section: Cyber Helpline Alert Banner */}\n        <div className=\"bg-[#262626] border border-[#404040] rounded-sm p-6 mb-14 flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n          <div className=\"flex items-start gap-4\">\n            <div className=\"p-2.5 bg-red-950/60 border border-red-800 text-red-400 rounded\">\n              <ShieldAlert className=\"w-6 h-6 shrink-0\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-white font-semibold text-base\">{t.footer.helplineAlertTitle}</span>\n                <span className=\"bg-red-500/20 text-red-300 text-[11px] font-mono px-2 py-0.5 rounded border border-red-500/30\">\n                  {t.footer.actFastBadge}\n                </span>\n              </div>\n              <p className=\"text-sm text-[#D4D4D4] mt-1 max-w-2xl\">\n                {t.footer.helplineAlertDesc}\n              </p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3 shrink-0 w-full md:w-auto\">\n            <a\n              href=\"tel:1930\"\n              className=\"inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-white text-[#171717] font-semibold text-sm rounded hover:bg-[#E5E5E5] transition-colors w-full md:w-auto\"\n            >\n              <PhoneCall className=\"w-4 h-4 text-red-600\" />\n              <span>{f.callBtn}</span>\n            </a>\n            <a\n              href=\"https://cybercrime.gov.in\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-[#333333] hover:bg-[#404040] text-white text-xs font-medium rounded transition-colors border border-[#525252]\"\n            >\n              <span>cybercrime.gov.in</span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </a>\n          </div>\n        </div>\n\n        {/* Main Columns */}\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-[#262626]\">\n          {/* Col 1 & 2: Brand & Academic Manifesto */}\n          <div className=\"md:col-span-2 pr-0 md:pr-6\">\n            <div className=\"flex items-center gap-2.5 mb-3\">\n              <div className=\"w-7 h-7 rounded-sm bg-white text-[#171717] flex items-center justify-center font-bold text-xs\">\n                DS\n              </div>\n              <span className=\"text-white font-bold text-lg tracking-tight\">{t.siteTitle}</span>\n            </div>\n            <p className=\"text-sm text-[#E5E5E5] font-medium mb-3\">\n              \342\200\234{t.tagline}\342\200\235\n            </p>\n            <p className=\"text-xs text-[#A3A3A3] leading-relaxed mb-4\">\n              {t.footer.aboutCep}\n            </p>\n            <div className=\"inline-flex items-center gap-2 text-xs text-[#D4D4D4] bg-[#262626] px-3 py-1.5 rounded border border-[#404040]\">\n              <GitFork className=\"w-3.5 h-3.5 text-[#A3A3A3]\" />\n              <span>{f.openSourceTag}</span>\n            </div>\n          </div>\n\n          {/* Col 3: Modules */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              {f.curriculumTitle}\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'basics\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.mod1}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.mod2}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.mod3}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'services\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.mod4}\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 4: Interactive Tools */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              {f.practiceTitle}\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'home\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.toolScam}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'quiz\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.toolQuiz}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.toolChecklist}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.toolRules}\n                </button>\n              </li>\n            </ul>\n          </div>\n\n          {/* Col 5: Project & Open Source */}\n          <div>\n            <h4 className=\"text-white font-semibold text-xs uppercase tracking-wider mb-4\">\n              {f.projectTitle}\n            </h4>\n            <ul className=\"space-y-2.5 text-xs\">\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.aboutInit}\n                </button>\n              </li>\n              <li>\n                <button\n                  onClick={() => { setCurrentPage(\'about\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n                  className=\"hover:text-white transition-colors\"\n                >\n                  {f.problemState}\n                </button>\n              </li>\n              <li>\n                <a\n                  href=\"https://github.com\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"inline-flex items-center gap-1 hover:text-white transition-colors\"\n                >\n                  <span>{f.repo}</span>\n                  <ExternalLink className=\"w-3 h-3 text-[#737373]\" />\n                </a>\n              </li>\n              <li>\n                <span className=\"text-[#737373]\">{f.batch}</span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#737373]\">\n          <div>\n            {t.footer.copyright}\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <span className=\"text-[#525252]\">{f.inclusion}</span>\n            <span>\342\200\242</span>\n            <span className=\"text-[#525252]\">{f.noAffiliation}</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"
    }
