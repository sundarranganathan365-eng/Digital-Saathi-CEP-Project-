77\340\244\256 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\226\340\244\260\340\245\215\340\244\232 \340\244\225\340\244\277\340\244\217 \340\244\225\340\244\250\340\245\207\340\244\225\340\245\215\340\244\237 \340\244\271\340\245\213\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244\',\n      steps: [\n        \'\340\244\230\340\244\260 \340\244\225\340\244\276 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210: \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\224\340\244\260 \340\244\244\340\245\207\340\244\234 \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\205\340\244\232\340\245\215\340\244\233\340\244\276\340\245\244\',\n        \'\340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 (4G/5G): \340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\254\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\224\340\244\260 UPI \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244\340\245\244\',\n        \'\340\244\226\340\245\201\340\244\262\340\244\276 \340\244\252\340\244\254\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210: \340\244\260\340\245\207\340\244\262\340\244\265\340\245\207 \340\244\270\340\245\215\340\244\237\340\245\207\340\244\266\340\244\250 \340\244\257\340\244\276 \34