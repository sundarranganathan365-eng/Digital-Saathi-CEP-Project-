      replacement_content: "import { ScamScenario } from \'../types\';\n\nexport const scamScenarios: ScamScenario[] = [\n  {\n    id: \'scam-kyc\',\n    sender: \'VM-SBIN-ALERT\',\n    senderHi: \'VM-SBIN-\340\244\232\340\245\207\340\244\244\340\244\276\340\244\265\340\244\250\340\245\200\',\n    senderMr: \'VM-SBIN-\340\244\270\340\245\202\340\244\232\340\244\250\340\244\276\',\n    channel: \'SMS\',\n    message: \'URGENT! Dear Customer, your SBI Bank account will be blocked today due to pending KYC. Click immediately to update documents: http://sbi-kyc-verify.xyz/login.php\',\n    messageHi: \'\340\244\205\340\244\244\340\244\277 \340\244\206\340\244\265\340\244\266\340\245\215\340\244\257\340\244\225! \340\244\252\340\245\215\340\244\260\340\244\277\340\244\257 \340\244\227\340\245\215\340\244\260\340\244\276\340\244\271\340\244\225, KYC \340\244\205\340\244\247\340\245\202\340\244\260\340\244\276 \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\225\340\244\276\340\244\260\340\244\243 \340\244\206\340\244\252\340\244\225\340\244\276 SBI \340\244\254\340\245\210\340\244\202\340\244\225 \340\244\226\340\244\276\340\244\244\340\244\276 \340\244\206\340\244\234 \340\244\254\340\245\215\340\244\262\340\245\211\340\244\225 \340\244\225\340\244\260 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\217\340\244\227\340\244\276\340\245\244 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\246\340\244\270\340\245\215\340\244\244\340\244\276\340\244\265\340\245\207\340\244\234 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\225\340\245\215\340\244\262\340\244\277\340\244\225 \340\244\225\340\244\260\340\245\207\340\244\202: http://sbi-kyc-verify.xyz/login.php\',\n    messageMr: \'\340\244\205\340\244\244\340\2