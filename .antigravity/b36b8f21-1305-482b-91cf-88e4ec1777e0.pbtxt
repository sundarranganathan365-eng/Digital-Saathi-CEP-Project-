     text: \'Give the OTP if the caller sounds polite and professional\',\n        textHi: \'\340\244\257\340\244\246\340\244\277 \340\244\225\340\245\211\340\244\262\340\244\260 \340\244\265\340\244\277\340\244\250\340\244\256\340\245\215\340\244\260 \340\244\262\340\244\227\340\245\207 \340\244\244\340\245\213 OTP \340\244\246\340\245\207 \340\244\246\340\245\207\340\244\202\',\n        textMr: \'\340\244\254\340\245\213\340\244\262\340\244\243\340\244\276\340\244\260\340\244\276 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244\340\245\200 \340\244\250\340\244\256\340\245\215\340\244\260 \340\244\265\340\244\276\340\244\237\340\244\262\340\245\215\340\244\257\340\244\276\340\244\270 OTP \340\244\246\340\245\215\340\244\257\340\244\276\340\244\265\340\244\276\',\n        isCorrect: false,\n      },\n      {\n        text: \'Never share your OTP with anyone, including real bank staff\',\n        textHi: \'\340\244\225\340\244\277\340\244\270\340\245\200 \340\244\225\340\245\207 \340\244\270\340\244\276\340\244\245 \340\244\255\340\245\200 OTP \340\244\270\340\244\276\340\244\235\340\244\276 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202, \340\244\232\340\244\276\340\244\271\340\245\207 \340\244\265\340\244\271 \340\244\254\340\245\210\340\244\202\340\244\225 \340\244\225\340\244\260\340\245\215\340\244\256\340\244\232\340\244\276\340\244\260\340\245\200 \340\244\271\340\245\200 \340\244\225\340\245\215\340\244\257\340\245\213\340\244\202 \340\244\250 \340\244\271\340\245\213\',\n        textMr: \'\340\244\225\340\245\213\340\244\243\340\244\276\340\244\266\340\245\200\340\244\271\340\245\200 OTP \340\244\266\340\245\207\340\244\205\340\244\260 \340\244\225\340\244\260\340\245\202 \340\244\250\340\244\225\340\244\276, \340\244\205\340\244\227\340\244\246\340\245\200 \340\244\254\340\244\201\340\244\225\340\245\207\340\244\232\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\245\215\340\244\256\340\244\232\340\244