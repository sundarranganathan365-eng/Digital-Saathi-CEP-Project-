          text: "            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              A buyer on an online marketplace (like OLX) sends you a QR code and says: <em>\"Scan this QR code and type your PIN to receive the advance payment.\"</em>"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            </p>"
