        lines {
          text: "        title: \'Safety by Design\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        desc: \'Focuses heavily on scam identification, OTP confidentiality, and UPI PIN rules to safeguard life savings.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
