        }
        lines {
          text: "    goldenRule: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      tag: \'THE ABSOLUTE GOLDEN RULE\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      title: \'Entering Your PIN Always SENDS (Debits) Money\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      subtitle: \'To RECEIVE money into your bank account, you NEVER need to enter your UPI PIN, scan a QR code, or accept a payment request.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rule1Title: \'Sending Money (You are paying someone)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rule1Desc: \'You MUST enter your 4 or 6-digit secret UPI PIN to authorize money leaving your account.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rule2Title: \'Receiving Money (Someone is paying you)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rule2Desc: \'Money arrives automatically into your bank account. You do NOT enter PIN, do NOT scan QR codes, and do NOT click approve.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    pinVsOtp: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      title: \'UPI PIN vs OTP (One-Time Password)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      pinTitle: \'UPI PIN (Personal Identification Number)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      pinDesc: \'Created by you during setup. Stays the same for every transaction. Never changes unless you reset it.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      pinAlert: \'Never share with anyone. Only typed on the secure black bank keyboard.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      otpTitle: \'OTP (One-Time Password)\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      otpDesc: \'Generated randomly by your bank and sent via SMS. Valid for only 5\342\200\22310 minutes for a single transaction.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      otpAlert: \'Never read out loud or share over phone calls, even if caller claims to be bank manager.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dosTitle: \'Summary: Digital Payments Safety Checklist\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    dos: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Always verify recipient name on screen before typing your PIN.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Check transaction confirmation SMS sent directly by your bank.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Keep your daily UPI transaction limit set to a safe amount in your banking app.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Cover your screen when typing PIN in crowded grocery stores.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    donts: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Never enter your UPI PIN to \"receive\", \"claim\", or \"refund\" money.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Never scan a QR code sent by a stranger on WhatsApp claiming to send advance payments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Never use simple PINs like 1111, 1234, or your birth year.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Never make payments while on a phone call with someone instructing you step-by-step.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nextCta: \'Next Module: Online Safety & Cyber Threat Defense\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
