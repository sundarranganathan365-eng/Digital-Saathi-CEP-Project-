        lines {
          text: "    s2: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tag: \'Concept 02\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Wi-Fi vs Mobile Cellular Data\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'Mobile Data uses your SIM card telecom plan. Wi-Fi connects wirelessly to home or office routers without consuming SIM card daily data limits.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      steps: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Home Wi-Fi: Safe and password-protected for high-speed browsing.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Mobile Data (4G/5G): Ideal for secure mobile banking and UPI payments.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Open Public Wi-Fi: Dangerous for banking because passwords can be intercepted.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    s3: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tag: \'Concept 03\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Screen Lock & PIN Hygiene (Why Weak PINs Fail)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'Never leave your phone unlocked. A 6-digit PIN, strong password, or biometric fingerprint prevents unauthorized access if your phone is lost or stolen.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      steps: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Set up a PIN or Fingerprint under Settings > Security > Screen Lock.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Avoid predictable PINs like 1234, 0000, or your birth year.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Set screen timeout to 30 seconds to lock automatically when not in use.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      badPinHeader: \'DANGEROUS & PREDICTABLE PIN PATTERNS (AVOID AT ALL COSTS):\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      badPins: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'1234 / 4321 / 123456\', reason: \'Sequential numbers are the #1 combination tested by phone thieves.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'0000 / 1111 / 9999\', reason: \'Repeated digits can be guessed in seconds by anyone holding the device.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'1985 / 2002 (Birth Year)\', reason: \'If your wallet is lost with ID cards (Aadhaar/PAN), thieves immediately test your birth year.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'2580 / 0852\', reason: \'Straight vertical/horizontal lines on the keypad are well-known shortcuts.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'Vehicle / House Number\', reason: \'Publicly visible numbers that acquaintances or strangers can easily discover.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        { code: \'Last 4 Digits of Mobile No.\', reason: \'Your phone number is printed on your SIM and delivery packages.\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      whyWeakPinsTitle: \'Why Weak PINs Are So Dangerous:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      whyWeakPinsDesc: \'Your smartphone is the master key to your digital life \342\200\224 containing your bank apps, Google Pay, PhonePe, and WhatsApp. If a thief or malicious bystander guesses your screen lock, they can bypass app security and drain bank accounts before you can report the phone missing.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      strongPinRuleTitle: \'The Golden Rules for a Strong Phone Lock:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      strongPinRules: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Use at least 6 random digits that have no connection to your personal life (not your birthday, anniversary, or bike number).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Combine with Biometric Fingerprint or Face Recognition for fast and secure daily unlocking.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Set the screen lock timer to \"Immediately\" or \"After 30 seconds of inactivity\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Never write down your lock PIN on a sticker pasted behind your phone case.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    sim: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tag: \'Critical Security Layer\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'SIM Card Lock & Eject Protection\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      subtitle: \'Why a phone screen lock is NOT enough \342\200\224 protect your SIM against physical ejection theft.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      threatTitle: \'The Hidden Attack: Physical SIM Ejection Theft\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      threatDesc: \'Most people believe their screen lock makes their phone 100% safe. However, if a thief steals your smartphone, they can use a safety pin or SIM ejector tool to remove your SIM card in 5 seconds and insert it into their own unlocked phone.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      threatPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'The thief puts your SIM card into their phone \342\200\224 your telecom network immediately activates.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'They install PhonePe, Google Pay, or WhatsApp using your phone number.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'When they tap \"Forgot UPI PIN\", the Bank OTP arrives directly on their phone via your stolen SIM!\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'They drain your bank accounts without ever needing to unlock your original smartphone.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      defenseTitle: \'The Ultimate Defense: Enable SIM Card Lock PIN\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      defenseDesc: \'When SIM Lock is turned on, the SIM card itself is locked with a secret 4-digit PIN. If anyone ejects the SIM and inserts it into ANY other device (or reboots the phone), the SIM will remain completely dead and inactive until the SIM PIN is entered.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsTitle: \'How to Enable SIM Card Lock:\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsAndroid: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        platform: \'Android Setup (Samsung, Xiaomi, Vivo, Realme, OnePlus, etc.)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        steps: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Open Settings \342\236\224 Security & Privacy (or Passwords & Security).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Scroll down and tap \"More Security Settings\" (or \"System Security\").\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Tap \"SIM Card Lock\" (or \"Set up SIM card lock\").\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Toggle ON \"Lock SIM Card\". Enter your current telecom default PIN (usually 0000 or 1234).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Tap \"Change SIM PIN\" and set a brand-new secret 4-digit PIN known only to you.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      stepsIos: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        platform: \'iPhone Setup (Apple iOS)\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        steps: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Open Settings \342\236\224 Cellular (or Mobile Data).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Tap \"SIM PIN\".\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Turn ON \"SIM PIN\". Enter the default PIN (usually 0000 or 1234).\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          \'Tap \"Change PIN\" and enter your new personal 4-digit PIN.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      pukWarning: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        title: \'Crucial Telecom Warning: Default PINs & PUK Code\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        desc: \'Default telecom SIM PINs are typically 0000 or 1234 for Jio, Airtel, Vi, and BSNL. You MUST change this default immediately to your own secret code. Important: If you enter the wrong SIM PIN 3 times, the SIM is temporarily blocked and asks for an 8-digit PUK (Personal Unblocking Key) code. You can easily view your PUK code inside your telecom app (Airtel Thanks, MyJio, Vi App) or by calling customer care. Keep your PUK code noted safely in a physical notebook at home.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    i1: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tag: \'Safe Browsing\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'How to Search the Web Safely\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'When using Google or web browsers, learn how to distinguish between genuine search results and sponsored advertisements.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      points: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Watch out for \"Sponsored\" or \"Ad\" tags on top of search results. Scammers pay for ads to promote fake helpline numbers.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Always check the website domain. Indian government sites end with .gov.in, banks have official registered domains.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Look for the secure padlock icon in the browser address bar before typing passwords.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    i2: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      tag: \'Link Hygiene\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      title: \'Never Click Unknown Links\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      desc: \'Malicious links received via SMS, WhatsApp, or email are designed to hijack accounts or trigger silent file downloads.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      points: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Do not click links offering free gifts, lottery wins, or subsidized government laptops.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'Do not open file attachments ending with .apk or .exe from unknown senders.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        \'If a friend sends a weird link saying \"Is this you?\", verify with them on a phone call first.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
