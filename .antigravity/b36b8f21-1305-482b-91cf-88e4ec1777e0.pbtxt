        }
        lines {
          text: "        title: \'Enter Your Secret UPI PIN\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        desc: \'Type your 4-digit or 6-digit UPI PIN on the secure black keyboard.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        tip: \'Shield your phone screen so bystanders or store clerks cannot observe your PIN digits.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
