    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  Building2,\n  FileCheck,\n  ShieldCheck,\n  ExternalLink,\n  Lock,\n  ArrowRight,\n  AlertTriangle,\n  FileText,\n  Search,\n  CheckCircle2,\n} from \'lucide-react\';\n\ninterface ServicesPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const ServicesPage: React.FC<ServicesPageProps> = ({ setCurrentPage, language }) => {\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Module 04\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">Civic & Public Portals</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          Digital Public Services & DigiLocker\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          Safely navigate official Indian public services, understand how DigiLocker legally stores your certificates, protect your Aadhaar identity, and fill online application forms securely.\n        </p>\n      </div>\n\n      {/* Educational Notice Banner */}\n      <div className=\"p-4 bg-amber-50 border border-amber-200 rounded text-xs text-amber-900 flex items-start gap-3\">\n        <AlertTriangle className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n        <div>\n          <strong className=\"block font-bold\">Important Educational Disclaimer:</strong>\n          <span>\n            Digital Saathi is strictly an open-source educational awareness portal. We never collect, process, or store your official documents or credentials. All external links provided below redirect exclusively to verified official government portals.\n          </span>\n        </div>\n      </div>\n\n      {/* 1. DigiLocker Deep Dive */}\n      <section className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-10 space-y-8\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          <div className=\"lg:col-span-7 space-y-4\">\n            <div className=\"inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-[#171717] bg-[#FAF9F6] border border-[#E5E5E5] rounded\">\n              <FileCheck className=\"w-3.5 h-3.5\" />\n              <span>Digital Document Storage</span>\n            </div>\n            <h2 className=\"text-2xl sm:text-3xl font-bold text-[#171717] font-editorial\">\n              What is DigiLocker?\n            </h2>\n            <p className=\"text-sm text-[#525252] leading-relaxed\">\n              <strong>DigiLocker</strong> is a flagship initiative under Digital India by the Ministry of Electronics and Information Technology (MeitY). It provides citizens with a secure, cloud-based platform to access authentic digital documents directly from issuing government authorities.\n            </p>\n            <div className=\"space-y-2.5 text-xs sm:text-sm text-[#333333]\">\n              <div className=\"flex items-start gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                <span>\n                  <strong>Legal Recognition:</strong> Issued documents in DigiLocker are treated at par with original physical documents under Rule 9A of Information Technology Rules, 2016.\n                </span>\n              </div>\n              <div className=\"flex items-start gap-2\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                <span>\n                  <strong>Available Documents:</strong> Aadhaar Card, Driving License, Vehicle Registration (RC), COVID Certificates, Class 10 & 12 Marksheets, PAN Card, and Pension Documents.\n                </span>\n              </div>\n            </div>\n\n            <div className=\"pt-2\">\n              <a\n                href=\"https://www.digilocker.gov.in\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"inline-flex items-center gap-2 px-4 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors\"\n              >\n                <span>Visit Official DigiLocker (digilocker.gov.in)</span>\n                <ExternalLink className=\"w-3.5 h-3.5\" />\n              </a>\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-5 p-6 border border-[#E5E5E5] rounded bg-[#FAF9F6] space-y-4\">\n            <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block\">\n              How to Sign Up for DigiLocker Safely\n            </span>\n            <div className=\"space-y-3 text-xs text-[#404040]\">\n              <div className=\"p-3 bg-white border border-[#E5E5E5] rounded\">\n                <strong className=\"text-[#171717] block mb-0.5\">1. Aadhaar Linked Phone Number</strong>\n                <span>Ensure your mobile number is updated in your Aadhaar record to receive OTP verification.</span>\n              </div>\n              <div className=\"p-3 bg-white border border-[#E5E5E5] rounded\">\n                <strong className=\"text-[#171717] block mb-0.5\">2. Set a 6-Digit Security PIN</strong>\n                <span>Create a memorable 6-digit PIN that you do not share with anyone else.</span>\n              </div>\n              <div className=\"p-3 bg-white border border-[#E5E5E5] rounded\">\n                <strong className=\"text-[#171717] block mb-0.5\">3. Pull Documents from Issuers</strong>\n                <span>Search for transport departments or education boards to fetch authentic digital copies.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. Identifying Genuine Government Portals (.gov.in vs Fake Domains) */}\n      <section className=\"space-y-6\">\n        <div>\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Domain Verification\n          </span>\n          <h2 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            How to Safely Identify Official Government Websites\n          </h2>\n          <p className=\"text-xs sm:text-sm text-[#525252]\">\n            Never trust a website just because it uses the national emblem or tricolor background. Look at the address bar!\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          <div className=\"p-6 border border-emerald-300 bg-white rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-emerald-800 font-bold text-sm\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n              <span>OFFICIAL GOVERNMENT DOMAINS</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n              Official Indian Central and State government websites are strictly hosted under reserved national second-level domains:\n            </p>\n            <div className=\"space-y-2 font-mono text-xs text-[#171717]\">\n              <div className=\"p-2.5 bg-emerald-50 border border-emerald-200 rounded\">\n                <strong>*.gov.in</strong> \342\200\224 (e.g. passportindia.gov.in, uidai.gov.in)\n              </div>\n              <div className=\"p-2.5 bg-emerald-50 border border-emerald-200 rounded\">\n                <strong>*.nic.in</strong> \342\200\224 National Informatics Centre (e.g. epfindia.gov.in)\n              </div>\n            </div>\n          </div>\n\n          <div className=\"p-6 border border-red-300 bg-white rounded-sm space-y-3\">\n            <div className=\"flex items-center gap-2 text-red-800 font-bold text-sm\">\n              <AlertTriangle className=\"w-4 h-4 text-red-700\" />\n              <span>SUSPICIOUS IMITATION DOMAINS</span>\n            </div>\n            <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed\">\n              Cyber criminals purchase cheap domains to mimic government subsidy schemes, PM-Kisan funds, or passport services:\n            </p>\n            <div className=\"space-y-2 font-mono text-xs text-red-900\">\n              <div className=\"p-2.5 bg-red-50 border border-red-200 rounded\">\n                <strong>*.gov.in.xyz</strong> or <strong>pm-kisan-apply.online</strong> \342\234\227\n              </div>\n              <div className=\"p-2.5 bg-red-50 border border-red-200 rounded\">\n                <strong>rationcard-update.blogspot.com</strong> \342\234\227\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. Masked Aadhaar & Identity Protection */}\n      <section className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-10 space-y-6\">\n        <div className=\"max-w-2xl\">\n          <span className=\"text-xs font-semibold uppercase tracking-wider text-[#737373] block mb-1\">\n            Privacy Practice\n          </span>\n          <h3 className=\"text-2xl font-bold text-[#171717] font-editorial\">\n            The Safe Practice of \"Masked Aadhaar\"\n          </h3>\n          <p className=\"text-xs sm:text-sm text-[#525252] mt-1 leading-relaxed\">\n            When you need to provide an Aadhaar photocopy for hotel check-ins, SIM card purchase, or delivery verification, never hand over an unmasked copy without notation.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          <div className=\"p-5 border border-[#E5E5E5] rounded bg-[#FAF9F6] space-y-2\">\n            <span className=\"text-xs font-mono font-bold text-[#171717]\">1. Download Masked Copy</span>\n            <p className=\"text-xs text-[#525252]\">\n              On UIDAI\342\200\231s official website (<code>myaadhaar.uidai.gov.in</code>), check the box <em>\342\200\234Do you want a Masked Aadhaar?\342\200\235</em> before downloading.\n            </p>\n          </div>\n\n          <div className=\"p-5 border border-[#E5E5E5] rounded bg-[#FAF9F6] space-y-2\">\n            <span className=\"text-xs font-mono font-bold text-[#171717]\">2. Conceals First 8 Digits</span>\n            <p className=\"text-xs text-[#525252]\">\n              It displays only the last 4 digits (e.g. <code>XXXX-XXXX-1234</code>), which is legally accepted for identity proof while safeguarding your full number.\n            </p>\n          </div>\n\n          <div className=\"p-5 border border-[#E5E5E5] rounded bg-[#FAF9F6] space-y-2\">\n            <span className=\"text-xs font-mono font-bold text-[#171717]\">3. Cross-Sign With Purpose</span>\n            <p className=\"text-xs text-[#525252]\">\n              Draw two diagonal lines across the photocopy and write: <em>\342\200\234Submitted only for [Sim Card / Hotel / Job] on [Date]\342\200\235</em>.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* 4. Filling Online Forms Safely */}\n      <section className=\"p-6 sm:p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-4\">\n        <h3 className=\"text-xl font-bold text-[#171717] font-editorial\">\n          Precautions When Submitting Online Forms\n        </h3>\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-[#404040]\">\n          <div className=\"p-3.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded flex items-start gap-2.5\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n            <span>Never enter bank account passwords or ATM PINs into general job or scholarship inquiry forms.</span>\n          </div>\n          <div className=\"p-3.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded flex items-start gap-2.5\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n            <span>Always double-check the fee payment gateway (e.g. SBI ePay, Razorpay, BillDesk) before paying application fees.</span>\n          </div>\n          <div className=\"p-3.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded flex items-start gap-2.5\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n            <span>Download and save the PDF confirmation receipt with application ID immediately after form submission.</span>\n          </div>\n          <div className=\"p-3.5 bg-[#FAF9F6] border border-[#E5E5E5] rounded flex items-start gap-2.5\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n            <span>Log out from shared public computers at cyber cafes immediately after finishing your application.</span>\n          </div>\n        </div>\n      </section>\n\n      {/* Next Module Navigation Link */}\n      <div className=\"pt-8 border-t border-[#E5E5E5] flex items-center justify-between\">\n        <button\n          onClick={() => { setCurrentPage(\'safety\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"text-xs font-semibold text-[#737373] hover:text-[#171717] transition-colors\"\n        >\n          \342\206\220 Previous: Module 03 (Online Safety)\n        </button>\n\n        <button\n          id=\"btn-next-module-quiz\"\n          onClick={() => { setCurrentPage(\'quiz\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors shadow-xs\"\n        >\n          <span>Continue to Module 05: Knowledge Test (Quiz)</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
