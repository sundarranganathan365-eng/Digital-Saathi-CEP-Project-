        lines {
          text: "    title: \'About Digital Saathi\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    subtitle: \'An open-source educational platform created as a 3rd-Year BSc Computer Science Community Engagement Project (CEP) on the theme: \342\200\234Building Open-Source Solutions for Social Problems.\342\200\235\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    missionTitle: \'Our Mission & Motivation\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    missionDesc: \'India\342\200\231s rapid digital transformation has revolutionized banking, governance, and daily communication. However, millions of senior citizens, parents, and first-time internet adopters face acute anxiety, digital exclusion, and vulnerability to financial fraud. Digital Saathi bridges this gap through dignified, jargon-free education.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
