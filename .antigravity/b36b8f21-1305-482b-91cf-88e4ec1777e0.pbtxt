          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        title: \'Transaction Confirmation\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        desc: \'A green checkmark will appear with the transaction reference number and bank confirmation SMS.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        tip: \'Wait for the sound confirmation box or show the green tick screen to the merchant.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
