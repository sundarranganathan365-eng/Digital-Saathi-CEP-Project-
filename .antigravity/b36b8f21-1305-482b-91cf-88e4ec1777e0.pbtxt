        }
        lines {
          text: "      ],"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "      defense: \'Never click links in unexpected SMS messages. Always open your browser and type the bank address manually or check with your branch.\',"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
