  file_change {
    absolute_path_uri: "file:///src/pages/QuizPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language, QuizQuestion } from \'../types\';\nimport { quizQuestions } from \'../data/quizQuestions\';\nimport {\n  HelpCircle,\n  CheckCircle2,\n  XCircle,\n  RotateCcw,\n  ArrowRight,\n  ShieldCheck,\n  Award,\n  BookOpen,\n} from \'lucide-react\';\n\ninterface QuizPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst quizPageTranslations = {\n  en: {\n    moduleTag: \'Module 05\',\n    categoryTag: \'Interactive Assessment\',\n    title: \'Digital Literacy & Safety Quiz\',\n    subtitle: \'Evaluate your knowledge on UPI payments, password security, fake SMS alerts, and DigiLocker public services. Instant scoring with rationale provided.\',\n    questionLabel: \'Question\',\n    ofLabel: \'of\',\n    categoryLabels: {\n      basics: \'Digital Basics\',\n      payments: \'Digital Payments\',\n      safety: \'Online Safety\',\n      services: \'Public Services\',\n    },\n    submitPrompt: \'Select an answer to reveal explanation:\',\n    correctBanner: \'Correct Answer!\',\n    incorrectBanner: \'Incorrect \342\200\224 Review the Explanation:\',\n    explanationTitle: \'Key Safety Learning:\',\n    nextQuestion: \'Next Question\',\n    seeResults: \'See Final Results\',\n    results: {\n      title: \'Assessment Complete!\',\n      yourScore: \'Your Final Score:\',\n      outOf: \'out of 10 questions correct\',\n      highScoreMsg: \'Excellent! You possess a solid foundation in digital safety and literacy.\',\n      midScoreMsg: \'Good effort! Review the modules you found challenging to strengthen your safety reflexes.\',\n      lowScoreMsg: \'We recommend reading through the Digital Basics and Safety modules again.\',\n      btnRetake: \'Retake Quiz\',\n      btnReviewModules: \'Return to Home\',\n    },\n  },\n  hi: {\n    moduleTag: \'\340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 05\',\n    categoryTag: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\256\340\245\202\340\244\262\340\245\215\340\244\257\340\244\276\340\244\202\340\244\225\340\244\250\',\n    title: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\225\340\245\215\340\244\265\340\244\277\340\244\234\340\244\274 (Quiz)\',\n    subtitle: \'UPI \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250, \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276, \340\244\253\340\244\260\340\245\215\340\244\234\340\245\200 SMS \340\244\252\340\244\271\340\244\232\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\252\340\244\260 \340\244\206\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 10 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\245\213\340\244\202 \340\244\225\340\245\200 \340\244\205\340\244\255\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\252\340\244\260\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\246\340\245\207\340\244\202\340\245\244 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 \340\244\224\340\244\260 \340\244\225\340\244\276\340\244\260\340\244\243 \340\244\270\340\244\271\340\244\277\340\244\244 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\340\245\244\',\n    questionLabel: \'\340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\',\n    ofLabel: \'\340\244\225\340\245\201\340\244\262\',\n    categoryLabels: {\n      basics: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202\',\n      payments: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 (UPI)\',\n      safety: \'\340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n      services: \'\340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n    },\n    submitPrompt: \'\340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \340\244\246\340\245\207\340\244\226\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\217\340\244\225 \340\244\265\340\244\277\340\244\225\340\244\262\340\245\215\340\244\252 \340\244\232\340\245\201\340\244\250\340\245\207\340\244\202:\',\n    correctBanner: \'\340\244\254\340\244\277\340\244\262\340\245\215\340\244\225\340\245\201\340\244\262 \340\244\270\340\244\271\340\245\200 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260!\',\n    incorrectBanner: \'\340\244\227\340\244\262\340\244\244 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \342\200\224 \340\244\225\340\244\276\340\244\260\340\244\243 \340\244\270\340\244\256\340\244\235\340\245\207\340\244\202:\',\n    explanationTitle: \'\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\270\340\245\200\340\244\226:\',\n    nextQuestion: \'\340\244\205\340\244\227\340\244\262\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\',\n    seeResults: \'\340\244\205\340\244\202\340\244\244\340\244\277\340\244\256 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202\',\n    results: {\n      title: \'\340\244\225\340\245\215\340\244\265\340\244\277\340\244\234\340\244\274 \340\244\252\340\245\202\340\244\260\340\244\276 \340\244\271\340\245\201\340\244\206!\',\n      yourScore: \'\340\244\206\340\244\252\340\244\225\340\244\276 \340\244\225\340\245\201\340\244\262 \340\244\270\340\245\215\340\244\225\340\245\213\340\244\260:\',\n      outOf: \'10 \340\244\256\340\245\207\340\244\202 \340\244\270\340\245\207 \340\244\270\340\244\271\340\245\200 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\',\n      highScoreMsg: \'\340\244\211\340\244\244\340\245\215\340\244\225\340\245\203\340\244\267\340\245\215\340\244\237! \340\244\206\340\244\252\340\244\225\340\245\207 \340\244\252\340\244\276\340\244\270 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\224\340\244\260 \340\244\262\340\245\207\340\244\250\340\244\246\340\245\207\340\244\250 \340\244\225\340\245\200 \340\244\254\340\244\271\340\245\201\340\244\244 \340\244\205\340\244\232\340\245\215\340\244\233\340\245\200 \340\244\270\340\244\256\340\244\235 \340\244\271\340\245\210\340\245\244\',\n      midScoreMsg: \'\340\244\205\340\244\232\340\245\215\340\244\233\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\257\340\244\276\340\244\270! \340\244\205\340\244\252\340\244\250\340\245\200 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\225\340\245\213 \340\244\224\340\244\260 \340\244\256\340\244\234\340\244\254\340\245\202\340\244\244 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\211\340\244\250 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262\340\245\215\340\244\270 \340\244\225\340\245\213 \340\244\246\340\245\213\340\244\254\340\244\276\340\244\260\340\244\276 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202 \340\244\234\340\244\271\340\244\276\340\244\201 \340\244\227\340\244\262\340\244\244\340\245\200 \340\244\271\340\245\201\340\244\210\340\245\244\',\n      lowScoreMsg: \'\340\244\271\340\244\256 \340\244\205\340\244\250\340\245\201\340\244\266\340\244\202\340\244\270\340\244\276 \340\244\225\340\244\260\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\225\340\244\277 \340\244\206\340\244\252 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\254\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\340\244\246\340\245\200 \340\244\254\340\244\276\340\244\244\340\245\207\340\244\202 \340\244\224\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\244\225\340\245\213 \340\244\217\340\244\225 \340\244\254\340\244\276\340\244\260 \340\244\253\340\244\277\340\244\260 \340\244\247\340\245\215\340\244\257\340\244\276\340\244\250 \340\244\270\340\245\207 \340\244\252\340\244\242\340\244\274\340\245\207\340\244\202\340\245\244\',\n      btnRetake: \'\340\244\225\340\245\215\340\244\265\340\244\277\340\244\234\340\244\274 \340\244\253\340\244\277\340\244\260 \340\244\270\340\245\207 \340\244\246\340\245\207\340\244\202\',\n      btnReviewModules: \'\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\245\203\340\244\267\340\245\215\340\244\240 \340\244\252\340\244\260 \340\244\262\340\245\214\340\244\237\340\245\207\340\244\202\',\n    },\n  },\n  mr: {\n    moduleTag: \'\340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 \340\245\246\340\245\253\',\n    categoryTag: \'\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200\',\n    title: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\244\276\340\244\225\340\245\215\340\244\267\340\244\260\340\244\244\340\244\276 \340\244\265 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200 (\340\244\225\340\245\215\340\244\265\340\244\277\340\244\235)\',\n    subtitle: \'UPI \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270, \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276, \340\244\254\340\244\250\340\244\276\340\244\265\340\244\237 SMS \340\244\206\340\244\243\340\244\277 \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260\340\244\265\340\244\260 \340\244\206\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 \340\245\247\340\245\246 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\244\276\340\244\202\340\244\232\340\245\200 \340\244\270\340\245\213\340\244\252\340\245\200 \340\244\252\340\244\260\340\245\200\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\246\340\245\215\340\244\257\340\244\276. \340\244\244\340\244\276\340\244\244\340\245\215\340\244\225\340\244\276\340\244\263 \340\244\227\340\245\201\340\244\243 \340\244\206\340\244\243\340\244\277 \340\244\225\340\244\276\340\244\260\340\244\243\340\244\276\340\244\270\340\244\271 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260\340\245\207 \340\244\252\340\244\271\340\244\276.\',\n    questionLabel: \'\340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\',\n    ofLabel: \'\340\244\252\340\245\210\340\244\225\340\245\200\',\n    categoryLabels: {\n      basics: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\256\340\245\202\340\244\262\340\244\255\340\245\202\340\244\244 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200\',\n      payments: \'\340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\252\340\245\207\340\244\256\340\245\207\340\244\202\340\244\237\340\245\215\340\244\270 (UPI)\',\n      safety: \'\340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276\',\n      services: \'\340\244\266\340\244\276\340\244\270\340\244\225\340\245\200\340\244\257 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\',\n    },\n    submitPrompt: \'\340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \340\244\244\340\244\252\340\244\276\340\244\270\340\244\243\340\245\215\340\244\257\340\244\276\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\217\340\244\225 \340\244\252\340\244\260\340\245\215\340\244\257\340\244\276\340\244\257 \340\244\250\340\244\277\340\244\265\340\244\241\340\244\276:\',\n    correctBanner: \'\340\244\205\340\244\227\340\244\246\340\245\200 \340\244\254\340\244\260\340\245\213\340\244\254\340\244\260 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260!\',\n    incorrectBanner: \'\340\244\232\340\245\202\340\244\225 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260 \342\200\224 \340\244\270\340\245\215\340\244\252\340\244\267\340\245\215\340\244\237\340\245\200\340\244\225\340\244\260\340\244\243 \340\244\265\340\244\276\340\244\232\340\244\276:\',\n    explanationTitle: \'\340\244\256\340\244\271\340\244\244\340\245\215\340\244\244\340\245\215\340\244\265\340\244\276\340\244\232\340\245\200 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\266\340\244\277\340\244\225\340\244\265\340\244\243:\',\n    nextQuestion: \'\340\244\252\340\245\201\340\244\242\340\245\200\340\244\262 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\',\n    seeResults: \'\340\244\205\340\244\202\340\244\244\340\244\277\340\244\256 \340\244\250\340\244\277\340\244\225\340\244\276\340\244\262 \340\244\252\340\244\271\340\244\276\',\n    results: {\n      title: \'\340\244\232\340\244\276\340\244\232\340\244\243\340\245\200 \340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\235\340\244\276\340\244\262\340\245\200!\',\n      yourScore: \'\340\244\244\340\245\201\340\244\256\340\244\232\340\245\207 \340\244\217\340\244\225\340\245\202\340\244\243 \340\244\227\340\245\201\340\244\243:\',\n      outOf: \'\340\245\247\340\245\246 \340\244\252\340\245\210\340\244\225\340\245\200 \340\244\254\340\244\260\340\245\213\340\244\254\340\244\260 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260\340\245\207\',\n      highScoreMsg: \'\340\244\211\340\244\244\340\245\215\340\244\225\340\245\203\340\244\267\340\245\215\340\244\237! \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\244\276\340\244\262\340\244\276 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260 \340\244\206\340\244\243\340\244\277 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\245\207\340\244\232\340\245\200 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\256 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200 \340\244\206\340\244\271\340\245\207.\',\n      midScoreMsg: \'\340\244\233\340\244\276\340\244\250 \340\244\252\340\245\215\340\244\260\340\244\257\340\244\244\340\245\215\340\244\250! \340\244\234\340\245\215\340\244\257\340\244\276 \340\244\252\340\245\215\340\244\260\340\244\266\340\245\215\340\244\250\340\244\276\340\244\202\340\244\232\340\245\200 \340\244\211\340\244\244\340\245\215\340\244\244\340\244\260\340\245\207 \340\244\232\340\245\201\340\244\225\340\244\262\340\245\200 \340\244\244\340\245\215\340\244\257\340\244\276 \340\244\265\340\244\277\340\244\267\340\244\257\340\244\276\340\244\202\340\244\232\340\245\200 \340\244\211\340\244\234\340\244\263\340\244\243\340\245\200 \340\244\250\340\244\225\340\245\215\340\244\225\340\245\200 \340\244\225\340\244\260\340\244\276.\',\n      lowScoreMsg: \'\340\244\206\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\270\340\245\201\340\244\232\340\244\265\340\244\244\340\245\213 \340\244\225\340\245\200 \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\256\340\245\202\340\244\262\340\244\255\340\245\202\340\244\244 \340\244\256\340\244\276\340\244\271\340\244\277\340\244\244\340\245\200 \340\244\206\340\244\243\340\244\277 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\265\340\244\277\340\244\255\340\244\276\340\244\227 \340\244\252\340\245\201\340\244\250\340\245\215\340\244\271\340\244\276 \340\244\217\340\244\225\340\244\246\340\244\276 \340\244\225\340\244\276\340\244\263\340\244\234\340\245\200\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\265\340\244\276\340\244\232\340\244\276.\',\n      btnRetake: \'\340\244\252\340\245\201\340\244\250\340\245\215\340\244\271\340\244\276 \340\244\232\340\244\276\340\244\232\340\244\243\340\245\200 \340\244\246\340\245\215\340\244\257\340\244\276\',\n      btnReviewModules: \'\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\244\276\340\244\250\340\244\276\340\244\265\340\244\260 \340\244\234\340\244\276\',\n    },\n  },\n};\n\nexport const QuizPage: React.FC<QuizPageProps> = ({ setCurrentPage, language }) => {\n  const [currentIdx, setCurrentIdx] = useState<number>(0);\n  const [selectedOption, setSelectedOption] = useState<number | null>(null);\n  const [answers, setAnswers] = useState<{ [key: number]: number }>({});\n  const [isFinished, setIsFinished] = useState<boolean>(false);\n\n  const t = quizPageTranslations[language];\n  const q: QuizQuestion = quizQuestions[currentIdx];\n\n  const getLocalizedQuestion = (item: QuizQuestion) => {\n    if (language === \'hi\' && item.questionHi) return item.questionHi;\n    if (language === \'mr\' && item.questionMr) return item.questionMr;\n    return item.question;\n  };\n\n  const getLocalizedOptionText = (opt: QuizQuestion[\'options\'][0]) => {\n    if (language === \'hi\' && opt.textHi) return opt.textHi;\n    if (language === \'mr\' && opt.textMr) return opt.textMr;\n    return opt.text;\n  };\n\n  const getLocalizedExplanation = (item: QuizQuestion) => {\n    if (language === \'hi\' && item.explanationHi) return item.explanationHi;\n    if (language === \'mr\' && item.explanationMr) return item.explanationMr;\n    return item.explanation;\n  };\n\n  const handleSelectOption = (idx: number) => {\n    if (selectedOption !== null) return; // already answered this question\n    setSelectedOption(idx);\n    setAnswers((prev) => ({ ...prev, [currentIdx]: idx }));\n  };\n\n  const handleNext = () => {\n    if (currentIdx < quizQuestions.length - 1) {\n      const nextIdx = currentIdx + 1;\n      setCurrentIdx(nextIdx);\n      setSelectedOption(answers[nextIdx] !== undefined ? answers[nextIdx] : null);\n    } else {\n      setIsFinished(true);\n      window.scrollTo({ top: 0, behavior: \'smooth\' });\n    }\n  };\n\n  const handleRestart = () => {\n    setCurrentIdx(0);\n    setSelectedOption(null);\n    setAnswers({});\n    setIsFinished(false);\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  const calculateScore = () => {\n    let score = 0;\n    quizQuestions.forEach((ques, idx) => {\n      const userAns = answers[idx];\n      if (userAns !== undefined && ques.options[userAns]?.isCorrect) {\n        score++;\n      }\n    });\n    return score;\n  };\n\n  if (isFinished) {\n    const score = calculateScore();\n    return (\n      <div className=\"max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20 animate-in fade-in duration-200\">\n        <div className=\"p-8 sm:p-12 border border-[#E5E5E5] bg-white rounded-sm text-center space-y-6 shadow-xs\">\n          <div className=\"w-16 h-16 rounded-full bg-emerald-100 text-emerald-800 mx-auto flex items-center justify-center\">\n            <Award className=\"w-8 h-8\" />\n          </div>\n\n          <div>\n            <span className=\"text-xs font-mono font-bold tracking-wider uppercase text-[#737373] block mb-1\">\n              {t.results.title}\n            </span>\n            <h2 className=\"text-3xl font-bold text-[#171717] font-editorial\">\n              {t.results.yourScore}\n            </h2>\n            <div className=\"text-5xl font-extrabold text-[#171717] my-4 font-mono\">\n              {score} <span className=\"text-2xl text-[#737373] font-normal\">/ {quizQuestions.length}</span>\n            </div>\n            <p className=\"text-sm text-[#525252] max-w-md mx-auto\">\n              {score >= 8 ? t.results.highScoreMsg : score >= 5 ? t.results.midScoreMsg : t.results.lowScoreMsg}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center justify-center gap-4 pt-4 border-t border-[#F0F0EE]\">\n            <button\n              id=\"quiz-btn-retake\"\n              onClick={handleRestart}\n              className=\"inline-flex items-center gap-2 px-6 py-3 bg-[#171717] text-white text-sm font-semibold rounded hover:bg-[#333333] transition-colors\"\n            >\n              <RotateCcw className=\"w-4 h-4\" />\n              <span>{t.results.btnRetake}</span>\n            </button>\n            <button\n              id=\"quiz-btn-home\"\n              onClick={() => {\n                setCurrentPage(\'home\');\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"inline-flex items-center gap-2 px-6 py-3 bg-white text-[#171717] border border-[#D4D4D4] hover:bg-[#F5F5F4] text-sm font-semibold rounded transition-colors\"\n            >\n              <BookOpen className=\"w-4 h-4\" />\n              <span>{t.results.btnReviewModules}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  const isAnswered = selectedOption !== null;\n  const isOptionCorrect = isAnswered && q.options[selectedOption]?.isCorrect;\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10\">\n      {/* Header / Intro */}\n      <div className=\"border-b border-[#E5E5E5] pb-6\">\n        <div className=\"flex items-center gap-2 mb-2\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#171717] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            {t.moduleTag}\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">{t.categoryTag}</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl font-bold tracking-tight text-[#171717] font-editorial\">\n          {t.title}\n        </h1>\n        <p className=\"text-sm sm:text-base text-[#525252] mt-2\">\n          {t.subtitle}\n        </p>\n      </div>\n\n      {/* Progress & Category Bar */}\n      <div className=\"flex items-center justify-between text-xs border-b border-[#F0F0EE] pb-3\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"font-mono font-bold text-[#171717]\">\n            {t.questionLabel} {currentIdx + 1} {t.ofLabel} {quizQuestions.length}\n          </span>\n          <span className=\"text-[#A3A3A3]\">\342\200\242</span>\n          <span className=\"text-[#737373] font-medium uppercase\">\n            {t.categoryLabels[q.category] || q.category}\n          </span>\n        </div>\n        {/* Visual Progress Bar */}\n        <div className=\"w-32 h-2 bg-[#E5E5E5] rounded-full overflow-hidden\">\n          <div\n            className=\"h-full bg-[#171717] transition-all duration-300\"\n            style={{ width: `${((currentIdx + 1) / quizQuestions.length) * 100}%` }}\n          />\n        </div>\n      </div>\n\n      {/* Question Box */}\n      <div className=\"p-6 sm:p-8 border border-[#E5E5E5] bg-white rounded-sm space-y-6\">\n        <h3 className=\"text-lg sm:text-xl font-bold text-[#171717] leading-snug\">\n          {getLocalizedQuestion(q)}\n        </h3>\n\n        {/* Options */}\n        <div className=\"space-y-3\">\n          {q.options.map((opt, idx) => {\n            const isSelected = selectedOption === idx;\n            let optionStyles = \'border-[#E5E5E5] bg-white hover:border-[#737373] text-[#333333]\';\n\n            if (isAnswered) {\n              if (opt.isCorrect) {\n                optionStyles = \'border-emerald-500 bg-emerald-50 text-emerald-950 font-medium\';\n              } else if (isSelected && !opt.isCorrect) {\n                optionStyles = \'border-red-500 bg-red-50 text-red-950 font-medium\';\n              } else {\n                optionStyles = \'border-[#E5E5E5] bg-gray-50 opacity-60 text-gray-500\';\n              }\n            }\n\n            return (\n              <button\n                key={idx}\n                id={`quiz-option-${currentIdx}-${idx}`}\n                disabled={isAnswered}\n                onClick={() => handleSelectOption(idx)}\n                className={`w-full p-4 border rounded text-left text-xs sm:text-sm transition-all flex items-start justify-between gap-3 ${optionStyles}`}\n              >\n                <div className=\"flex items-start gap-3\">\n                  <span className=\"w-5 h-5 rounded-full border border-current flex items-center justify-center text-[11px] font-mono shrink-0 mt-0.5\">\n                    {String.fromCharCode(65 + idx)}\n                  </span>\n                  <span>{getLocalizedOptionText(opt)}</span>\n                </div>\n\n                {isAnswered && (\n                  <div className=\"shrink-0 mt-0.5\">\n                    {opt.isCorrect && <CheckCircle2 className=\"w-5 h-5 text-emerald-600\" />}\n                    {isSelected && !opt.isCorrect && <XCircle className=\"w-5 h-5 text-red-600\" />}\n                  </div>\n                )}\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Answer Breakdown Explanation */}\n        {isAnswered && (\n          <div className=\"p-5 border border-[#E5E5E5] bg-[#FAF9F6] rounded space-y-2 animate-in fade-in duration-200\">\n            <div className=\"flex items-center gap-2\">\n              {isOptionCorrect ? (\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-emerald-800\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n                  <span>{t.correctBanner}</span>\n                </div>\n              ) : (\n                <div className=\"flex items-center gap-1.5 text-xs font-bold text-red-800\">\n                  <XCircle className=\"w-4 h-4 text-red-600\" />\n                  <span>{t.incorrectBanner}</span>\n                </div>\n              )}\n            </div>\n\n            <p className=\"text-xs sm:text-sm text-[#333333] leading-relaxed pt-1\">\n              <strong>{t.explanationTitle} </strong>\n              {getLocalizedExplanation(q)}\n            </p>\n\n            <div className=\"flex justify-end pt-4\">\n              <button\n                id=\"quiz-btn-next\"\n                onClick={handleNext}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors\"\n              >\n                <span>{currentIdx < quizQuestions.length - 1 ? t.nextQuestion : t.seeResults}</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
