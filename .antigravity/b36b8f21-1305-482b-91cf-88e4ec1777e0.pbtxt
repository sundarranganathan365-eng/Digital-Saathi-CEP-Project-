        lines {
          text: "    question: \'When installing a simple Torch / Flashlight app, it requests permission to access your \"Contacts, SMS, and Microphone\". What should you do?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionHi: \'\340\244\217\340\244\225 \340\244\270\340\244\276\340\244\247\340\244\276\340\244\260\340\244\243 \340\244\237\340\245\211\340\244\260\340\245\215\340\244\232 (Flashlight) \340\244\220\340\244\252 \340\244\241\340\244\276\340\244\211\340\244\250\340\244\262\340\245\213\340\244\241 \340\244\225\340\244\260\340\244\244\340\245\207 \340\244\270\340\244\256\340\244\257 \340\244\265\340\244\271 \"\340\244\225\340\245\211\340\244\250\340\245\215\340\244\237\340\245\210\340\244\225\340\245\215\340\244\237\340\245\215\340\244\270, SMS \340\244\224\340\244\260 \340\244\256\340\244\276\340\244\207\340\244\225\340\245\215\340\244\260\340\245\213\340\244\253\340\245\213\340\244\250\" \340\244\225\340\245\200 \340\244\205\340\244\250\340\245\201\340\244\256\340\244\244\340\244\277 \340\244\256\340\244\276\340\244\202\340\244\227\340\244\244\340\244\276 \340\244\271\340\245\210\340\245\244 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\277\340\244\217?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    questionMr: \'\340\244\217\340\244\225 \340\244\270\340\244\276\340\244\247\340\245\207 \340\244\237\340\245\211\340\244\260\340\245\215\340\244\232 \340\245\262\340\244\252 \340\244\207\340\244\250\340\245\215\340\244\270\340\245\215\340\244\237\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\244\340\244\276\340\244\250\340\244\276 \340\244\244\340\245\207 \"\340\244\225\340\245\211\340\244\250\340\245\215\340\244\237\340\245\205\340\244\225\340\245\215\340\244\237\340\245\215\340\244\270, \340\244\256\340\245\207\340\244\270\340\245\207\340\244\234 \340\244\206\340\244\243\340\244\277 \340\244\256\340\244\276\340\244\257\340\244\225\340\245\215\340\244\260\340\245\213\340\244\253\340\245\213\340\244\250\"\340\244\232\340\245\200 \340\244\252\340\244\260\340\244\265\340\244\276\340\244\250\340\244\227\340\245\200 \340\244\256\340\244\276\340\244\227\340\244\244\340\245\207. \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\225\340\244\276\340\244\257 \340\244\225\340\244\260\340\244\276\340\244\265\340\245\207?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { text: \'Allow all permissions to make the app work smoothly\', isCorrect: false },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
