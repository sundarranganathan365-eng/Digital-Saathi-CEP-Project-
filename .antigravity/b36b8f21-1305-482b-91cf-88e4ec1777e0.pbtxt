        lines {
          text: "    explanation: \'This is a classic KYC phishing scam. Scammers create fake bank login pages to steal your username, password, and OTP. Banks never ask you to update KYC by clicking SMS links.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
