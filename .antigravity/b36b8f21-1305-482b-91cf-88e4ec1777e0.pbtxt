\234 \340\244\206\340\244\271\340\245\207. \340\244\244\340\245\201\340\244\256\340\245\215\340\244\271\340\245\200 \340\244\226\340\244\260\340\244\276 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\225\340\245\201\340\244\240\340\245\207 \340\244\266\340\245\213\340\244\247\340\244\276\340\244\265\340\244\276?\',\n    options: [\n      { text: \'Random search results on Google Maps or unverified social media posts\', isCorrect: false },\n      { text: \'Official bank passbook, official app, or back of your physical debit card\', isCorrect: true },\n      { text: \'Call the first mobile number that appears in a WhatsApp forward\', isCorrect: false },\n      { text: \'Click random pop-up ads promising 24/7 instant support\', isCorrect: false },\n    ],\n    explanation: \'Scammers frequently edit business phone numbers on Google Maps or create fake help posts. Always use the phone number printed on your official passbook, bank card, or verified official website.\',\n    explanationHi: \'\340\244\227\340\245\202\340\244\227\340\244\262 \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\252\340\244\260 \340\244\246\340\244\277\340\244\226\340\244\250\340\245\207 \340\244\265\340\244\276\340\244\262\340\245\207 \340\244\205\340\244\250\340\244\234\340\244\276\340\244\250 \340\244\250\340\244\202\340\244\254\340\244\260\340\245\213\340\244\202 \340\244\252\340\244\260 \340\244\255\340\244\260\340\245\213\340\244\270\340\244\276 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244 \340\244\254\340\245\210\340\244\202\340\244\225 \340\244\252\340\244\276\340\244\270\340\244\254\340\245\201\340\244\225 \340\244\257\340\244\276 \340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\220\340\244\252 \340\244\256\340\245\207\340\244\202 \340\244\246\340\244\277\340\244\217 \340\244\227\340\244\217 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\227\340\245\201\340\244\227\340\244\262 \340\244\256\340\245\205\340\244\252\340\245\215\340\244\270\340\244\265\340\244\260\340\245\200\340\244\262 \340\244\205\340\244\250\340\245\213\340\244\263\340\244\226\340\245\200 \340\244\250\340\244\202\340\244\254\340\244\260\340\244\265\340\244\260 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\265\340\244\276\340\244\270 \340\244\240\340\245\207\340\244\265\340\245\202 \340\244\250\340\244\225\340\244\276. \340\244\252\340\244\276\340\244\270\340\244\254\340\245\201\340\244\225 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\205\340\244\247\340\244\277\340\244\225\340\245\203\340\244\244 \340\245\262\340\244\252\340\244\256\340\244\247\340\245\200\340\244\262 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276.\',\n  },\n  {\n    id: 8,\n    category: \'basics\',\n    question: \'What is the safest way to connect to the internet when accessing your bank account or making payments?\',\n    questionHi: \'\340\244\254\340\245\210\340\244\202\340\244\225 \340\244\226\340\244\276\340\244\244\340\244\276 \340\244\246\340\245\207\340\244\226\340\244\250\340\245\207 \340\244\257\340\244\276 \340\244\255\340\245\201\340\244\227\340\244\244\340\244\276\340\244\250 \340\244\225\340\244\260\340\244\244\340\245\207 \340\244\270\340\244\256\340\244\257 \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\270\340\245\207 \340\244\234\340\245\201\340\244\241\340\244\274\340\244\250\340\245\207 \340\244\225\340\244\276 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\244\340\244\260\340\245\200\340\244\225\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',\n    questionMr: \'\340\244\254\340\244\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260 \340\244\225\340\244\260\340\244\244\340\244\276\340\244\250\340\244\276 \340\244\207\340\244\202\340\244\237\340\244\260\340\244\250\340\245\207\340\244\237 \340\244\234\340\245\213\340\244\241\340\244\243\340\245\200\340\244\232\340\244\276 \340\244\270\340\244\260\340\245\215\340\244\265\340\244\276\340\244\244 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\256\340\244\276\340\244\260\340\245\215\340\244\227 \340\244\225\340\245\213\340\244\243\340\244\244\340\244\276 \340\244\206\340\244\271\340\245\207?\',\n    options: [\n      { text: \'Free open Wi-Fi at a railway station or tea stall with no password\', isCorrect: false },\n      { text: \'Your personal mobile cellular data (4G/5G) or secure private home Wi-Fi\', isCorrect: true },\n      { text: \'Connecting to an unknown stranger\342\200\231s open mobile hotspot\', isCorrect: false },\n      { text: \'Connecting to any public network called \"FREE_INTERNET\"\', isCorrect: false },\n    ],\n    explanation: \'Public open Wi-Fi networks without passwords can be monitored by hackers to capture unencrypted network traffic. Use your own mobile data plan for private banking tasks.\',\n    explanationHi: \'\340\244\254\340\245\210\340\244\202\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\244\255\340\245\200 \340\244\255\340\245\200 \340\244\226\340\245\201\340\244\262\340\245\207 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\265\340\244\276\340\244\210-\340\244\253\340\244\276\340\244\210 (Public Wi-Fi) \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244 \340\244\205\340\244\252\340\244\250\340\245\207 \340\244\256\340\245\213\340\244\254\340\244\276\340\244\207\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\254\340\244\201\340\244\225\340\244\277\340\244\202\340\244\227 \340\244\265\340\245\215\340\244\257\340\244\265\340\244\271\340\244\276\340\244\260\340\244\276\340\244\202\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\270\340\244\276\340\244\260\340\245\215\340\244\265\340\244\234\340\244\250\340\244\277\340\244\225 \340\244\256\340\245\213\340\244\253\340\244\244 \340\244\265\340\244\276\340\244\257-\340\244\253\340\244\276\340\244\257 \340\244\265\340\244\276\340\244\252\340\244\260\340\245\202 \340\244\250\340\244\225\340\244\276. \340\244\270\340\245\215\340\244\265\340\244\244\340\244\203\340\244\232\340\244\276 \340\244\256\340\245\213\340\244\254\340\244\276\340\244\210\340\244\262 \340\244\241\340\245\207\340\244\237\340\244\276 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276.\',\n  },\n  {\n    id: 9,\n    category: \'safety\',\n    question: \'If you unfortunately fell for a financial cyber fraud, what is the official National Cyber Crime Helpline number in India?\',\n    questionHi: \'\340\244\257\340\244\246\340\244\277 \340\244\225\340\244\277\340\244\270\340\245\200 \340\244\225\340\245\207 \340\244\270\340\244\276\340\244\245 \340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\265\340\244\277\340\244\244\340\245\215\340\244\244\340\245\200\340\244\257 \340\244\247\340\245\213\340\244\226\340\244\276\340\244\247\340\244\241\340\244\274\340\245\200 \340\244\271\340\245\213 \340\244\234\340\244\276\340\244\244\340\245\200 \340\244\271\340\245\210, \340\244\244\340\245\213 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\225\340\244\276 \340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 \340\244\270\340\244\276\340\244\207\340\244\254\340\244\260 \340\244\205\340\244\252\340\244\260\340\244\276\340\244\247 \340\244\271\340\245\207\340\244\262\340\245\215\340\244\252\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',\n    questionMr: \'\340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225 \340\244\235\340\244\276\340\244\262\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\255\340\244\276\340\244\260\340\244\244\340\244\276\340\244\232\340\244\276 \340\244\260\340\244\276\340\244\267\340\245\215\340\244\237\340\245\215\340\244\260\340\245\200\340\244\257 \340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\225\340\245\215\340\244\260\340\244\276\340\244\210\340\244\256 \340\244\271\340\245\207\340\244\262\340\245\215\340\244\252\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\250\340\244\202\340\244\254\340\244\260 \340\244\225\340\245\213\340\244\243\340\244\244\340\244\276 \340\244\206\340\244\271\340\245\207?\',\n    options: [\n      { text: \'100\', isCorrect: false },\n      { text: \'1930 (Cyber Crime Helpline)\', isCorrect: true },\n      { text: \'9999\', isCorrect: false },\n      { text: \'1212\', isCorrect: false },\n    ],\n    explanation: \'Dial 1930 immediately! The Citizen Financial Cyber Fraud Reporting System operates through 1930 and helps freeze stolen funds within the \"Golden Hour\". You can also file a report at cybercrime.gov.in.\',\n    explanationHi: \'\340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\265\340\244\277\340\244\244\340\245\215\340\244\244\340\245\200\340\244\257 \340\244\247\340\245\213\340\244\226\340\244\276\340\244\247\340\244\241\340\244\274\340\245\200 \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\252\340\244\260 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 1930 \340\244\241\340\244\276\340\244\257\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 cybercrime.gov.in \340\244\252\340\244\260 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225 \340\244\235\340\244\276\340\244\262\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\244\340\244\276\340\244\244\340\244\241\340\245\200\340\244\250\340\245\207 \340\245\247\340\245\257\340\245\251\340\245\246 \340\244\265\340\244\260 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\276 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 cybercrime.gov.in \340\244\265\340\244\260 \340\244\244\340\244\225\340\245\215\340\244\260\340\244\276\340\244\260 \340\244\250\340\245\213\340\244\202\340\244\246\340\244\265\340\244\276.\',\n  },\n  {\n    id: 10,\n    category: \'services\',\n    question: \'When submitting a photocopy of your Aadhaar card for a sim card or hotel check-in, what is the best safety practice?\',\n    questionHi: \'\340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\257\340\244\276 \340\244\271\340\245\213\340\244\237\340\244\262 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241 \340\244\225\340\245\200 \340\244\253\340\245\213\340\244\237\340\245\213\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\246\340\245\207\340\244\244\340\245\207 \340\244\270\340\244\256\340\244\257 \340\244\270\340\244\254\340\244\270\340\245\207 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244 \340\244\244\340\244\260\340\245\200\340\244\225\340\244\276 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',\n    questionMr: \'\340\244\271\340\245\211\340\244\237\340\245\207\340\244\262 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 \340\244\270\340\244\277\340\244\256 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241\340\244\270\340\244\276\340\244\240\340\245\200 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\225\340\244\276\340\244\260\340\245\215\340\244\241\340\244\232\340\245\200 \340\244\235\340\245\207\340\244\260\340\245\211\340\244\225\340\245\215\340\244\270 \340\244\246\340\245\207\340\244\244\340\244\276\340\244\250\340\244\276 \340\244\225\340\245\213\340\244\243\340\244\244\340\245\200 \340\244\225\340\244\276\340\244\263\340\244\234\340\245\200 \340\244\230\340\245\215\340\244\257\340\244\276\340\244\265\340\245\200?\',\n    options: [\n      { text: \'Leave blank signed copies with the store keeper\', isCorrect: false },\n      { text: \'Use a Masked Aadhaar (showing only last 4 digits) and write the purpose & date across the copy\', isCorrect: true },\n      { text: \'Post a clear photo of your Aadhaar on your social media profile\', isCorrect: false },\n      { text: \'Share your Aadhaar OTP with the receptionist\', isCorrect: false },\n    ],\n    explanation: \'Use UIDAI\342\200\231s official \"Masked Aadhaar\" (which masks the first 8 digits) and write a clear handwritten note across the photocopy stating: \"Submitted only for [Purpose] on [Date]\" so it cannot be reused fraudulently.\',\n    explanationHi: \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225\340\245\215\340\244\241 \340\244\206\340\244\247\340\244\276\340\244\260 (Masked Aadhaar) \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\224\340\244\260 \340\244\253\340\245\213\340\244\237\340\245\213\340\244\225\340\245\211\340\244\252\340\245\200 \340\244\252\340\244\260 \340\244\211\340\244\246\340\245\215\340\244\246\340\245\207\340\244\266\340\245\215\340\244\257 \340\244\265 \340\244\244\340\244\276\340\244\260\340\245\200\340\244\226 \340\244\262\340\244\277\340\244\226 \340\244\246\340\245\207\340\244\202\340\245\244\',\n    explanationMr: \'\340\244\256\340\244\276\340\244\270\340\245\215\340\244\225\340\245\215\340\244\241 \340\244\206\340\244\247\340\244\276\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276 \340\244\206\340\244\243\340\244\277 \340\244\235\340\245\207\340\244\260\340\245\211\340\244\225\340\245\215\340\244\270\340\244\265\340\244\260 \340\244\265\340\244\276\340\244\252\340\244\260\340\244\276\340\244\232\340\244\276 \340\244\271\340\245\207\340\244\244\340\245\202 \340\244\206\340\244\243\340\244\277 \340\244\244\340\244\276\340\244\260\340\245\200\340\244\226 \340\244\262\340\244\277\340\244\271\340\245\202\340\244\250 \340\244\270\340\244\271\340\245\200 \340\244\225\340\244\260\340\244\276.\',\n  },\n];\n"
    }
