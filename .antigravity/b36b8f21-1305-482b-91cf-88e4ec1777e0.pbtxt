  file_change {
    absolute_path_uri: "file:///src/pages/BasicsPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PageId, Language } from \'../types\';\nimport { translations } from \'../data/translations\';\nimport {\n  Smartphone,\n  Wifi,\n  Globe,\n  Download,\n  Volume2,\n  ShieldCheck,\n  Search,\n  Lock,\n  ArrowRight,\n  CheckCircle2,\n  XCircle,\n  Settings,\n  HelpCircle,\n} from \'lucide-react\';\n\ninterface BasicsPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nexport const BasicsPage: React.FC<BasicsPageProps> = ({ setCurrentPage, language }) => {\n  const [activeTab, setActiveTab] = useState<\'smartphone\' | \'internet\' | \'apps\'>(\'smartphone\');\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16\">\n      {/* Header / Intro */}\n      <div className=\"max-w-3xl border-b border-[#E5E5E5] pb-8\">\n        <div className=\"flex items-center gap-2 mb-3\">\n          <span className=\"text-xs font-mono font-semibold uppercase tracking-wider text-[#737373] bg-[#EFEFED] px-2 py-0.5 rounded\">\n            Module 01\n          </span>\n          <span className=\"text-xs text-[#737373] uppercase tracking-wider\">Foundation Skills</span>\n        </div>\n        <h1 className=\"text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#171717] font-editorial\">\n          Digital Basics: Smartphone & Internet\n        </h1>\n        <p className=\"text-base text-[#525252] mt-3 leading-relaxed\">\n          Master the fundamental building blocks of modern smartphones, secure internet navigation, and safe application management with clear, step-by-step guidance.\n        </p>\n      </div>\n\n      {/* Tab Navigation */}\n      <div className=\"flex items-center gap-2 border-b border-[#E5E5E5] pb-px overflow-x-auto\">\n        <button\n          id=\"tab-btn-smartphone\"\n          onClick={() => setActiveTab(\'smartphone\')}\n          className={`flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 transition-all whitespace-nowrap ${\n            activeTab === \'smartphone\'\n              ? \'border-[#171717] text-[#171717]\'\n              : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Smartphone className=\"w-4 h-4\" />\n          <span>1. Smartphone Fundamentals</span>\n        </button>\n\n        <button\n          id=\"tab-btn-internet\"\n          onClick={() => setActiveTab(\'internet\')}\n          className={`flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 transition-all whitespace-nowrap ${\n            activeTab === \'internet\'\n              ? \'border-[#171717] text-[#171717]\'\n              : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Globe className=\"w-4 h-4\" />\n          <span>2. Internet & Safe Browsing</span>\n        </button>\n\n        <button\n          id=\"tab-btn-apps\"\n          onClick={() => setActiveTab(\'apps\')}\n          className={`flex items-center gap-2 px-4 py-3 text-sm font-semibold border-b-2 transition-all whitespace-nowrap ${\n            activeTab === \'apps\'\n              ? \'border-[#171717] text-[#171717]\'\n              : \'border-transparent text-[#737373] hover:text-[#171717]\'\n          }`}\n        >\n          <Download className=\"w-4 h-4\" />\n          <span>3. App Management & Permissions</span>\n        </button>\n      </div>\n\n      {/* TAB CONTENT: 1. SMARTPHONE FUNDAMENTALS */}\n      {activeTab === \'smartphone\' && (\n        <div className=\"space-y-12 animate-in fade-in duration-200\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            {/* Step 1 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                Concept 01\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">The Home Screen & Navigation</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                The home screen is your phone\'s main table. Touching an app icon opens it. Swiping up from the bottom (or pressing the center button) takes you right back home anytime.\n              </p>\n              <div className=\"p-3 bg-[#FAF9F6] border border-[#E5E5E5] rounded text-xs text-[#171717]\">\n                <strong>Rule of Thumb:</strong> If you ever feel lost or stuck in an app, tap the Home button or swipe up from the bottom edge.\n              </div>\n            </div>\n\n            {/* Step 2 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                Concept 02\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">Volume & Screen Brightness</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                Use the physical buttons on the side of your phone to adjust ringtone and call volumes. Swipe down from the top edge of your screen to access quick brightness sliders.\n              </p>\n              <div className=\"p-3 bg-[#FAF9F6] border border-[#E5E5E5] rounded text-xs text-[#171717]\">\n                <strong>Accessibility Tip:</strong> Keep brightness on automatic so the screen remains easily readable both indoors and under direct sunlight.\n              </div>\n            </div>\n\n            {/* Step 3 */}\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-3\">\n                Concept 03\n              </span>\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">Wi-Fi vs Mobile Data</h3>\n              <p className=\"text-xs sm:text-sm text-[#525252] leading-relaxed mb-4\">\n                <strong>Mobile Data (4G/5G)</strong> uses your SIM card telecom plan. <strong>Wi-Fi</strong> connects wirelessly to home or office broadband without consuming your daily mobile quota.\n              </p>\n              <div className=\"p-3 bg-[#FAF9F6] border border-[#E5E5E5] rounded text-xs text-[#171717]\">\n                <strong>Caution:</strong> Avoid performing sensitive bank transactions on open public Wi-Fi networks at bus stands or tea stalls.\n              </div>\n            </div>\n          </div>\n\n          {/* Step-by-Step Guide: Connecting to Wi-Fi */}\n          <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-8\">\n            <h3 className=\"text-xl font-bold text-[#171717] mb-6 font-editorial\">\n              How to Connect to a Known Home/Office Wi-Fi (Step-by-Step)\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-4\">\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">\n                  Step 1\n                </span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Open Settings</h4>\n                <p className=\"text-xs text-[#525252]\">Swipe down from top or tap the gear-shaped \"Settings\" icon.</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">\n                  Step 2\n                </span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Select Network / Wi-Fi</h4>\n                <p className=\"text-xs text-[#525252]\">Ensure the Wi-Fi toggle switch is turned ON (Green or Blue).</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">\n                  Step 3\n                </span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Choose Network Name</h4>\n                <p className=\"text-xs text-[#525252]\">Tap your private home or office network name (SSID).</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">\n                  Step 4\n                </span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Enter Password & Connect</h4>\n                <p className=\"text-xs text-[#525252]\">Type the secure password carefully. Tap \"Connect\".</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB CONTENT: 2. INTERNET & SAFE BROWSING */}\n      {activeTab === \'internet\' && (\n        <div className=\"space-y-12 animate-in fade-in duration-200\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-2\">\n                Concept & Definition\n              </span>\n              <h3 className=\"text-xl font-bold text-[#171717] mb-3\">What is a Web Browser?</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed mb-4\">\n                A <strong>Browser</strong> (such as Google Chrome, Apple Safari, or Mozilla Firefox) is a window that lets you open and view websites across the global internet.\n              </p>\n              <div className=\"space-y-2 text-xs sm:text-sm text-[#333333]\">\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"text-[#171717] font-bold\">1. Address Bar:</span>\n                  <span>Where you type the exact website destination (e.g. google.com or irctc.co.in).</span>\n                </div>\n                <div className=\"flex items-start gap-2\">\n                  <span className=\"text-[#171717] font-bold\">2. Search Engine:</span>\n                  <span>When you type questions or names, it finds matching web pages.</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <span className=\"text-xs font-mono font-semibold text-[#737373] uppercase tracking-wider block mb-2\">\n                Anatomy of a Web Address\n              </span>\n              <h3 className=\"text-xl font-bold text-[#171717] mb-3\">How to Read a Website URL</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed mb-4\">\n                Scammers trick users by creating imitation names. Always inspect the rightmost part before the first slash:\n              </p>\n              <div className=\"space-y-3 font-mono text-xs\">\n                <div className=\"p-2.5 bg-emerald-50 border border-emerald-300 rounded text-emerald-950 flex items-center justify-between\">\n                  <span>https://www.<strong>onlinesbi.sbi</strong>/login</span>\n                  <span className=\"font-sans text-[11px] font-bold text-emerald-800\">GENUINE BANK</span>\n                </div>\n                <div className=\"p-2.5 bg-red-50 border border-red-300 rounded text-red-950 flex items-center justify-between\">\n                  <span>http://<strong>sbi-kyc-update.xyz</strong>/login</span>\n                  <span className=\"font-sans text-[11px] font-bold text-red-800\">SCAM DOMAIN</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Safe Web Searching Checklist */}\n          <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-8\">\n            <h3 className=\"text-xl font-bold text-[#171717] mb-4 font-editorial\">\n              Safe Web Searching Checklist\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-6\">\n              <div className=\"flex items-start gap-3\">\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-sm font-bold text-[#171717]\">Beware of Sponsored Ads</h4>\n                  <p className=\"text-xs text-[#525252] mt-1\">\n                    The very top search results are often labeled \"Sponsored\" or \"Ad\". Fraudsters sometimes pay for ads to put fake customer care phone numbers at the top.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-sm font-bold text-[#171717]\">Look for Secure Padlock (HTTPS)</h4>\n                  <p className=\"text-xs text-[#525252] mt-1\">\n                    Make sure the web address starts with <code>https://</code>, meaning data passed between your phone and the website is encrypted.\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <CheckCircle2 className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                <div>\n                  <h4 className=\"text-sm font-bold text-[#171717]\">Never Type Passwords on Pop-ups</h4>\n                  <p className=\"text-xs text-[#525252] mt-1\">\n                    If an unsolicited pop-up claims your phone is infected with a virus, close the browser tab immediately. Do not call numbers in the pop-up.\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* TAB CONTENT: 3. APP MANAGEMENT & PERMISSIONS */}\n      {activeTab === \'apps\' && (\n        <div className=\"space-y-12 animate-in fade-in duration-200\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">Installing & Updating Apps Safely</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed mb-4\">\n                Always install applications exclusively through the official <strong>Google Play Store</strong> (on Android) or <strong>Apple App Store</strong> (on iPhone).\n              </p>\n              <ul className=\"space-y-2 text-xs sm:text-sm text-[#333333]\">\n                <li className=\"flex items-start gap-2\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <span>Check app ratings and review count before downloading.</span>\n                </li>\n                <li className=\"flex items-start gap-2\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <span>Keep apps updated to receive the latest security patches.</span>\n                </li>\n                <li className=\"flex items-start gap-2\">\n                  <XCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n                  <span><strong>Never</strong> install APK files sent via WhatsApp, Telegram, or SMS.</span>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"p-6 border border-[#E5E5E5] bg-white rounded-sm\">\n              <h3 className=\"text-lg font-bold text-[#171717] mb-2\">Understanding App Permissions</h3>\n              <p className=\"text-sm text-[#525252] leading-relaxed mb-4\">\n                When an app asks for permission to access your Camera, Microphone, Location, or Contacts, ask yourself: <em>Does this app genuinely need this?</em>\n              </p>\n              <div className=\"p-3 bg-[#FAF9F6] border border-[#E5E5E5] rounded text-xs space-y-1.5 text-[#171717]\">\n                <div><strong>Maps App:</strong> Needs Location \342\234\223 (Sensible)</div>\n                <div><strong>Camera App:</strong> Needs Camera & Storage \342\234\223 (Sensible)</div>\n                <div className=\"text-red-700 font-semibold\">\n                  <strong>Torch / Calculator App:</strong> Asks for SMS & Contacts \342\234\227 (DANGEROUS)\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Step-by-Step: Reviewing and Revoking Permissions */}\n          <div className=\"border border-[#E5E5E5] bg-white rounded-sm p-6 sm:p-8\">\n            <h3 className=\"text-xl font-bold text-[#171717] mb-4 font-editorial\">\n              How to Check & Remove Suspicious App Permissions\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-4\">\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">1</span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Open Settings</h4>\n                <p className=\"text-xs text-[#525252]\">Go into phone Settings & select \"Apps\" or \"App Management\".</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">2</span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Select Permission Manager</h4>\n                <p className=\"text-xs text-[#525252]\">Tap on \"Permission Manager\" to see list of sensors and data.</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">3</span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Inspect Sensitive Data</h4>\n                <p className=\"text-xs text-[#525252]\">Check which apps have access to your SMS, Camera, and Microphone.</p>\n              </div>\n\n              <div className=\"p-4 border border-[#E5E5E5] rounded bg-[#FAF9F6]\">\n                <span className=\"text-xs font-mono font-bold text-[#171717] bg-[#E5E5E5] px-2 py-0.5 rounded\">4</span>\n                <h4 className=\"text-sm font-bold text-[#171717] mt-3 mb-1\">Select \"Don\'t Allow\"</h4>\n                <p className=\"text-xs text-[#525252]\">Revoke permissions for any unfamiliar or unnecessary applications.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Next Module Navigation Link */}\n      <div className=\"pt-8 border-t border-[#E5E5E5] flex items-center justify-between\">\n        <button\n          onClick={() => { setCurrentPage(\'home\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"text-xs font-semibold text-[#737373] hover:text-[#171717] transition-colors\"\n        >\n          \342\206\220 Back to Homepage\n        </button>\n\n        <button\n          id=\"btn-next-module-payments\"\n          onClick={() => { setCurrentPage(\'payments\'); window.scrollTo({ top: 0, behavior: \'smooth\' }); }}\n          className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-[#171717] text-white text-xs font-semibold rounded hover:bg-[#333333] transition-colors shadow-xs\"\n        >\n          <span>Continue to Module 02: Digital Payments & UPI</span>\n          <ArrowRight className=\"w-3.5 h-3.5\" />\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
