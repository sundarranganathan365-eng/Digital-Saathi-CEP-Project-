  file_change {
    absolute_path_uri: "file:///src/pages/ServicesPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PageId, Language } from \'../types\';\nimport {\n  FileText,\n  ShieldCheck,\n  Building2,\n  Lock,\n  ArrowRight,\n  CheckCircle2,\n  XCircle,\n  HelpCircle,\n  ExternalLink,\n  Eye,\n} from \'lucide-react\';\n\ninterface ServicesPageProps {\n  setCurrentPage: (page: PageId) => void;\n  language: Language;\n}\n\nconst servicesContent = {\n  en: {\n    moduleTag: \'Module 04\',\n    categoryTag: \'Public Services\',\n    title: \'Digital Public Services & DigiLocker\',\n    subtitle: \'Learn how to securely access genuine government portals, utilize DigiLocker for legally valid digital documents, and practice Masked Aadhaar privacy.\',\n    digilocker: {\n      tag: \'Official Platform\',\n      title: \'What is DigiLocker?\',\n      desc: \'DigiLocker is an official flagship initiative by the Ministry of Electronics and IT (Govt. of India). It provides every Indian citizen with a secure cloud storage account linked directly to their Aadhaar number to access authentic electronic documents.\',\n      points: [\n        \'Legal Recognition: Documents in DigiLocker are treated at par with original physical documents under Rule 9A of IT Rules 2016.\',\n        \'Accepted by Traffic Police, Railways (IRCTC), and Airports for identity verification.\',\n        \'Eliminates the risk of losing or damaging original paper certificates.\',\n      ],\n      stepsTitle: \'3 Steps to Get Started with DigiLocker\',\n      steps: [\n        { num: 1, title: \'Install Official App or Visit digilocker.gov.in\', desc: \'Ensure you are on the verified government domain.\' },\n        { num: 2, title: \'Register Using Aadhaar & Mobile OTP\', desc: \'Enter your 12-digit Aadhaar number and verify with the OTP sent to your linked phone.\' },\n        { num: 3, title: \'Fetch Issued Documents\', desc: \'Search for your state Driving License, Vehicle RC, or Class 10/12 Marksheet to add authentic digital copies.\' },\n      ],\n    },\n    maskedAadhaar: {\n      tag: \'Identity Privacy\',\n      title: \'Masked Aadhaar: Protect Your Identity\',\n      desc: \'Whenever an unverified service (like a private hotel, gym, or apartment security gate) demands an Aadhaar photocopy, do NOT provide a full copy. Use Masked Aadhaar instead.\',\n      fullLabel: \'Standard Full Aadhaar (Vulnerable)\',\n      fullDesc: \'Displays all 12 digits: 1234 5678 9012. If stolen or photocopied, scammers can misuse your Aadhaar number for SIM swapping.\',\n      maskedLabel: \'Masked Aadhaar (Recommended & Safe)\',\n      maskedDesc: \'Hides the first 8 digits: XXXX-XXXX-9012. Fully valid for identity verification, but prevents identity theft.\',\n      howTo: \'Download your Masked Aadhaar anytime from the official UIDAI portal: eaadhaar.uidai.gov.in by selecting the \"Masked Aadhaar\" checkbox before downloading.\',\n    },\n    govDomains: {\n      tag: \'Web Domain Verification\',\n      title: \'How to Recognize Real Government Websites\',\n      desc: \'Never submit citizen details or payment information on suspicious commercial domain extensions.\',\n      officialBadge: \'Official Government Domains\',\n      officialList: [\n        \'ends with .gov.in (e.g. incometax.gov.in, parivahan.gov.in)\',\n        \'ends with .nic.in (e.g. epfindia.gov.in, sbi.co.in)\',\n        \'uses HTTPS encryption with a closed padlock in browser bar\',\n      ],\n      fakeBadge: \'Fraudulent & Cloned Domains (AVOID)\',\n      fakeList: [\n        \'ends with .xyz, .top, .online, or .club\',\n        \'uses free blog platforms like .blogspot.com or .wordpress.com\',\n        \'misspells official names (e.g. uidaii-update-portal.com)\',\n      ],\n    },\n    dosTitle: \'Summary: Digital Public Services Best Practices\',\n    dos: [\n      \'Store your Driving License and Vehicle RC in the official DigiLocker app.\',\n      \'Always download Masked Aadhaar for non-statutory offline verification.\',\n      \'Check the website address ends with .gov.in before filling application forms.\',\n      \'Use the UMANG mobile app to access multiple state and central government services in one place.\',\n    ],\n    donts: [\n      \'Never laminate or carry original Aadhaar cards everywhere when DigiLocker is accepted.\',\n      \'Never pay money on third-party unofficial websites claiming to \"fast-track\" PAN or Aadhaar corrections.\',\n      \'Never enter your Aadhaar number or OTP into random Google Forms or WhatsApp links.\',\n      \'Never trust sponsored search ads offering government subsidy schemes.\',\n    ],\n    nextCta: \'Module 05: Test Your Knowledge (Interactive Quiz)\',\n  },\n  hi: {\n    moduleTag: \'\340\244\256\340\245\211\340\244\241\340\245\215\340\244\257\340\245\202\340\244\262 04\',\n    categoryTag: \'\340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202\',\n    title: \'\340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\270\340\245\207\340\244\265\340\244\276\340\244\217\340\244\202 \340\244\224\340\244\260 \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260\',\n    subtitle: \'\340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\252\340\245\213\340\244\260\340\245\215\340\244\237\340\244\262 \340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340\244\260\340\244\250\340\244\276, \340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\252\340\244\260 \340\244\265\340\245\210\340\244\247 \340\244\241\340\244\277\340\244\234\340\244\277\340\244\237\340\244\262 \340\244\246\340\244\270\340\245\215\340\244\244\340\244\276\340\244\265\340\245\207\340\244\234 \340\244\260\340\244\226\340\244\250\340\244\276 \340\244\224\340\244\260 \340\244\256\340\244\276\340\244\270\340\245\215\340\244\225 \340\244\206\340\244\247\340\244\276\340\244\260 (Masked Aadhaar) \340\244\225\340\245\200 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\270\340\245\200\340\244\226\340\245\207\340\244\202\340\245\244\',\n    digilocker: {\n      tag: \'\340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\270\340\245\207\340\244\265\340\244\276\',\n      title: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 (DigiLocker) \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210?\',\n      desc: \'\340\244\241\340\244\277\340\244\234\340\245\200\340\244\262\340\245\211\340\244\225\340\244\260 \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\270\340\244\260\340\244\225\340\244\276\340\244\260 \340\244\225\340\245\207 \340\244\207\340\244\262\340\245\207\340\244\225\340\245\215\340\244\237\340\245\215\340\244\260\340\245\211\340\244\250\340\244\277\340\244\225\340\245\215\340\244\270 \340\244\224\340\244\260 \340\244\270\340\245\202\340\244\232\340\244\250\340\244\276 \340\244\252\340\245\215\340\244\260\340\245\214\340\244\246\340\245\215\340\244\257\340\245\213\340\244\227\340\244\277\340\244\225\340\245\200 \340\244\256\340\244\202\340\244\244\340\245\215\340\244\260\340\244\276\340\244\262\340\244\257 \340\244\225\340\245\200 \340\244\217\340\244\225 \340\244\206\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260\340\244\277\340\244\225 \340\244\252\340\244\271\340\244\262 \340\244\271\340\245\210\340\245\244 \340\244\257\340\244\271 \340\244\252\340\245\215\340\244\260\340\244\244\340\245\215\340\244\257\340\245\207\340\244\225 \340\244\255\340\244\27