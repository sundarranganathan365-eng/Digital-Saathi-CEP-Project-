    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { PageId } from \'../types\';\nimport { Search, X, ArrowRight, BookOpen, Shield, Smartphone, FileText, HelpCircle } from \'lucide-react\';\n\ninterface SearchModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onNavigate: (page: PageId, sectionId?: string) => void;\n}\n\ninterface SearchEntry {\n  title: string;\n  category: string;\n  page: PageId;\n  sectionId?: string;\n  summary: string;\n  icon: React.ReactNode;\n}\n\nconst SEARCH_DATABASE: SearchEntry[] = [\n  {\n    title: \'UPI Payment Fundamentals\',\n    category: \'Digital Payments\',\n    page: \'payments\',\n    sectionId: \'what-is-upi\',\n    summary: \'What Unified Payments Interface is, how VPA IDs work, and real-time bank transfers.\',\n    icon: <BookOpen className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'How to make a UPI Payment (7-Step Guide)\',\n    category: \'Digital Payments\',\n    page: \'payments\',\n    sectionId: \'how-to-pay\',\n    summary: \'Scanning QR codes, entering amounts, verifying recipient names, and typing UPI PIN safely.\',\n    icon: <BookOpen className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'UPI PIN Golden Rules (Never required to receive money)\',\n    category: \'Digital Payments\',\n    page: \'payments\',\n    sectionId: \'golden-rules\',\n    summary: \'Crucial distinction: Entering PIN only debits money. Receiving money never requires a PIN.\',\n    icon: <Shield className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Phishing & Fake SMS Links\',\n    category: \'Online Safety\',\n    page: \'safety\',\n    sectionId: \'phishing\',\n    summary: \'Recognizing fake bank KYC warnings, electricity cutoff SMS, and malicious URLs.\',\n    icon: <Shield className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'OTP Scams & Never Sharing Passwords\',\n    category: \'Online Safety\',\n    page: \'safety\',\n    sectionId: \'otp-scams\',\n    summary: \'Why One-Time Passwords must never be read out over phone calls or entered into unverified forms.\',\n    icon: <Shield className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Fake Customer Care & Helpline Numbers\',\n    category: \'Online Safety\',\n    page: \'safety\',\n    sectionId: \'fake-helplines\',\n    summary: \'Avoiding tampered Google Maps helpline numbers; where to find genuine bank phone numbers.\',\n    icon: <Shield className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Cyber Crime Helpline 1930 & Golden Hour\',\n    category: \'Online Safety\',\n    page: \'safety\',\n    sectionId: \'cyber-helpline\',\n    summary: \'Immediate steps after financial fraud: dialing 1930 within 2 hours to freeze illicit transfers.\',\n    icon: <Shield className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Smartphone & Home Screen Basics\',\n    category: \'Digital Basics\',\n    page: \'basics\',\n    sectionId: \'smartphone-basics\',\n    summary: \'Touch gestures, managing volume, quick settings, Wi-Fi connections, and mobile cellular data.\',\n    icon: <Smartphone className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Safe App Installation & Permissions\',\n    category: \'Digital Basics\',\n    page: \'basics\',\n    sectionId: \'app-basics\',\n    summary: \'Installing only from Google Play Store, avoiding unknown APK files, and checking app permissions.\',\n    icon: <Smartphone className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'DigiLocker & Cloud Document Storage\',\n    category: \'Digital Services\',\n    page: \'services\',\n    sectionId: \'digilocker\',\n    summary: \'Government-issued digital documents: Aadhaar, Driving License, RC, and legal validity under IT Act.\',\n    icon: <FileText className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Official Government Domains (.gov.in & .nic.in)\',\n    category: \'Digital Services\',\n    page: \'services\',\n    sectionId: \'gov-portals\',\n    summary: \'How to verify genuine central and state government portals and avoid fake clones.\',\n    icon: <FileText className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Masked Aadhaar Safety Practice\',\n    category: \'Digital Services\',\n    page: \'services\',\n    sectionId: \'masked-aadhaar\',\n    summary: \'Protecting your identity by sharing copies with first 8 digits hidden and purpose written across.\',\n    icon: <FileText className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'Interactive 10-Question Knowledge Quiz\',\n    category: \'Learn & Test\',\n    page: \'quiz\',\n    summary: \'Test your understanding of digital literacy, UPI precautions, and online scam identification.\',\n    icon: <HelpCircle className=\"w-4 h-4 text-[#525252]\" />,\n  },\n  {\n    title: \'BSc Computer Science CEP Project Manifesto\',\n    category: \'About\',\n    page: \'about\',\n    summary: \'Social problem, digital divide in India, open-source repository details, and educational mission.\',\n    icon: <BookOpen className=\"w-4 h-4 text-[#525252]\" />,\n  },\n];\n\nexport const SearchModal: React.FC<SearchModalProps> = ({ isOpen, onClose, onNavigate }) => {\n  const [query, setQuery] = useState(\'\');\n  const inputRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    if (isOpen) {\n      setTimeout(() => inputRef.current?.focus(), 50);\n    } else {\n      setQuery(\'\');\n    }\n  }, [isOpen]);\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if ((e.metaKey || e.ctrlKey) && e.key === \'k\') {\n        e.preventDefault();\n        if (isOpen) onClose();\n        else inputRef.current?.focus();\n      }\n      if (e.key === \'Escape\' && isOpen) {\n        onClose();\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [isOpen, onClose]);\n\n  if (!isOpen) return null;\n\n  const filtered = query.trim() === \'\'\n    ? SEARCH_DATABASE.slice(0, 6)\n    : SEARCH_DATABASE.filter(item =>\n        item.title.toLowerCase().includes(query.toLowerCase()) ||\n        item.summary.toLowerCase().includes(query.toLowerCase()) ||\n        item.category.toLowerCase().includes(query.toLowerCase())\n      );\n\n  const handleSelect = (item: SearchEntry) => {\n    onNavigate(item.page, item.sectionId);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-start justify-center pt-20 px-4 bg-black/40 backdrop-blur-xs animate-in fade-in duration-150\">\n      <div className=\"bg-white border border-[#D4D4D4] rounded shadow-xl w-full max-w-2xl overflow-hidden animate-in zoom-in-95 duration-150\">\n        {/* Search input header */}\n        <div className=\"flex items-center px-4 py-3.5 border-b border-[#E5E5E5] gap-3\">\n          <Search className=\"w-5 h-5 text-[#737373] shrink-0\" />\n          <input\n            ref={inputRef}\n            type=\"text\"\n            value={query}\n            onChange={(e) => setQuery(e.target.value)}\n            placeholder=\"Search topics (e.g. UPI, OTP, DigiLocker, KYC, Scams...)\"\n            className=\"w-full bg-transparent border-none text-sm sm:text-base text-[#171717] placeholder:text-[#A3A3A3] focus:outline-none\"\n          />\n          {query && (\n            <button\n              onClick={() => setQuery(\'\')}\n              className=\"text-xs text-[#737373] hover:text-[#171717] px-1.5 py-0.5\"\n            >\n              Clear\n            </button>\n          )}\n          <button\n            onClick={onClose}\n            className=\"p-1 text-[#737373] hover:text-[#171717] rounded hover:bg-[#F5F5F4]\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Results List */}\n        <div className=\"max-h-[60vh] overflow-y-auto p-2 divide-y divide-[#F5F5F4]\">\n          {filtered.length > 0 ? (\n            filtered.map((item, idx) => (\n              <button\n                key={idx}\n                onClick={() => handleSelect(item)}\n                className=\"w-full text-left p-3 rounded hover:bg-[#FAF9F6] transition-colors flex items-start justify-between gap-3 group\"\n              >\n                <div className=\"flex items-start gap-3\">\n                  <div className=\"p-2 bg-[#F5F5F4] border border-[#E5E5E5] rounded group-hover:bg-white transition-colors\">\n                    {item.icon}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-semibold text-[#737373] uppercase tracking-wider\">\n                        {item.category}\n                      </span>\n                    </div>\n                    <h5 className=\"text-sm font-semibold text-[#171717] group-hover:text-blue-900 transition-colors\">\n                      {item.title}\n                    </h5>\n                    <p className=\"text-xs text-[#525252] mt-0.5 line-clamp-1\">\n                      {item.summary}\n                    </p>\n                  </div>\n                </div>\n                <ArrowRight className=\"w-4 h-4 text-[#A3A3A3] group-hover:text-[#171717] group-hover:translate-x-0.5 transition-all shrink-0 mt-2\" />\n              </button>\n            ))\n          ) : (\n            <div className=\"py-12 text-center text-xs text-[#737373]\">\n              No matching guides found for \"{query}\". Try searching for UPI, OTP, or DigiLocker.\n            </div>\n          )}\n        </div>\n\n        {/* Search Footer */}\n        <div className=\"px-4 py-2.5 bg-[#FAF9F6] border-t border-[#E5E5E5] flex items-center justify-between text-[11px] text-[#737373]\">\n          <span>Tip: Use \342\206\221 \342\206\223 to navigate \342\200\242 ESC to close</span>\n          <span>Digital Saathi Public Knowledge Base</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      unified_diff {
