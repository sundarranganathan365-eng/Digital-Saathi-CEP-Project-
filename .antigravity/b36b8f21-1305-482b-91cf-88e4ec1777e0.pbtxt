        lines {
          text: "    questionHi: \'\340\244\225\340\245\213\340\244\210 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244\340\244\277 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\225\340\245\207 \340\244\225\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\225\340\244\277 \340\244\265\340\244\271 \340\244\206\340\244\252\340\244\225\340\245\213 \342\202\2715,000 \340\244\255\340\245\207\340\244\234\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\224\340\244\260 \340\244\225\340\244\271\340\244\244\340\244\276 \340\244\271\340\245\210: \"\340\244\252\340\245\210\340\244\270\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\276\340\244\252\340\245\215\340\244\244 \340\244\225\340\244\260\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\205\340\244\252\340\244\250\340\244\276 UPI \340\244\252\340\244\277\340\244\250 \340\244\241\340\244\276\340\244\262\340\245\207\340\244\202\340\245\244\" \340\244\206\340\244\252\340\244\225\340\245\213 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\260\340\244\250\340\244\276 \340\244\232\340\244\276\340\244\271\340\244\277\340\244\217?\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
