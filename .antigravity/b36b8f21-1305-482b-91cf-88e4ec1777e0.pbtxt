        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \'Dial 1930 immediately! The Citizen Financial Cyber Fraud Reporting System operates through 1930 and helps freeze stolen funds within the \"Golden Hour\". You can also file a report at cybercrime.gov.in.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationHi: \'\340\244\221\340\244\250\340\244\262\340\244\276\340\244\207\340\244\250 \340\244\265\340\244\277\340\244\244\340\245\215\340\244\244\340\245\200\340\244\257 \340\244\247\340\245\213\340\244\226\340\244\276\340\244\247\340\244\241\340\244\274\340\245\200 \340\244\271\340\245\213\340\244\250\340\245\207 \340\244\252\340\244\260 \340\244\244\340\245\201\340\244\260\340\244\202\340\244\244 1930 \340\244\241\340\244\276\340\244\257\340\244\262 \340\244\225\340\244\260\340\245\207\340\244\202 \340\244\257\340\244\276 cybercrime.gov.in \340\244\252\340\244\260 \340\244\260\340\244\277\340\244\252\340\245\213\340\244\260\340\245\215\340\244\237 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanationMr: \'\340\244\270\340\244\276\340\244\257\340\244\254\340\244\260 \340\244\253\340\244\270\340\244\265\340\244\243\340\245\202\340\244\225 \340\244\235\340\244\276\340\244\262\340\245\215\340\244\257\340\244\276\340\244\270 \340\244\244\340\244\276\340\244\244\340\244\241\340\245\200\340\244\250\340\245\207 \340\245\247\340\245\257\340\245\251\340\245\246 \340\244\265\340\244\260 \340\244\225\340\245\211\340\244\262 \340\244\225\340\244\260\340\244\276 \340\244\225\340\244\277\340\244\202\340\244\265\340\244\276 cybercrime.gov.in \340\244\265\340\244\260 \340\244\244\340\244\225\340\245\215\340\244\260\340\244\276\340\244\260 \340\244\250\340\245\213\340\244\202\340\244\246\340\244\265\340\244\276.\',"
